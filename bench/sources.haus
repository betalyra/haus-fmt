          sha256: "e6822f7ee6fd71bdde6228537368aafcfb7191109340fe119d9aca27c6e9396d",
        },
      },
      // Stripe names each object's type in a one-value enum `object`.
      rules: { constDiscriminators: True, keyedUnions: True },
    },
    {
      name: "bfcl",
      title: "Berkeley Function Calling Leaderboard (BFCL v4): questions with their function definitions and possible answers",
      category: ToolCalls,
      license: "Apache-2.0",
      repo: "https://github.com/ShishirPatil/gorilla",
      commit: "6ea57973c7a6097fd7c5915698c54c17c5b1b6c8",
      committed: Instant("2026-03-23T11:40:47Z"),
      layout: FunctionCalls {
        // JSON Lines, one entry per line, despite the .json names.
        questions: {
          dir: "berkeley-function-call-leaderboard/bfcl_eval/data",
