          count: 20,
          sha256: "053b5323b03c7b0d0be0abed31fbed71c17c2f29f5776fed9518b179e72dd735",
        },
        answers: {
          dir: "berkeley-function-call-leaderboard/bfcl_eval/data/possible_answer",
