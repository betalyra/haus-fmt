          count: 16,
          sha256: "0711a7d8033c327f70c4309ee693a400d32eb850161ed062a06c0b40da5c4c2a",
        },
        // The single-turn categories, whose entries are function definitions and a call.
        categories: [
          "simple_python", "simple_java", "simple_javascript", "multiple", "parallel", "parallel_multiple",
          "live_simple", "live_multiple", "live_parallel", "live_parallel_multiple",
        ],
        // Hand-written: BFCL's files have no schema of their own.
        schema: "size/schemas/bfcl.schema.haus",
      },
    },
    {
      name: "gh-archive",
      title: "GitHub events (GH Archive, one hour, sampled), with the event schemas of GitHub's OpenAPI description",
      category: Events,
      // GH Archive's code is MIT and its website CC-BY-4.0; neither covers the event archives, which are
      // public GitHub events under GitHub's terms. Downloaded and measured only: never committed or
      // redistributed, and no sample documents are published; only aggregate results.
      license: "none for the data (public GitHub events, GitHub's terms)",
      repo: "https://www.gharchive.org",
      // The hour (UTC) of the archive file.
      commit: "2026-11-02-15",
      committed: Instant("2026-11-02T16:05:03Z"),
      layout: GhArchiveEvents {
        archive: {
          url: "https://data.gharchive.org/2026-11-02-15.json.gz",
          sha256: "41472831de798c243e5f3969a6acb81576071ff7d828169e589b8243c7b759a9",
        },
        // About 2,000 events: each type's share, at least 20 (or all) of each.
        sample: 2000,
        seed: 20261102,
        schema: {
          from: {
            repo: "https://github.com/github/rest-api-description",
            commit: "c9c95fe34ced05fe076001f5c55704742bc8e7f8",
            committed: Instant("2026-11-17T12:33:12Z"),
            license: "MIT",
          },
          description: {
            path: "descriptions-next/api.github.com/api.github.com.2026-03-10.json",
            sha256: "ccee9ddc5f80053a35fcd375ae6a68dc88af1a058644459c394b2d69fc06491a",
          },
        },
      },
      // A new source: the rules github-rest keeps off are on.
      rules: { constDiscriminators: True, keyedUnions: True },
    },
    {
      name: "geojson",
      title: "Natural Earth admin-0 countries (1:110m), one GeoJSON feature per document, with the GeoJSON Feature JSON Schema",
      category: Geo,
      license: "Public domain (Natural Earth); schema MIT",
      repo: "https://github.com/nvkelso/natural-earth-vector",
      commit: "ca96624a56bd078437bca8184e78163e5039ad19",
      committed: Instant("2022-06-02T07:25:00Z"),
