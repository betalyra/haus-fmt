// What the benchmark reads, pinned. The fetch step downloads every file into
// bench/.data/ (git-ignored) and checks its SHA-256; nothing here is committed
// but the manifest itself.
//
// corpus:      sources of JSON documents (plans/benchmarks.md §4.1). Each is
//              fetched with git from github.com (a shallow, blob-less fetch of the
//              commit, then the files' blobs in one request): the archive and raw
//              hosts (codeload.github.com, raw.githubusercontent.com) are not
//              reachable from the sandbox the benchmark was set up in.
// tokenizers:  tokenizer.json + tokenizer_config.json from the Hugging Face Hub,
//              pinned by commit, read by tokenizers.js (§11). Adding a tokenizer is
//              one entry here.
{
  corpus: [
    {
      name: "github-rest",
      title: "GitHub REST API description (OpenAPI 3.1): example responses",
      category: ApiResponses,
      license: "MIT",
      repo: "https://github.com/github/rest-api-description",
      commit: "c9c95fe34ced05fe076001f5c55704742bc8e7f8",
      committed: Instant("2026-11-17T12:33:12Z"),
      layout: OpenApiExamples {
        description: {
          path: "descriptions-next/api.github.com/api.github.com.2026-03-10.json",
          sha256: "ccee9ddc5f80053a35fcd375ae6a68dc88af1a058644459c394b2d69fc06491a",
        },
      },
    },
    {
      name: "vega-lite",
      title: "Vega-Lite example specifications (configuration and specs), with Vega-Lite's JSON Schema",
      category: Config,
      license: "BSD-3-Clause",
      repo: "https://github.com/vega/vega-lite",
      // v6.5.0
      commit: "e415f441845e198629f2049b46849ddcfdbf6596",
      committed: Instant("2026-10-08T14:27:43Z"),
      layout: JsonSchemaDocuments {
        schema: {
          path: "build/vega-lite-schema.json",
          sha256: "86a215814e105262c19c986703d5dd1cb7ef476d6b710d717085071e1d83ebba",
        },
        // The SHA-256 of the listing `<name>\t<SHA-256 of the file>\n`, sorted by name.
        documents: {
          dir: "examples/specs",
          suffixes: [".vl.json"],
          count: 633,
          sha256: "bea5bde6024ba524a3d82536c4d4cd8807d1274039d98dea3c845e0bfc7a567c",
        },
      },
    },
    {
      name: "kubernetes",
      title: "Kubernetes example manifests (YAML), with the OpenAPI v3 description of Kubernetes v1.37.2",
      category: Config,
      license: "Apache-2.0",
      repo: "https://github.com/kubernetes/examples",
      commit: "22934a040acbb0c0aa103023ccbd871507bf17f6",
      committed: Instant("2026-10-27T18:21:20Z"),
      layout: KubernetesManifests {
        // Every YAML file of the repository, in every directory (`_archived/` too).
        documents: {
          dir: ".",
          suffixes: [".yaml", ".yml"],
          recursive: True,
          count: 250,
          sha256: "bfbd6a45bf74356c0effa3969ba186407a9683056e390ecda71e7cece9ba1371",
        },
        schema: {
          from: {
            repo: "https://github.com/kubernetes/kubernetes",
            tag: "v1.37.2",
            commit: "c50e5395f1ae2d4a2c05f28fdcc38c0916cc1a32",
            committed: Instant("2026-10-27T12:01:04Z"),
            license: "Apache-2.0",
          },
          files: {
            dir: "api/openapi-spec/v3",
            suffixes: ["_openapi.json"],
            count: 65,
            sha256: "7341161ba35e4f732fc9b75bd4e0fa81fcfd56314a3ecef6703f9965d6ec7606",
          },
        },
      },
      rules: { constDiscriminators: True, keyedUnions: True },
    },
    {
      name: "stripe",
      title: "Stripe API fixtures (example objects), with Stripe's OpenAPI 3.0 description",
