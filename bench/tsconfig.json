{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [{ "name": "@effect/language-service", "allowedUnstableApis": ["effect/FileSystem", "effect/Path", "effect/Crypto", "effect/process", "effect/http", "effect/cli", "@effect/platform-node", "@effect/platform-bun"] }]
  },
  "include": ["*.ts", "size/src", "speed/ts"]
}
