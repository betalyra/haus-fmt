// The spec-to-test map (spec/scripts/rules.ts): for each rule of the spec, the
// conformance cases that exercise it. Case paths are relative to test-suite/,
// without extension; `packages/cases#NAME` is one case of the package suite.
// `untestable: True` marks a rule no suite case can test (an API, advice, a
// documentation duty), with a note saying why. Rules without a case are listed
// in spec/scripts/rules-uncovered.txt. Schema suite files can also name the rules
// they cover with a `// rule: ID` comment line.

// ── §1 Data model ──
{ rule: "data.value.kinds", cases: ["valid/bare-values", "valid/numbers", "valid/strings", "valid/bytes", "valid/single-record", "valid/variants", "valid/empty-containers"] },
{ rule: "data.bytes.syntax", cases: ["valid/bytes", "invalid/bytes-odd-digits", "invalid/bytes-split-byte", "invalid/bytes-newline", "invalid/bytes-non-hex", "invalid/bytes-space-after-prefix"] },
{ rule: "data.record.no-duplicate-keys", cases: ["invalid/duplicate-key", "invalid/duplicate-quoted-key", "invalid/duplicate-key-escaped"] },
{ rule: "data.syntax.no-null-no-booleans", cases: ["invalid/null", "invalid/lowercase-true", "valid/variants"] },
{ rule: "data.file.sequence", cases: ["valid/empty-file", "valid/only-comments", "valid/single-record", "valid/stream"] },
{ rule: "data.absence.not-a-value", cases: ["schema/records"], note: "a missing optional field and None decode and encode differently" },
{ rule: "data.absence.required-field", cases: ["schema/records"] },
{ rule: "data.absence.optional-field", cases: ["schema/records"] },
{ rule: "data.absence.maybe-required", cases: ["schema/records"] },
{ rule: "data.optional.missing-not-none", cases: ["schema/records", "json/schema-based"] },
{ rule: "data.maybe.always-written", cases: ["schema/builtins", "schema/records"] },
{ rule: "data.optional-maybe.three-states", cases: ["schema/records"] },
{ rule: "data.absence.no-defaults", cases: ["schema/records"], note: "Ok cases compare the encoded result with the input: no field is added" },
{ rule: "data.optional.host-distinct", cases: ["schema/records"], note: "a binding that conflated the two would fail the round trip of `note: None` and of a missing `note`" },

// ── §2 Equality ──
{ rule: "equality.numbers.normalize", cases: ["valid/numbers", "valid/exponents", "valid/negative-zero-hex"] },
{ rule: "equality.numbers.scale-kept", cases: ["valid/numbers"] },
{ rule: "equality.numbers.hex-sign", cases: ["valid/negative-zero-hex"] },
{ rule: "equality.strings.code-points", cases: ["valid/unicode-edges", "schema/builtins"] },
{ rule: "equality.bytes.case-spacing", cases: ["valid/bytes"] },
{ rule: "equality.bytes.other-kinds", cases: ["schema/builtins"], note: "a byte string is not decoded as a String nor an array of numbers" },
{ rule: "equality.arrays.pairwise", cases: ["valid/numbers", "valid/trailing-commas"] },
{ rule: "equality.records.unordered", cases: ["valid/keys", "schema/records"] },
{ rule: "equality.variants.payload-forms", cases: ["valid/variants", "schema/variants"] },

// ── §3 Numbers ──
{ rule: "numbers.precision.exact", cases: ["valid/numbers", "valid/limits-boundary"] },
{ rule: "numbers.scale.kept", cases: ["valid/numbers", "schema/numbers", "json/schema-based"] },
{ rule: "numbers.equality.native", cases: [], untestable: True, note: "advice to implementers; the distinction itself is equality.numbers.scale-kept" },
{ rule: "numbers.schemaless.no-precision-loss", cases: [], untestable: True, note: "native conversion without a schema is a binding API; the suite has no runner mode for it (binding tests)" },
{ rule: "numbers.schemaless.no-size-rejection", cases: [], untestable: True, note: "native conversion API, as numbers.schemaless.no-precision-loss" },
{ rule: "numbers.schemaless.type-from-type", cases: [], untestable: True, note: "native conversion API: the host type must not depend on the data" },
{ rule: "numbers.int.arbitrary", cases: ["schema/numbers"] },
{ rule: "numbers.float.special-tags", cases: ["schema/numbers"] },
{ rule: "numbers.float.too-large", cases: ["schema/numbers", "json/schema-based"] },
{ rule: "numbers.limits.literal", cases: ["valid/limits-boundary", "invalid/number-too-long", "invalid/hex-too-long", "invalid/exponent-too-large"] },

// ── §4 Strings and Unicode ──
{ rule: "strings.utf8.reject-invalid", cases: ["invalid/invalid-utf8", "schema/invalid/invalid-utf8"] },
{ rule: "strings.utf8.bom-ignored", cases: ["valid/bom", "invalid/two-boms", "invalid/bom-after-comma", "format/cases/bom"] },
{ rule: "strings.escapes.set", cases: ["valid/strings", "valid/escaped-controls", "invalid/bad-escape", "invalid/json-unicode-escape", "invalid/empty-unicode-escape"] },
{ rule: "strings.escapes.scalar-value", cases: ["invalid/surrogate-escape", "invalid/too-large-escape", "valid/unicode-edges"] },
{ rule: "strings.block.opening-line", cases: ["invalid/block-content-on-opening-line", "invalid/block-string-control-after-opening", "invalid/block-opening-at-end"] },
{ rule: "strings.block.closing-line", cases: ["invalid/block-closing-not-alone"] },
{ rule: "strings.block.indent-removed", cases: ["valid/block-strings", "valid/tab-in-block-string"] },
{ rule: "strings.block.short-blank-line", cases: ["valid/block-strings", "format/cases/block-strings-trailing-blanks"] },
{ rule: "strings.block.under-indented", cases: ["invalid/block-under-indented"] },
{ rule: "strings.block.join-lf", cases: ["valid/block-strings", "valid/crlf-line-endings"] },
{ rule: "strings.block.final-break-excluded", cases: ["valid/block-strings"] },
{ rule: "strings.block.escapes-after-indent", cases: ["valid/block-strings"] },
{ rule: "strings.block.triple-quote-escaped", cases: ["valid/block-strings"] },
{ rule: "strings.block.trailing-blanks-kept", cases: ["format/cases/block-strings-trailing-blanks"], note: "the format suite checks that the pretty result (which escapes the last blank) parses to the same values as the input" },
{ rule: "strings.control.reject-raw", cases: ["invalid/control-char-in-string", "invalid/control-c1-in-string", "invalid/control-del-in-string", "invalid/control-c1-in-block-string", "invalid/control-esc-in-line-comment", "invalid/control-nul-in-block-comment", "invalid/control-in-quoted-key", "invalid/raw-tab-in-string"] },
{ rule: "strings.control.tab-and-line-breaks", cases: ["valid/comments-tabs-crlf", "valid/tab-in-block-string", "valid/crlf-line-endings"] },
{ rule: "strings.cr.only-before-lf", cases: ["invalid/lone-carriage-return", "invalid/string-raw-cr"] },
{ rule: "strings.error.control-character", cases: ["invalid/control-char-in-string", "invalid/control-c1-in-block-string", "invalid/control-esc-in-line-comment", "invalid/string-raw-cr", "invalid/string-raw-crlf", "invalid/block-string-raw-cr"] },
{ rule: "strings.error.string-line-break", cases: ["invalid/newline-in-string", "schema/invalid/key-line-break"] },
{ rule: "strings.error.lone-carriage-return", cases: ["invalid/lone-carriage-return", "invalid/lone-carriage-return-in-block-comment", "invalid/lone-carriage-return-in-line-comment", "invalid/lone-carriage-return-in-record", "schema/invalid/lone-carriage-return"] },
{ rule: "strings.error.outside-value", cases: ["invalid/control-outside-string", "invalid/bidi-outside-string"] },
{ rule: "strings.error.outside-key", cases: ["invalid/control-where-key"] },
{ rule: "strings.error.outside-after-value", cases: ["invalid/bidi-after-value"] },
{ rule: "strings.bidi.reject", cases: ["invalid/bidi-in-string", "invalid/bidi-isolate-in-string", "invalid/bidi-in-block-string", "invalid/bidi-in-line-comment", "invalid/bidi-in-block-comment", "invalid/bidi-outside-string", "schema/invalid/bidi-in-comment", "schema/invalid/bidi-in-key"] },
{ rule: "strings.bidi.escapes-allowed", cases: ["valid/bidi-escaped"] },
{ rule: "strings.keys.no-normalization", cases: ["valid/unicode-edges", "schema/builtins"] },
{ rule: "strings.keys.producers-normalize", cases: [], untestable: True, note: "advice to producers (applications)" },
{ rule: "strings.nul.allowed", cases: ["valid/unicode-edges", "valid/escaped-controls", "schema/builtins"] },
{ rule: "strings.nul.c-apis", cases: [], untestable: True, note: "advice to consumers that call C APIs" },
{ rule: "strings.identifiers.ascii", cases: ["valid/keys", "valid/variants", "invalid/uppercase-key", "invalid/number-key", "invalid/identifier-value"] },

// ── §5 Variants ──
{ rule: "variants.payload.same-line", cases: ["valid/payload-same-line-spaces", "valid/variants", "invalid/payload-on-next-line", "invalid/payload-on-next-line-paren", "invalid/payload-after-comment"] },
{ rule: "variants.positional.declared-only", cases: ["schema/variants"], note: "Circle(1.5) for a record case and Point { x, y } for a positional case are wrong-payload" },

// ── §6 Streams ──
{ rule: "streams.separators.trailing-comma", cases: ["valid/stream", "valid/single-trailing-comma", "valid/stream-no-trailing-comma", "valid/stream-comments-between", "invalid/double-comma-top-level", "invalid/leading-comma-file", "invalid/missing-comma-top-level"] },
{ rule: "streams.writers.comma-after-every", cases: ["format/cases/stream", "format/cases/stream-no-trailing-comma", "format/cases/comments-stream"] },
{ rule: "streams.truncation.strict-mode", cases: ["stream/limits"] },

// ── §7 Limits ──
{ rule: "limits.enforce.while-parsing", cases: ["invalid/too-deep", "invalid/number-too-long", "invalid/hex-too-long", "invalid/exponent-too-large", "invalid/negative-exponent-too-large"] },
{ rule: "limits.enforce.configurable", cases: ["stream/limits"], note: "only the value limit is configured by a suite case; the others need plan B1 (non-default limits in every runner)" },
{ rule: "limits.enforce.accept-within", cases: ["valid/limits-boundary", "valid/deep-nesting", "valid/limits-separators"] },
{ rule: "limits.depth.default", cases: ["invalid/too-deep", "invalid/too-deep-by-one"], note: "257 levels rejected (too-deep-by-one); a valid file of exactly 256 levels is not a case: its .jsonl needs 257 JSON levels, which the Swift and Rust harnesses can't compare yet" },
{ rule: "limits.number.default", cases: ["valid/limits-boundary", "invalid/number-too-long", "valid/limits-separators", "invalid/number-sign-too-long"] },
{ rule: "limits.hex.default", cases: ["valid/limits-boundary", "invalid/hex-too-long", "valid/limits-separators"] },
{ rule: "limits.exponent.default", cases: ["valid/limits-boundary", "invalid/exponent-too-large", "invalid/negative-exponent-too-large"] },
{ rule: "limits.characters.code-points", cases: ["stream/limits"], note: "an emoji is one character for the stream value limit; the 16 Mi string limit needs generated inputs" },
{ rule: "limits.number.whole-literal", cases: ["valid/limits-separators", "invalid/number-sign-too-long", "invalid/number-separators-too-long", "invalid/number-exponent-too-long", "invalid/hex-separators-too-long"] },
{ rule: "limits.hex.both-limits", cases: ["valid/limits-separators", "invalid/hex-separators-too-long", "invalid/hex-too-long"] },
{ rule: "limits.value.counting", cases: ["stream/limits"] },
{ rule: "limits.depth.counting", cases: ["invalid/too-deep-paren-record"], note: "128 Tag({ … }) around [1] is 257 levels; the accepted side (Tag { … } as one level at 256) needs a 256-deep valid file, see limits.depth.default" },
{ rule: "limits.depth.values-in-code", cases: [], untestable: True, note: "values built in code (writers, checks): binding API" },
{ rule: "limits.depth.binding-maximum", cases: [], untestable: True, note: "MAY: a binding's supported depth (at least 256) is its own documentation duty" },
{ rule: "limits.depth.reject-unsupported", cases: [], untestable: True, note: "setting limits is a binding API; the result (unsupported-depth or acceptance) differs by binding. Fuzzed after plan B1" },
{ rule: "limits.portability.defaults", cases: [], untestable: True, note: "consequence of limits.accept-within for documents beyond the defaults" },
{ rule: "limits.time.linear", cases: [], untestable: True, note: "performance: binding linearity tests and fuzzing, not suite cases" },
{ rule: "limits.duplicate-keys.unpredictable", cases: [], untestable: True, note: "implementation requirement (hash seeding); binding tests" },

// ── §8 Error positions ──
{ rule: "positions.error.code", cases: ["invalid/payload-on-next-line", "invalid/missing-comma-top-level"], note: "every .error file pins the code" },

// ── §9 Security considerations ──
{ rule: "security.tags.data-only", cases: [], untestable: True, note: "implementation property (no dynamic class lookup); review" },
{ rule: "security.parsing.no-io", cases: [], untestable: True, note: "implementation property: parsing touches no network or file system" },
{ rule: "security.packages.own-files-only", cases: ["packages/cases#schema-links-out", "packages/cases#manifest-links-out", "packages/cases#package-json-links-out", "packages/cases#package-imports-a-file"] },
{ rule: "security.errors.refused-content-hidden", cases: ["packages/cases#schema-links-out", "packages/cases#manifest-links-out", "packages/cases#schema-links-through-inner-directory", "packages/cases#app-file-links-to-another-file", "packages/cases#package-json-links-out"] },
{ rule: "security.errors.quoted-text-escaped", cases: ["packages/cases#manifest-name-escaped"], note: "hides: the raw ESC, and a run of 40 letters of the name; the exact 40-character cut is not compared" },
{ rule: "security.errors.version-quoted-if-valid", cases: ["packages/cases#package-json-version-not-a-version"] },
{ rule: "security.packages.declared-places", cases: ["packages/cases#no-project-no-npm-lookup", "packages/cases#explicit-mode-does-not-read-node-modules", "packages/cases#scope-directory-node-modules"] },
{ rule: "security.limits.while-parsing", cases: ["invalid/too-deep", "invalid/number-too-long", "invalid/exponent-too-large"] },
{ rule: "security.keys.data-only", cases: ["schema/builtins"], note: "Map with keys __proto__ and constructor decodes and encodes back unchanged" },
{ rule: "security.unknown.untrusted", cases: [], untestable: True, note: "storing or forwarding raw unknown values with limits lower than those it was read with: no suite format" },
{ rule: "security.errors.fail-first", cases: ["invalid/unclosed-array", "invalid/missing-comma-array", "invalid/double-comma", "invalid/null", "invalid/trailing-dot"] },
{ rule: "security.signatures.bytes-or-canonical", cases: [], untestable: True, note: "advice on signing" },
{ rule: "security.decode.tag-lookup", cases: [], untestable: True, note: "the schema language has no unions; applies to combinator libraries (binding tests)" },
{ rule: "security.decode.depth-limit", cases: [], untestable: True, note: "parsed input can't exceed the parser's depth; only values built in code can (binding tests)" },
{ rule: "security.decode.work-budget", cases: [], untestable: True, note: "work budget (step-budget): binding tests" },
{ rule: "security.encode.cycles-and-work", cases: [], untestable: True, note: "values built in code (cyclic-value, too-many-nodes): binding tests" },
{ rule: "security.encode.unknown-limits", cases: [], untestable: True, note: "needs lower limits on encode than on decode: no suite format" },
{ rule: "security.errors.constant-time", cases: [], untestable: True, note: "message construction cost: binding tests" },
{ rule: "security.recursion.explicit", cases: [], untestable: True, note: "applies to combinator libraries (e.g. h.Recursive); schema files name recursion by reference" },
{ rule: "security.recursion.guarded", cases: ["schema/invalid/unguarded-recursion", "schema/invalid/unguarded-unused-generic", "schema/invalid/secret-recursion"] },
{ rule: "security.recursion.depth-only", cases: ["schema/types"], note: "a recursive value 100 levels deep decodes" },
{ rule: "security.recursion.smaller-limit", cases: [], untestable: True, note: "MAY: application setting" },
{ rule: "security.schemas.expansive-cycle", cases: ["schema/invalid/growing-array", "schema/invalid/growing-mutual-recursion", "schema/invalid/growing-self-recursion", "schema/invalid/growing-swap", "schema/invalid/growing-three-cycle", "schema/types"] },
{ rule: "security.hash.hides-nothing", cases: [], untestable: True, note: "advice on publishing hashes" },

// ── §10 Evolution and versions ──
{ rule: "versions.minor.additions", cases: [], untestable: True, note: "policy for the specification" },
{ rule: "versions.patch.wording", cases: [], untestable: True, note: "policy for the specification" },
{ rule: "versions.growth.no-breaking", cases: [], untestable: True, note: "policy for the specification; the suite of a version keeps passing" },
{ rule: "versions.growth.new-syntax-error", cases: [], untestable: True, note: "policy for future syntax" },
{ rule: "versions.growth.prelude-fixed", cases: [], untestable: True, note: "policy; redefinition itself is schema.reject.redefine-prelude" },
{ rule: "versions.directive.reserved", cases: ["invalid/hash-not-version", "invalid/version-directive-prefix"] },
{ rule: "versions.directive.report", cases: ["invalid/version-directive-prefix", "schema/invalid/attribute-version-directive", "invalid/version-directive-bom", "invalid/version-directive-space", "invalid/version-directive-no-space"] },
{ rule: "versions.directive.only-at-start", cases: ["invalid/version-directive-after-comma", "schema/invalid/attribute-version-directive"] },
{ rule: "versions.conformance.statement", cases: [], untestable: True, note: "documentation duty" },

// ── §11 Standard format ──
{ rule: "format.layouts.exact", cases: ["format/cases/already-formatted", "format/cases/containers", "format/cases/spellings", "format/examples/order"] },
{ rule: "format.options.defaults", cases: ["format/cases/width", "format/cases/containers"] },
{ rule: "format.options.width-positional-only", cases: ["format/cases/width-options", "format/cases/containers"] },
{ rule: "format.options.unset-separate", cases: [], untestable: True, note: "API shape (an absent option)" },
{ rule: "format.options.compact-minimised-none", cases: ["format/cases/width-options"] },
{ rule: "format.pretty.keeps-comments", cases: ["format/cases/comments-line", "format/cases/comments-block", "format/cases/comments-containers"] },
{ rule: "format.compact.drops-comments", cases: ["format/cases/comments-line", "format/cases/comments-stream", "format/cases/minimised-spellings"] },
{ rule: "format.layouts.order-and-spelling-kept", cases: ["format/cases/spellings", "format/cases/minimised-spellings", "format/cases/keys"] },
{ rule: "format.layouts.same-values", cases: ["format/cases/spellings", "format/cases/minimised-spellings", "format/cases/block-strings"], note: "the format suite parses every result and compares its values with the input's" },
{ rule: "format.strings.escaped-alike", cases: ["format/cases/line-separators", "format/cases/block-strings", "format/valid/line-separators", "format/valid/escaped-controls", "format/valid/bidi-escaped"] },
{ rule: "format.pretty.one-entry-per-line", cases: ["format/cases/containers", "format/cases/already-formatted", "format/examples/person"] },
{ rule: "format.pretty.positional-inline", cases: ["format/cases/width", "format/cases/variants", "format/cases/width-options"] },
{ rule: "format.pretty.width.code-points", cases: ["format/cases/width-code-points"] },
{ rule: "format.pretty.width.whole-line", cases: ["format/cases/width", "format/cases/width-single", "format/cases/width-stream"] },
{ rule: "format.pretty.container-payload-never-fits", cases: ["format/cases/variants"] },
{ rule: "format.pretty.spacing", cases: ["format/cases/containers", "format/cases/variants"] },
{ rule: "format.keys.minimal", cases: ["format/cases/keys", "format/valid/keys", "format/valid/unicode-edges"] },
{ rule: "format.bytes.source-spelling", cases: ["format/cases/spellings", "format/cases/minimised-spellings"] },
{ rule: "format.pretty.block-strings", cases: ["format/cases/block-strings", "format/cases/top-level-block-string", "format/valid/block-strings"] },
{ rule: "format.strings.minimal-escapes", cases: ["format/cases/block-strings", "format/cases/keys"] },
{ rule: "format.pretty.block-escapes", cases: ["format/cases/block-strings", "format/cases/block-strings-trailing-blanks"] },
{ rule: "format.pretty.block-trailing-blank", cases: ["format/cases/block-strings-trailing-blanks", "format/valid/strings"] },
{ rule: "format.numbers.source-spelling", cases: ["format/cases/spellings", "format/cases/minimised-spellings"] },
{ rule: "format.strings.source-spelling", cases: ["format/cases/spellings", "format/cases/minimised-spellings"] },
{ rule: "format.strings.form-change", cases: ["format/cases/block-strings", "format/cases/top-level-block-string", "format/cases/ndjson-like"] },
{ rule: "format.numbers.too-long-unwritable", cases: [], untestable: True, note: "only values built in code, or a reader with a lower configured limit, exceed the limit (binding tests; plan B1)" },
{ rule: "format.pretty.stream.commas", cases: ["format/cases/stream", "format/cases/single-with-comma", "format/cases/stream-no-trailing-comma", "format/cases/width-single"] },
{ rule: "format.pretty.stream.blank-after-multiline", cases: ["format/cases/already-formatted", "format/cases/comments-stream"] },
{ rule: "format.pretty.stream.multiline-by-value", cases: ["format/cases/stream-multiline-comment"] },
{ rule: "format.pretty.stream.trailing-comments", cases: ["format/cases/comments-stream", "format/cases/comments-line", "format/cases/minimised-spellings"] },
{ rule: "format.comments.own-line", cases: ["format/cases/comments-line", "format/cases/comments-block"] },
{ rule: "format.comments.after-entry", cases: ["format/cases/comments-line", "format/cases/comments-block"] },
{ rule: "format.comments.after-multiline-comment", cases: ["format/cases/comments-after-multiline"] },
{ rule: "format.comments.before-closer", cases: ["format/cases/comments-containers", "format/cases/comments-line"] },
{ rule: "format.comments.after-opener", cases: ["format/cases/comments-containers", "format/cases/comments-line"] },
{ rule: "format.comments.key-colon", cases: ["format/cases/comments-block", "format/valid/comments", "format/cases/comments-moved-blank-line"] },
{ rule: "format.comments.moved-blank-line", cases: ["format/cases/comments-moved-blank-line"] },
{ rule: "format.comments.paren-record", cases: ["format/cases/comments-payload-parens"] },
{ rule: "format.comments.width-excluded", cases: ["format/cases/width-comment-excluded"] },
{ rule: "format.comments.payload-never-fits", cases: ["format/cases/comments-containers", "format/cases/comments-payload-parens", "format/cases/block-strings"] },
{ rule: "format.pretty.blank-lines", cases: ["format/cases/blank-lines", "format/cases/crlf", "format/cases/comments-line"] },
{ rule: "format.pretty.line-endings", cases: ["format/cases/crlf", "format/cases/crlf-comments", "format/valid/comments-tabs-crlf", "format/valid/crlf-line-endings"] },
{ rule: "format.compact.single-line", cases: ["format/cases/containers", "format/cases/stream", "format/cases/ndjson-like"] },
{ rule: "format.compact.no-multiline-strings", cases: ["format/cases/ndjson-like", "format/cases/block-strings", "format/cases/line-separators"] },
{ rule: "format.empty.file", cases: ["format/cases/empty", "format/cases/whitespace-only", "format/cases/comments-only"] },
{ rule: "schema.types.max-nesting", cases: ["schema/invalid/parens-too-deep"] },
{ rule: "format.compact.stream-commas", cases: ["format/cases/stream", "format/cases/stream-no-trailing-comma", "format/cases/single-with-comma"] },
{ rule: "format.compact.comments-dropped", cases: ["format/cases/comments-stream", "format/cases/minimised-spellings"] },
{ rule: "format.compact.spellings-kept", cases: ["format/cases/spellings", "format/cases/minimised-spellings"] },
{ rule: "format.compact.encoder-default", cases: [], untestable: True, note: "API default of stream encoders" },
{ rule: "format.minimised.no-whitespace", cases: ["format/cases/minimised-spellings", "format/cases/containers", "format/cases/stream"] },
{ rule: "format.minimised.literals-as-written", cases: ["format/cases/minimised-spellings", "format/cases/spellings"] },
{ rule: "format.minimised.comments-dropped", cases: ["format/cases/minimised-spellings", "format/cases/comments-stream"] },
{ rule: "format.minimised.pretty-round-trip", cases: ["format/cases/minimised-spellings", "format/cases/comments-line", "format/cases/already-formatted"], note: "the format suite formats every minimised result as pretty and compares" },
{ rule: "format.minimised.encoder-may", cases: [], untestable: True, note: "MAY: encoder API" },
{ rule: "format.comments.refuse-pretty", cases: [], untestable: True, note: "tool behaviour (CLI, editors): CLI tests" },
{ rule: "format.comments.refuse-in-place", cases: [], untestable: True, note: "tool behaviour (in-place rewrite): CLI tests" },

// ── §12 Canonical form, equality and hashing ──
{ rule: "canonical.form.equal-iff-identical", cases: ["valid/variants", "valid/keys", "valid/numbers"] },
{ rule: "canonical.api.provided", cases: [], untestable: True, note: "SHOULD/MAY: which functions a binding provides" },
{ rule: "canonical.api.exact", cases: ["valid/numbers", "valid/strings", "valid/keys", "valid/stream"] },
{ rule: "canonical.form.text", cases: ["valid/bom", "valid/comments", "valid/single-record"] },
{ rule: "canonical.form.number", cases: ["valid/numbers", "valid/exponents", "valid/negative-zero-hex", "valid/limits-boundary"] },
{ rule: "canonical.form.string", cases: ["valid/escaped-controls", "valid/strings", "valid/bidi-escaped", "valid/line-separators", "valid/unicode-edges"] },
