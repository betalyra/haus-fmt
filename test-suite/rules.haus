// ── spec/grammar.ebnf ──
{ rule: "grammar.structure.file", cases: ["valid/empty-file", "valid/stream", "valid/single-trailing-comma", "invalid/leading-comma-file", "invalid/double-comma-top-level", "invalid/top-comma-closer"] },
{ rule: "grammar.structure.containers", cases: ["valid/single-record", "valid/trailing-commas", "valid/empty-containers", "valid/keys", "invalid/array-colon", "invalid/missing-colon", "invalid/lone-comma-record", "invalid/double-comma", "invalid/unclosed-record", "invalid/unclosed-array", "invalid/mismatched", "invalid/key-without-value"] },
{ rule: "grammar.structure.variant", cases: ["valid/variants", "valid/payload-same-line-spaces", "invalid/empty-payload", "invalid/payload-twice", "invalid/payload-on-next-line", "invalid/unclosed-payload"] },
{ rule: "grammar.lexical.ident-tag", cases: ["valid/keys", "valid/variants", "invalid/uppercase-key", "invalid/identifier-value", "invalid/number-key"] },
{ rule: "grammar.lexical.number", cases: ["valid/numbers", "valid/exponents", "valid/negative-zero-hex", "invalid/leading-zero", "invalid/trailing-dot", "invalid/leading-dot", "invalid/number-then-ident", "invalid/double-separator", "invalid/trailing-separator", "invalid/separator-after-dot", "invalid/empty-exponent", "invalid/empty-hex", "invalid/bad-hex", "invalid/plus-sign", "invalid/lone-minus", "invalid/uppercase-hex-prefix"] },
{ rule: "grammar.lexical.bytes", cases: ["valid/bytes", "invalid/bytes-odd-digits", "invalid/bytes-split-byte", "invalid/bytes-non-hex", "invalid/bytes-escape", "invalid/bytes-newline", "invalid/bytes-space-after-prefix", "invalid/bytes-unterminated"] },
{ rule: "grammar.lexical.string", cases: ["valid/strings", "valid/escaped-controls", "invalid/bad-escape", "invalid/unterminated-string", "invalid/surrogate-escape", "invalid/too-large-escape", "invalid/empty-unicode-escape"] },
{ rule: "grammar.lexical.block-string", cases: ["valid/block-strings", "valid/tab-in-block-string", "invalid/block-content-on-opening-line", "invalid/block-closing-not-alone", "invalid/block-under-indented", "invalid/block-unterminated", "invalid/block-string-key"] },
{ rule: "grammar.lexical.newline", cases: ["valid/crlf-line-endings", "valid/comments-tabs-crlf", "invalid/lone-carriage-return"] },
{ rule: "grammar.lexical.comments", cases: ["valid/comments", "valid/only-comments", "valid/stream-comments-between", "invalid/unterminated-comment", "invalid/unbalanced-nested-comment", "invalid/single-slash", "invalid/trailing-slash"] },
{ rule: "grammar.schema.imports", cases: ["schema/builtins", "schema/invalid/import-space", "schema/invalid/import-no-names", "schema/invalid/import-package-uppercase", "schema/invalid/import-leading-zero"] },
{ rule: "grammar.schema.typedefs", cases: ["schema/attributes", "schema/invalid/attribute-space", "schema/invalid/attribute-unclosed", "schema/invalid/param-underscore"] },
{ rule: "grammar.schema.types", cases: ["schema/types", "schema/variants", "schema/records", "schema/invalid/variant-trailing-bar", "schema/invalid/record-lone-comma", "schema/invalid/record-comment-comma", "schema/invalid/stray-quote-in-key"] },
