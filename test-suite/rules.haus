{ rule: "packages.versions.unlisted-reserved", cases: [], untestable: True, note: "SHOULD NOT: advice to writers" },
{ rule: "packages.imports.major-only", cases: ["schema/invalid/import-leading-zero", "schema/invalid/import-minor", "schema/invalid/import-full-version", "schema/invalid/import-empty-version", "schema/invalid/import-not-a-version"] },
