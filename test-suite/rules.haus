// ── §17 Error codes ──
{ rule: "errors.code.syntax", cases: [], untestable: True, note: "checked on the catalogue by spec/scripts/errors.ts" },
{ rule: "errors.code.stable", cases: [], untestable: True, note: "policy" },
{ rule: "errors.code.catalogue-only", cases: ["invalid/payload-on-next-line", "invalid/duplicate-key", "schema/invalid/unguarded-recursion", "json/schema-based", "packages/cases", "stream/limits"] },
{ rule: "errors.code.one-mistake", cases: ["invalid/missing-comma-top-level", "invalid/payload-on-next-line", "invalid/payload-after-comment"] },
{ rule: "errors.code.same-everywhere", cases: ["invalid/payload-on-next-line", "schema/invalid/growing-swap", "schema/numbers"] },
{ rule: "errors.json.object", cases: [], untestable: True, note: "SHOULD: error API of libraries and command-line tools" },
{ rule: "errors.json.secret", cases: ["schema/builtins"], note: "the code invalid-secret is checked; messages and members are not" },
{ rule: "errors.docs.every-code", cases: [], untestable: True, note: "documentation duty (docs/errors.md is generated)" },

