{ rule: "canonical.form.array", cases: ["valid/numbers", "valid/trailing-commas"] },
{ rule: "canonical.record.sorted", cases: ["valid/keys", "valid/unicode-edges", "valid/key-order-code-points"] },
{ rule: "canonical.record.bare-keys", cases: ["valid/keys"] },
{ rule: "canonical.form.variant", cases: ["valid/variants", "valid/empty-containers"] },
{ rule: "canonical.hash.sha256", cases: ["valid/single-record", "valid/bare-values"] },
{ rule: "canonical.hash-all.joined", cases: ["valid/stream", "valid/stream-no-trailing-comma", "valid/stream-comments-between"] },
{ rule: "canonical.hash-all.single", cases: ["valid/single-trailing-comma", "valid/single-record"] },
{ rule: "canonical.hash-all.empty", cases: ["valid/empty-file", "valid/only-comments"] },
{ rule: "canonical.hash-all.order", cases: ["valid/stream"] },
{ rule: "canonical.hash-all.provided", cases: [], untestable: True, note: "SHOULD: which functions a binding provides" },
{ rule: "canonical.hash.values-not-text", cases: ["valid/variants", "valid/comments", "valid/keys", "valid/numbers"] },
{ rule: "canonical.hash.stable", cases: ["valid/single-record", "valid/stream"], note: "the .hash files pin the digests" },

// ── §13, §13.1, §13.2 Prelude and standard modules ──
{ rule: "prelude.prelude.supported", cases: ["schema/numbers", "schema/builtins", "schema/records", "schema/variants"] },
{ rule: "prelude.std.supported", cases: ["schema/builtins", "schema/time"] },
{ rule: "prelude.packages.codecs-optional", cases: [], untestable: True, note: "MAY: codecs for extensions and community packages" },
{ rule: "prelude.scope.import", cases: ["schema/builtins"], note: "the prelude needs no import; std/time is imported" },
{ rule: "prelude.binding.checks-rules", cases: ["schema/numbers", "schema/builtins", "schema/time"] },
{ rule: "prelude.parser.no-value-rules", cases: ["valid/value-rules-not-parsed"] },
{ rule: "prelude.binding.host-types", cases: [], untestable: True, note: "MAY: host type choice; validity unchanged" },
{ rule: "prelude.rules.equality-unchanged", cases: ["schema/builtins"], note: "Instant(\"…10:00:00.250+01:00\") encodes back with its fraction and offset as written" },
{ rule: "prelude.std.versioned-with-spec", cases: [], untestable: True, note: "policy" },
{ rule: "prelude.std.time-profile", cases: ["schema/builtins", "schema/time"] },
{ rule: "prelude.std.import-no-version", cases: ["schema/invalid/import-std-version"], note: "the grammar allows no @ after std/NAME: schema-syntax in every binding" },
{ rule: "prelude.std.money-moved", cases: ["schema/invalid/import-std-money"], note: "only the code (unknown-module); the SHOULD about naming @haus-fmt/money in the message is not compared" },

