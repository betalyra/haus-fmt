// Checkers (spec §14, §15, §16): what tools that check schema files and data
// point out without failing. Two kinds of case:
//
// - `Schema { schema, warnings }`: load the schema text (a schema file of
//   its own, no imports). It loads, and its warnings are exactly `warnings`,
//   as a multiset: `Warning(code, line, column)`, where the
//   line and column (spec §8) are those of what the warning is about.
// - `Data { schema, type, data, issues }`: check the data text against the
//   schema's type `type` (a `Stream` type checks every value, item by item).
//   The issues are exactly `issues`, compared as a multiset (no order, each as
//   often as listed): `Hint(code, path)` and `Error(code, path)`, with the
//   path of spec §15, and `Syntax(code, line, column)` for a syntax or limit
//   error of the text, at its line and column (spec §8). `first: True`
//   checks in the mode that stops at the first error (`haus check --first`).

// ── unknown attributes: accepted, with a warning ──
Schema { schema: "@since(\"1.2\")\ntype A = Int", warnings: [Warning("unknown-attribute", 1, 1)] },
Schema { schema: "type A = { @since(\"1.2\") x: Int, y: Int }", warnings: [Warning("unknown-attribute", 1, 12)] },
Schema { schema: "type A = < @since(\"1.2\") X | Y >", warnings: [Warning("unknown-attribute", 1, 12)] },
Schema { schema: "@deprecated @since(\"2\")\ntype A = Int", warnings: [Warning("unknown-attribute", 1, 13)] },

// ── a schema's use of a deprecated type: once where it is written ──
Schema { schema: "type A = { @deprecated x?: Int }", warnings: [] },
Schema { schema: "@deprecated\ntype Old = Int\ntype A = { x: Old }", warnings: [Warning("deprecated", 3, 15)] },
Schema { schema: "@deprecated\ntype Old = Int\ntype A = { x: Old, y: Old }", warnings: [Warning("deprecated", 3, 15), Warning("deprecated", 3, 23)] },
Schema { schema: "@deprecated\ntype Old = Int\ntype B = Old", warnings: [Warning("deprecated", 3, 10)] },
Schema { schema: "@deprecated(\"use New\")\ntype Old = { x: Int }\ntype A = { ...Old, y: Int }", warnings: [Warning("deprecated", 3, 15)] },
Schema { schema: "@deprecated\ntype Old = < A | B >\ntype V = < ...Old | C >", warnings: [Warning("deprecated", 3, 15)] },

// ── a case without a schema-based JSON form: a warning, the schema is valid ──
Schema { schema: "type Odd = < Box { _tag: Int32 } | Fine >", warnings: [Warning("no-json-form", 1, 14)] },
Schema { schema: "type Odd = < Box { _args: Int32 } >", warnings: [Warning("no-json-form", 1, 14)] },
Schema { schema: "type R = { _tag: Int32 }", warnings: [] },

// ── open types: what they don't list is a hint; closed types: an error ──
Data { schema: "type Root = { name: String }", type: "Root", data: "{ name: \"a\", nmae: \"b\" }", issues: [Hint("unlisted-field", "$.nmae")] },
Data { schema: "type Root = { name: String }", type: "Root", data: "{ name: \"\u{1F600}\", nmae: \"b\" }", issues: [Hint("unlisted-field", "$.nmae")] },
Data { schema: "type Root = { \"pt-BR\"?: Int }", type: "Root", data: "{ \"pt-PT\": 1 }", issues: [Hint("unlisted-field", "$[\"pt-PT\"]")] },
Data { schema: "type Root = { items: Array Item }\ntype Item = { id: Int }", type: "Root", data: "{ items: [{ id: 1 }, { id: 2, idd: 3 }] }", issues: [Hint("unlisted-field", "$.items[1].idd")] },
Data { schema: "type Root = < Red | Green >", type: "Root", data: "Gren", issues: [Hint("unlisted-tag", "$")] },
Data { schema: "type Root = { v: < A | B > }", type: "Root", data: "{ v: C(1) }", issues: [Hint("unlisted-tag", "$.v")] },
Data { schema: "type Root = Stream Item\ntype Item = { id: Int }", type: "Root", data: "{ id: 1 },\n{ id: 2, ix: 3 },", issues: [Hint("unlisted-field", "$[1].ix")] },
Data { schema: "type Root = closed { a: Int }", type: "Root", data: "{ a: 1, b: 2 }", issues: [Error("unknown-field", "$.b")] },
Data { schema: "type Root = closed < Red | Green >", type: "Root", data: "Gren", issues: [Error("unknown-tag", "$")] },
Data { schema: "type Root = { m: Map Int }", type: "Root", data: "{ m: { \"x y\": 1 } }", issues: [] },

// ── deprecated fields and tags the data uses: a hint at the field's value or the tagged value ──
Data { schema: "type Root = { @deprecated(\"use email\") mail?: String, email?: String }", type: "Root", data: "{ mail: \"a@b.c\" }", issues: [Hint("deprecated", "$.mail")] },
Data { schema: "type Root = { @deprecated(\"use email\") mail?: String, email?: String }", type: "Root", data: "{ email: \"a@b.c\" }", issues: [] },
Data { schema: "type Root = { lines: Array Line }\ntype Line = { @deprecated count?: Int }", type: "Root", data: "{ lines: [{ count: 2 }] }", issues: [Hint("deprecated", "$.lines[0].count")] },
Data { schema: "type Root = < @deprecated Old | New >", type: "Root", data: "Old", issues: [Hint("deprecated", "$")] },
Data { schema: "type Root = < Some Int | @deprecated Gone { a: Int } >", type: "Root", data: "Gone { a: 1 }", issues: [Hint("deprecated", "$")] },

// ── a field or tag copied by a spread keeps its attributes ──
Data { schema: "type Base = { @deprecated x?: Int }\ntype Root = { ...Base, y: Int }", type: "Root", data: "{ x: 1, y: 2 }", issues: [Hint("deprecated", "$.x")] },
Data { schema: "type Base = < @deprecated Old | New >\ntype Root = < ...Base | Other >", type: "Root", data: "Old", issues: [Hint("deprecated", "$")] },

// ── attributes this version doesn't define: accepted twice, a warning each ──
Schema { schema: "type A = { @since @since x: Int }", warnings: [Warning("unknown-attribute", 1, 12), Warning("unknown-attribute", 1, 19)] },

// ── a blank between a field's key and its `?` (grammar.ebnf) ──
Schema { schema: "type A = { x ?: Int, y? : Int }", warnings: [] },

// ── a case copied by a spread is warned about once, where it is defined ──
Schema { schema: "type Odd = < Box { _tag: Int32 } | Fine >\ntype V = < ...Odd | X >", warnings: [Warning("no-json-form", 1, 14)] },

// ── every error (spec §14, "Every error"): each failing place once, nothing below a value that failed ──
Data { schema: "type Root = { a: Int, b: String, c: Bool }", type: "Root", data: "{ a: \"x\", b: 1, c: True }", issues: [Error("type-mismatch", "$.a"), Error("type-mismatch", "$.b")] },
Data { schema: "type Root = closed { a: Int, b: Int }", type: "Root", data: "{ a: \"x\", z: 1 }", issues: [Error("missing-field", "$"), Error("type-mismatch", "$.a"), Error("unknown-field", "$.z")] },
Data { schema: "type Root = { items: Array { id: Int } }", type: "Root", data: "{ items: { id: \"x\" } }", issues: [Error("type-mismatch", "$.items")] },
Data { schema: "type Root = Array Int8", type: "Root", data: "[1, 300, \"x\", -200]", issues: [Error("out-of-range", "$[1]"), Error("type-mismatch", "$[2]"), Error("out-of-range", "$[3]")] },
Data { schema: "type Root = Map Int", type: "Root", data: "{ a: \"x\", b: 2, c: \"y\" }", issues: [Error("type-mismatch", "$.a"), Error("type-mismatch", "$.c")] },
Data { schema: "type Root = closed < A { x: Int } >", type: "Root", data: "B { x: \"y\" }", issues: [Error("unknown-tag", "$")] },
Data { schema: "type Root = Array (closed < P { x: Int } | Q >)", type: "Root", data: "[P { x: \"a\" }, P { x: 1 }, Q(1), P { x: \"b\" }]", issues: [Error("type-mismatch", "$[0].x"), Error("wrong-payload", "$[2]"), Error("type-mismatch", "$[3].x")] },
Data { schema: "type Root = { k: Secret { a: Int, b: Int }, n: Int }", type: "Root", data: "{ k: { a: \"x\", b: \"y\" }, n: \"z\" }", issues: [Error("invalid-secret", "$.k"), Error("type-mismatch", "$.n")] },
Data { schema: "type Root = { name: String, n: Int }", type: "Root", data: "{ nmae: \"a\", n: \"x\" }", issues: [Error("missing-field", "$"), Hint("unlisted-field", "$.nmae"), Error("type-mismatch", "$.n")] },

// ── nothing is pointed out inside a Secret (spec §14, §15): no hints, and an error at the secret ──
Data { schema: "type Root = { key: Secret { a: Int } }", type: "Root", data: "{ key: { a: 1, b: 2 } }", issues: [] },
Data { schema: "type Root = { key: Secret (Array { a: Int }) }", type: "Root", data: "{ key: [{ a: 1, zz: 2 }] }", issues: [] },
Data { schema: "type Root = { key: Secret < A | B > }", type: "Root", data: "{ key: C }", issues: [] },
Data { schema: "type Root = { key: Secret { @deprecated a?: Int } }", type: "Root", data: "{ key: { a: 1 } }", issues: [] },
Data { schema: "type Root = Secret < @deprecated Old | New >", type: "Root", data: "Old", issues: [] },
Data { schema: "type Root = { @deprecated key?: Secret Int }", type: "Root", data: "{ key: 1 }", issues: [Hint("deprecated", "$.key")] },
Data { schema: "type Root = { key: Secret closed { a: Int } }", type: "Root", data: "{ key: { a: 1, b: 2 } }", issues: [Error("invalid-secret", "$.key")] },

// ── every error (spec §14, "Every error"), round 3 ──
// Each error once, also two at one place: a record missing two fields.
Data { schema: "type Root = { a: Int, b: Int }", type: "Root", data: "{}", issues: [Error("missing-field", "$"), Error("missing-field", "$")] },
// A positional payload checks every argument.
Data { schema: "type Root = closed < P Int String >", type: "Root", data: "P(\"1\", 2)", issues: [Error("type-mismatch", "$[0]"), Error("type-mismatch", "$[1]")] },
// A stream is checked item by item: an item's error, then the syntax error that ends the stream.
Data { schema: "type Root = Stream String", type: "Root", data: "1,\n\"ok\",\n\"ok\" \"oops\"", issues: [Error("type-mismatch", "$[0]"), Syntax("missing-comma", 3, 6)] },
Data { schema: "type Root = Stream String", type: "Root", data: "1,\n\"ok\",\n\"ok\" \"oops\"", first: True, issues: [Error("type-mismatch", "$[0]")] },
// Stopping at the first error: the hints found before it, and the error.
Data { schema: "type Root = Stream { id: Int }", type: "Root", data: "{ id: 1, x: 2 },\n{ id: \"y\" },\n{ id: \"z\" }", first: True, issues: [Hint("unlisted-field", "$[0].x"), Error("type-mismatch", "$[1].id")] },
// The cap counts errors only, and is at least 100: 99 errors and 102 hints are all reported.
Data {
  schema: "type Root = Array { id: Int }",
  type: "Root",
  data: "[{ id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: \"x\", a: 1 }, { id: 1, a: 1, b: 1, c: 1 }]",
  issues: [
  Error("type-mismatch", "$[0].id"), Hint("unlisted-field", "$[0].a"),
  Error("type-mismatch", "$[1].id"), Hint("unlisted-field", "$[1].a"),
  Error("type-mismatch", "$[2].id"), Hint("unlisted-field", "$[2].a"),
  Error("type-mismatch", "$[3].id"), Hint("unlisted-field", "$[3].a"),
