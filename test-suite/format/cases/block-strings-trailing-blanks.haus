{
  // A space at the end of a line, two spaces (only the last one is escaped),
  // a line of only spaces, a tab at the end, a line of only a tab, and both.
  note: """
    Delivery to the back door 
    Two spaces  
       
    Tab at the end	
    	
    Space then tab 	
    Tab then space	 
    Ring twice
    """,
  // Escaped in the source already.
  escaped: """
    Ends in a space\u{20}
    Ends in a tab\t
    """,
  // Blanks after the indent of a blank line are content; a blank line
  // shorter than the indent is empty.
  blank: """
    first
      
  
    last
    """,
  list: [
    """
      In an array 
      and a second line
      """,
    "single line \t",
  ],
  shape: Circle { label: """
    a 
    b
    """ },
}
