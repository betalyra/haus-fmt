/* file header */
{
  /* before a */
  a: 1,
  b: 2, /* after the value, before the comma */
  c: [
    1, /* inside */
    2,
  ],
  /* between colon and value */
  d: 3,
  /* between key and colon */
  e: 4,
  /* nested /* comments */ stay whole */
  f: 5,
  /*
   * A block comment over
   * several lines keeps its text.
   */
  g: 6,
  h: 7, /* one */ /* two */
} /* after the file's value */
