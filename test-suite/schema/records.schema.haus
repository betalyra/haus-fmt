// Records (spec §15): required and optional fields, open and closed.
type User = { id: Int, name: String, nick?: String, note?: Maybe String }
type Strict = closed { id: Int, tags?: Array String }
type Outer = closed { user: User }
type Empty = {}
// A Maybe field is required: written as None or Some(…), never left out (spec §1).
type Profile = { nickname: Maybe String }
// Quoted field keys take the escapes of data strings (spec §14, §4).
type Quoted = closed { "content-type": String, "tab\there": Int, "line\nbreak": Int, "smile\u{1F600}": Bool, "q\"\\": Int }
