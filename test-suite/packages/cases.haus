    Package("vendor/l13b", "@acme/l13b", "1.0.0", "import @acme/l14a@1 (T14a)\nimport @acme/l14b@1 (T14b)\ntype T13b = { a: Maybe T14a, b: Maybe T14b }"),
    Package("vendor/l14a", "@acme/l14a", "1.0.0", "import @acme/l15a@1 (T15a)\nimport @acme/l15b@1 (T15b)\ntype T14a = { a: Maybe T15a, b: Maybe T15b }"),
    Package("vendor/l14b", "@acme/l14b", "1.0.0", "import @acme/l15a@1 (T15a)\nimport @acme/l15b@1 (T15b)\ntype T14b = { a: Maybe T15a, b: Maybe T15b }"),
    Package("vendor/l15a", "@acme/l15a", "1.0.0", "import @acme/l16a@1 (T16a)\nimport @acme/l16b@1 (T16b)\ntype T15a = { a: Maybe T16a, b: Maybe T16b }"),
    Package("vendor/l15b", "@acme/l15b", "1.0.0", "import @acme/l16a@1 (T16a)\nimport @acme/l16b@1 (T16b)\ntype T15b = { a: Maybe T16a, b: Maybe T16b }"),
    Package("vendor/l16a", "@acme/l16a", "1.0.0", "import @acme/l17a@1 (T17a)\nimport @acme/l17b@1 (T17b)\ntype T16a = { a: Maybe T17a, b: Maybe T17b }"),
    Package("vendor/l16b", "@acme/l16b", "1.0.0", "import @acme/l17a@1 (T17a)\nimport @acme/l17b@1 (T17b)\ntype T16b = { a: Maybe T17a, b: Maybe T17b }"),
    Package("vendor/l17a", "@acme/l17a", "1.0.0", "import @acme/l18a@1 (T18a)\nimport @acme/l18b@1 (T18b)\ntype T17a = { a: Maybe T18a, b: Maybe T18b }"),
    Package("vendor/l17b", "@acme/l17b", "1.0.0", "import @acme/l18a@1 (T18a)\nimport @acme/l18b@1 (T18b)\ntype T17b = { a: Maybe T18a, b: Maybe T18b }"),
    Package("vendor/l18a", "@acme/l18a", "1.0.0", "import @acme/l19a@1 (T19a)\nimport @acme/l19b@1 (T19b)\ntype T18a = { a: Maybe T19a, b: Maybe T19b }"),
    Package("vendor/l18b", "@acme/l18b", "1.0.0", "import @acme/l19a@1 (T19a)\nimport @acme/l19b@1 (T19b)\ntype T18b = { a: Maybe T19a, b: Maybe T19b }"),
    Package("vendor/l19a", "@acme/l19a", "1.0.0", "import @acme/l20a@1 (T20a)\nimport @acme/l20b@1 (T20b)\ntype T19a = { a: Maybe T20a, b: Maybe T20b }"),
    Package("vendor/l19b", "@acme/l19b", "1.0.0", "import @acme/l20a@1 (T20a)\nimport @acme/l20b@1 (T20b)\ntype T19b = { a: Maybe T20a, b: Maybe T20b }"),
    Package("vendor/l20a", "@acme/l20a", "1.0.0", "import @acme/l21a@1 (T21a)\nimport @acme/l21b@1 (T21b)\ntype T20a = { a: Maybe T21a, b: Maybe T21b }"),
    Package("vendor/l20b", "@acme/l20b", "1.0.0", "import @acme/l21a@1 (T21a)\nimport @acme/l21b@1 (T21b)\ntype T20b = { a: Maybe T21a, b: Maybe T21b }"),
    Package("vendor/l21a", "@acme/l21a", "1.0.0", "import @acme/l22a@1 (T22a)\nimport @acme/l22b@1 (T22b)\ntype T21a = { a: Maybe T22a, b: Maybe T22b }"),
    Package("vendor/l21b", "@acme/l21b", "1.0.0", "import @acme/l22a@1 (T22a)\nimport @acme/l22b@1 (T22b)\ntype T21b = { a: Maybe T22a, b: Maybe T22b }"),
    Package("vendor/l22a", "@acme/l22a", "1.0.0", "import @acme/l23a@1 (T23a)\nimport @acme/l23b@1 (T23b)\ntype T22a = { a: Maybe T23a, b: Maybe T23b }"),
    Package("vendor/l22b", "@acme/l22b", "1.0.0", "import @acme/l23a@1 (T23a)\nimport @acme/l23b@1 (T23b)\ntype T22b = { a: Maybe T23a, b: Maybe T23b }"),
    Package("vendor/l23a", "@acme/l23a", "1.0.0", "type T23a = { id: Int }"),
    Package("vendor/l23b", "@acme/l23b", "1.0.0", "type T23b = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["vendor"] },
  expect: Ok { packages: ["@acme/l00a@1.0.0", "@acme/l00b@1.0.0", "@acme/l01a@1.0.0", "@acme/l01b@1.0.0", "@acme/l02a@1.0.0", "@acme/l02b@1.0.0", "@acme/l03a@1.0.0", "@acme/l03b@1.0.0", "@acme/l04a@1.0.0", "@acme/l04b@1.0.0", "@acme/l05a@1.0.0", "@acme/l05b@1.0.0", "@acme/l06a@1.0.0", "@acme/l06b@1.0.0", "@acme/l07a@1.0.0", "@acme/l07b@1.0.0", "@acme/l08a@1.0.0", "@acme/l08b@1.0.0", "@acme/l09a@1.0.0", "@acme/l09b@1.0.0", "@acme/l10a@1.0.0", "@acme/l10b@1.0.0", "@acme/l11a@1.0.0", "@acme/l11b@1.0.0", "@acme/l12a@1.0.0", "@acme/l12b@1.0.0", "@acme/l13a@1.0.0", "@acme/l13b@1.0.0", "@acme/l14a@1.0.0", "@acme/l14b@1.0.0", "@acme/l15a@1.0.0", "@acme/l15b@1.0.0", "@acme/l16a@1.0.0", "@acme/l16b@1.0.0", "@acme/l17a@1.0.0", "@acme/l17b@1.0.0", "@acme/l18a@1.0.0", "@acme/l18b@1.0.0", "@acme/l19a@1.0.0", "@acme/l19b@1.0.0", "@acme/l20a@1.0.0", "@acme/l20b@1.0.0", "@acme/l21a@1.0.0", "@acme/l21b@1.0.0", "@acme/l22a@1.0.0", "@acme/l22b@1.0.0", "@acme/l23a@1.0.0", "@acme/l23b@1.0.0"] },
},
// ── B: new rules ──────────────────────────────────────────────────────────────
Case {
  name: "scope-directory-node-modules",
  about: "F1: node_modules/@acme/node_modules (an npm alias can install it) is not a place to look, though Node looks there: orders gets the common the application installed",
  files: [
    Npm("app", { dependencies: ["@acme/orders"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", peerDependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
    Package("app/node_modules/@acme/node_modules/@acme/common", "@acme/common", "1.9.9", "type Address = { city: String, note?: String }"),
    Npm("app/node_modules/@acme/node_modules/@acme/common", { name: "@acme/common", version: "1.9.9" }),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},
Case {
  name: "manifest-name-node-modules",
  about: "F1: node_modules is not a name",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/node_modules", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "package-manifest" },
},
Case {
  name: "identical-copies-different-dependencies",
  about: "F4: two identical copies of orders, whose import of common finds 1.4.0 from one place and 1.2.0 from the other. Every copy's imports are resolved, whichever copy is loaded first",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/billing"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\nimport @acme/billing@1 (Bill)\ntype Root = { order: Order, bill: Bill }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.4.0", "type Address = { city: String, zip?: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.4.0" }),
    Package("app/node_modules/@acme/billing", "@acme/billing", "1.0.0", "import @acme/orders@1 (Order)\ntype Bill = { order: Order }"),
    Npm("app/node_modules/@acme/billing", { name: "@acme/billing", version: "1.0.0", dependencies: ["@acme/orders"] }),
    Package("app/node_modules/@acme/billing/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/billing/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/billing/node_modules/@acme/common", "@acme/common", "1.2.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/billing/node_modules/@acme/common", { name: "@acme/common", version: "1.2.0" }),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "duplicate-package", mentions: ["1.2.0", "1.4.0"] },
},
Case {
  name: "no-project-no-npm-lookup",
  about: "F3: a file with no package.json above it has no npm dependencies; a node_modules further up is not its own",
  files: [
    File("work/app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("work/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("work/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "work/app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "undeclared-and-not-installed",
  about: "F5: the declaration is checked before anything is looked for",
  files: [
    Npm("app", { name: "shop" }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "package-json-not-json",
  about: "the nearest package.json isn't valid JSON: it declares nothing, and the search doesn't go on to the one above (spec §13.3, Files and limits)",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/schemas/package.json", "{ \"name\": \"schemas\", "),
    File("app/schemas/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/schemas/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "package-json-without-a-project",
  about: "Q1: a package.json with no name and no dependency field, such as a module-type marker, is not the project's",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/schemas/package.json", "{ \"type\": \"module\" }"),
    File("app/schemas/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/schemas/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "package-json-not-an-object",
  about: "the nearest package.json is valid JSON but not an object: it is skipped, and the one above declares the package (spec §13.3)",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/schemas/package.json", "[\"@acme/common\"]"),
    File("app/schemas/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/schemas/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "package-json-not-a-regular-file",
  about: "the nearest package.json is a directory: it declares nothing, and the search doesn't go on to the one above (spec §13.3)",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/schemas/package.json/index.json", "{ \"name\": \"schemas\", \"dependencies\": { \"@acme/common\": \"*\" } }"),
    File("app/schemas/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/schemas/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "dependency-field-not-an-object-without-name",
  about: "a package.json whose only field is a dependency field that isn't an object is the project's: the search stops there, and it declares nothing (spec §13.3)",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/schemas/package.json", "{ \"dependencies\": \"@acme/common\" }"),
    File("app/schemas/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/schemas/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "package-own-package-json-not-json",
  about: "a package's own package.json that isn't valid JSON declares nothing, so its schema can't import another package (spec §13.3)",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    File("app/node_modules/@acme/orders/package.json", "{ \"name\": \"@acme/orders\", \"dependencies\": { \"@acme/common\": \"*\" }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "package-json-version-not-a-string",
  should: True,
  about: "the version of a package.json is checked only when it is a string: a number gives no version to check (spec §13.3)",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    File("app/node_modules/@acme/common/package.json", "{ \"name\": \"@acme/common\", \"version\": 2 }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "relative-import-tilde",
  about: "a file path in an import has only A-Z, a-z, 0-9, _, ., / and - (grammar.ebnf, path): a ~ is a syntax error, also when a file of that name exists",
  files: [
    File("app/app.schema.haus", "import ./a~b (A)\ntype Root = { a: A }"),
    File("app/a~b.schema.haus", "type A = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "schema-syntax" },
},
Case {
  name: "schema-is-a-link-inside",
  about: "F6: package.haus and schema.haus are regular files, never links (today's rule allows this one)",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    File("vendor/orders/package.haus", "{ name: \"@acme/orders\", version: \"1.0.0\" }"),
    Link("vendor/orders/schema.haus", "v1.haus"),
    File("vendor/orders/v1.haus", "type Order = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path" },
},
Case {
  name: "schema-links-out-dangling",
  about: "F6: a link to a file outside that doesn't exist is still a link out, not a missing schema",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    File("vendor/orders/package.haus", "{ name: \"@acme/orders\", version: \"1.0.0\" }"),
    Link("vendor/orders/schema.haus", "../../missing/schema.haus"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path" },
},
Case {
  name: "package-json-links-out",
  about: "F7: a package's package.json is read under the same rule as its other two files",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Link("app/node_modules/@acme/common/package.json", "../../../../secret/package.json"),
    File("secret/package.json", "{ \"name\": \"internal\", \"version\": \"9.9.9-do-not-print\" }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "package-path", hides: ["do-not-print"] },
},
Case {
  name: "package-json-version-not-a-version",
  should: True,
  about: "F7: text from package.json that is not a semantic version is not quoted",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0 do-not-print" }),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "package-version", hides: ["do-not-print"] },
},
Case {
  name: "app-file-links-to-another-file",
  rootDir: ".",
  about: "F8: pins.schema.haus is a link to a file that isn't a schema file: a relative import follows no link, and reads only a file named .schema.haus",
  files: [
    File("app/app.schema.haus", "import ./pins (Pin)\ntype Root = { pin: Pin }"),
    Link("app/pins.schema.haus", "../secret/creds.txt"),
    File("secret/creds.txt", "API_TOKEN=do-not-print"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found", hides: ["API_TOKEN", "do-not-print"] },
},
Case {
  name: "relative-import-wrong-case",
  about: "F11: the import spells names as the directory lists them, on every file system",
  files: [
    File("app/app.schema.haus", "import ./Billing/common (Iban)\ntype Root = { bill: Iban }"),
    File("app/billing/common.schema.haus", "type Iban = { number: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},
Case {
  name: "folder-invalid-manifest-not-imported",
  about: "Q5: an invalid package in a folder fails only the imports that could have meant it",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("schemas/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    File("schemas/broken/package.haus", "{ name: \"@Acme/Broken\" "),
    File("schemas/broken/schema.haus", "type X = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["schemas"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "folder-invalid-manifest-and-import-not-found",
  about: "Q5: the message of a failed import names the manifests in the folders that could not be read",
  files: [
    File("app/app.schema.haus", "import @acme/broken@1 (X)\ntype Root = { x: X }"),
    File("schemas/broken/package.haus", "{ name: \"@Acme/Broken\" "),
    File("schemas/broken/schema.haus", "type X = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["schemas"] },
  expect: Err { code: "import-not-found", mentions: ["schemas/broken"] },
},
Case {
  name: "explicit-mode-does-not-read-node-modules",
  about: "Q8: with mode Explicit, only the given packages exist",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},
// ── C: explicit packages and node_modules together (needs `mode: Npm { packages?, folders? }`) ────
Case {
  name: "package-overrides-npm",
  about: "a package given by its directory is used instead of the installed one",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
    Package("local/common", "@acme/common", "1.1.0", "type Address = { city: String, zip?: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm { packages: ["local/common"] },
  expect: Ok { packages: ["@acme/common@1.1.0"] },
},
Case {
  name: "folder-shadows-npm",
  about: "F2: a package that is only found by scanning a folder does not replace an installed package with other files",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
    Package("shared/anything", "@acme/common", "1.0.0", "type Address = { city: String, note?: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm { folders: ["shared"] },
  expect: Err { code: "duplicate-package" },
},
Case {
  name: "folder-same-as-npm",
  about: "F2: identical copies are one package",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
    Package("shared/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "npm",
  mode: Npm { folders: ["shared"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},

// ── names, versions and imports (round 1 of the spec-to-test map) ───────────

Case {
  name: "manifest-name-214",
