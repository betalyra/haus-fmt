// Package resolution (spec §13.3). Each case is a file tree, the schema file
// to load (`root`), how packages are found (`mode`), and the result. See
// test-suite/README.md, "Package suite", for how adapters run a case.
//
// Packages used below:
//   @acme/common  type Address = { city: String }
//   @acme/money   type Money = { amount: Decimal }
//   @acme/orders  imports @acme/common@1 (and in some cases @acme/money@1)

// ── finding packages ────────────────────────────────────────────────────────

Case {
  name: "npm-hoisted",
  about: "app → orders → common, all declared, all installed in app/node_modules",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", peerDependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},

Case {
  name: "npm-nested",
  about: "orders' dependency is installed inside orders, not hoisted",
  files: [
    Npm("app", { dependencies: ["@acme/orders"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/orders/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/orders/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},

Case {
  name: "pnpm-isolated",
  about: "pnpm's layout: app/node_modules has only links; orders finds common from its real path in the store",
  files: [
    Npm("app", { dependencies: ["@acme/orders"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Link("app/node_modules/@acme/orders", "../.pnpm/@acme+orders@1.0.0/node_modules/@acme/orders"),
    Package("app/node_modules/.pnpm/@acme+orders@1.0.0/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/.pnpm/@acme+orders@1.0.0/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Link("app/node_modules/.pnpm/@acme+orders@1.0.0/node_modules/@acme/common", "../../../@acme+common@1.0.0/node_modules/@acme/common"),
    Package("app/node_modules/.pnpm/@acme+common@1.0.0/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/.pnpm/@acme+common@1.0.0/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},

Case {
  name: "workspace-links",
  about: "a monorepo: the app links to a workspace package, which finds its own dependencies from its real path",
  files: [
    Npm("services/web", { dependencies: ["@acme/orders"] }),
    File("services/web/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Link("services/web/node_modules/@acme/orders", "../../../../schemas/orders"),
    Package("schemas/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("schemas/orders", { name: "@acme/orders", version: "1.0.0", peerDependencies: ["@acme/common"] }),
    Link("schemas/orders/node_modules/@acme/common", "../../../common"),
    Package("schemas/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("schemas/common", { name: "@acme/common" }),
  ],
  root: "services/web/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},

Case {
  name: "explicit-packages",
  about: "packages given one by one (a CLI's --package, Python's packages=, a Cargo build)",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("vendor/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Package("vendor/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/orders", "vendor/common"] },
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},

Case {
  name: "explicit-folder",
  about: "a folder of packages: the manifests name them, not the directory names",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("schemas/orders-v1", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\nimport @acme/money@1 (Money)\ntype Order = { to: Address, total: Money }"),
    Package("schemas/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Package("schemas/money", "@acme/money", "1.0.0", "type Money = { amount: Decimal }"),
    File("schemas/README.md", "not a package: no package.haus"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { folders: ["schemas"] },
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/money@1.0.0", "@acme/orders@1.0.0"] },
},

Case {
  name: "not-installed",
  files: [
    Npm("app", { dependencies: ["@acme/orders"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "import-not-found" },
},

Case {
  name: "npm-directory-names-another-package",
  about: "node_modules/@acme/orders holds a manifest named @acme/other",
  files: [
    Npm("app", { dependencies: ["@acme/orders"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/other", "1.0.0", "type Order = { id: Int }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "import-not-found" },
},

Case {
  name: "wrong-major",
  about: "the import asks for @2, 1.4.0 is installed",
  files: [
    File("app/app.schema.haus", "import @acme/common@2 (Address)\ntype Root = { to: Address }"),
    Package("vendor/common", "@acme/common", "1.4.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "import-version" },
},

// ── declared dependencies (D3) ──────────────────────────────────────────────

Case {
  name: "undeclared-in-package",
  about: "orders imports common without declaring it; common is there only because the app installed it",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0" }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "undeclared-package", mentions: ["@acme/common", "@acme/orders"] },
},

Case {
  name: "undeclared-in-app",
  about: "the app imports common, which is installed only as a dependency of orders",
  files: [
    Npm("app", { dependencies: ["@acme/orders"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\nimport @acme/common@1 (Address)\ntype Root = { order: Order, home: Address }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "undeclared-package", mentions: ["@acme/common"] },
},

Case {
  name: "dev-dependency-in-app",
  about: "an application may declare schema packages as devDependencies",
  files: [
    Npm("app", { devDependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},

Case {
  name: "dev-dependency-in-package",
  about: "a package's devDependencies are not installed for its users, so they don't count",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", devDependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},

Case {
  name: "package-without-package-json",
  about: "a package copied into node_modules without a package.json declares nothing; the app's package.json doesn't speak for it (security review F3)",
  files: [
    Npm("app", { dependencies: ["@acme/orders"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "undeclared-package", mentions: ["@acme/common"] },
},

Case {
  name: "optional-dependency",
  files: [
    Npm("app", { optionalDependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},

// ── one copy of each package (D1, D2) ───────────────────────────────────────

Case {
  name: "two-minor-versions",
  about: "the app has common 1.4.0, orders a nested 1.2.0: haus never picks one",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\nimport @acme/common@1 (Address)\ntype Root = { order: Order, home: Address }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/orders/node_modules/@acme/common", "@acme/common", "1.2.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/orders/node_modules/@acme/common", { name: "@acme/common", version: "1.2.0" }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.4.0", "type Address = { city: String, zip?: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.4.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "duplicate-package", mentions: ["1.2.0", "1.4.0"] },
},

Case {
  name: "two-major-versions",
  about: "the app uses common@2, orders common@1: one major per build",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\nimport @acme/common@2 (Address)\ntype Root = { order: Order, home: Address }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/orders/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/orders/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
    Package("app/node_modules/@acme/common", "@acme/common", "2.0.0", "type Address = { city: String, country: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "2.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "duplicate-package", mentions: ["1.0.0", "2.0.0"] },
},

Case {
  name: "identical-copies",
  about: "two copies with the same package.haus and schema.haus are one package",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\nimport @acme/common@1 (Address)\ntype Root = { order: Order, home: Address }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/orders/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/orders/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},

Case {
  name: "same-version-different-files",
  about: "two copies of 1.0.0 whose schemas differ",
  files: [
    Npm("app", { dependencies: ["@acme/orders", "@acme/common"] }),
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\nimport @acme/common@1 (Address)\ntype Root = { order: Order, home: Address }"),
    Package("app/node_modules/@acme/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Npm("app/node_modules/@acme/orders", { name: "@acme/orders", version: "1.0.0", dependencies: ["@acme/common"] }),
    Package("app/node_modules/@acme/orders/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/orders/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { town: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "duplicate-package" },
},

Case {
  name: "explicit-same-name-twice",
  about: "two given directories whose manifests have the same name",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("a/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Package("b/common", "@acme/common", "1.1.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["a/common", "b/common"] },
  expect: Err { code: "duplicate-package", mentions: ["1.0.0", "1.1.0"] },
},

// ── manifests (D10) and versions ────────────────────────────────────────────

Case {
  name: "manifest-unknown-field",
  about: "fields other than name and version are ignored",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    File("vendor/common/package.haus", "{ name: \"@acme/common\", version: \"1.0.0\", description: \"addresses\", schema: \"../../x\" }"),
    File("vendor/common/schema.haus", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},

Case {
  name: "manifest-uppercase-name",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@Acme/Common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "package-manifest" },
},

Case {
  name: "manifest-short-version",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/common", "1", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "package-manifest" },
},

Case {
  name: "manifest-not-a-record",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    File("vendor/common/package.haus", "\"@acme/common\""),
    File("vendor/common/schema.haus", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "package-manifest" },
},

Case {
  name: "manifest-dot-segment",
  about: "a name like @acme/.. could reach outside node_modules",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/..", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "package-manifest" },
},

Case {
  name: "version-differs-from-npm",
  should: True,
  about: "package.haus says 1.0.0, the package.json next to it 1.1.0",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.1.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "package-version", mentions: ["1.0.0", "1.1.0"] },
},

// ── files outside packages (D5) ─────────────────────────────────────────────

Case {
  name: "app-files-same-name",
  about: "billing/common and shipping/common are two files; no package.json",
  files: [
    File("app/app.schema.haus", "import ./billing/common (Iban)\nimport ./shipping/common (Address)\ntype Root = { bill: Iban, ship: Address }"),
    File("app/billing/common.schema.haus", "type Iban = { number: String }"),
    File("app/shipping/common.schema.haus", "type Address = { street: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit {},
  expect: Ok { packages: [] },
},

Case {
  name: "app-files-same-name-npm",
  about: "the same, inside an npm project",
  files: [
    Npm("app", { name: "shop" }),
    File("app/app.schema.haus", "import ./billing/common (Iban)\nimport ./shipping/common (Address)\ntype Root = { bill: Iban, ship: Address }"),
    File("app/billing/common.schema.haus", "type Iban = { number: String }"),
    File("app/shipping/common.schema.haus", "type Address = { street: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Ok { packages: [] },
},

Case {
  name: "app-file-reached-twice",
  about: "./billing/common and, from shipping/rates, ../billing/common are the same file",
  files: [
    File("app/app.schema.haus", "import ./billing/common (Address)\nimport ./shipping/rates (Rate)\ntype Root = { bill: Address, rate: Rate }"),
    File("app/billing/common.schema.haus", "type Address = { iban: String }"),
    File("app/shipping/rates.schema.haus", "import ../billing/common (Address)\ntype Rate = { from: Address, price: Decimal }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit {},
  expect: Ok { packages: [] },
},

Case {
  name: "app-files-and-packages",
  about: "app files in subfolders import packages; a package is reached from two app files",
  files: [
    File("app/app.schema.haus", "import ./orders/view (OrderView)\nimport ./shipping/label (Label)\ntype Root = { view: OrderView, label: Label }"),
    File("app/orders/view.schema.haus", "import @acme/orders@1 (Order)\ntype OrderView = { order: Order }"),
    File("app/shipping/label.schema.haus", "import @acme/common@1 (Address)\ntype Label = { to: Address }"),
    Package("vendor/orders", "@acme/orders", "1.0.0", "import @acme/common@1 (Address)\ntype Order = { to: Address }"),
    Package("vendor/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { folders: ["vendor"] },
  expect: Ok { packages: ["@acme/common@1.0.0", "@acme/orders@1.0.0"] },
},

// ── what a package may reach (§9.2) ─────────────────────────────────────────

Case {
  name: "package-imports-a-file",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Package("vendor/orders", "@acme/orders", "1.0.0", "import ./extra (Item)\ntype Order = { items: Array Item }"),
    File("vendor/orders/extra.schema.haus", "type Item = { sku: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path" },
},

Case {
  name: "app-imports-into-a-package",
  files: [
    File("app/app.schema.haus", "import ../vendor/orders/schema (Order)\ntype Root = { order: Order }"),
    Package("vendor/orders", "@acme/orders", "1.0.0", "type Order = { id: Int }"),
    File("vendor/orders/schema.schema.haus", "type Order = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path" },
},

Case {
  name: "schema-links-out",
  about: "schema.haus is a link to a file outside the package; it is not read",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    File("vendor/orders/package.haus", "{ name: \"@acme/orders\", version: \"1.0.0\" }"),
    Link("vendor/orders/schema.haus", "../../secret/pins.schema.haus"),
    File("secret/pins.schema.haus", "API_TOKEN=do-not-print"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path", hides: ["API_TOKEN", "do-not-print"] },
},

Case {
  name: "package-cycle",
  files: [
    File("app/app.schema.haus", "import @acme/a@1 (A)\ntype Root = { a: A }"),
    Package("vendor/a", "@acme/a", "1.0.0", "import @acme/b@1 (B)\ntype A = { b: Maybe B }"),
    Package("vendor/b", "@acme/b", "1.0.0", "import @acme/a@1 (A)\ntype B = { a: Maybe A }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { folders: ["vendor"] },
  expect: Err { code: "import-cycle" },
},

// ── from the security review (plans/package-security-review.md, 2026-11-17) ──

// ── A: links and containment (existing rules) ─────────────────────────────────
Case {
  name: "manifest-links-out",
  about: "package.haus is a link to a valid manifest outside the package; it is not read",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    Link("vendor/orders/package.haus", "../../secret/creds.haus"),
    File("vendor/orders/schema.haus", "type Order = { id: Int }"),
    File("secret/creds.haus", "{ name: \"@acme/orders\", version: \"1.0.0\", token: \"do-not-print\" }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path", hides: ["do-not-print"] },
},
Case {
  name: "schema-links-through-inner-directory",
  about: "the link's text stays inside the package, its real path does not; rejected already because schema.haus is a link (F6)",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    File("vendor/orders/package.haus", "{ name: \"@acme/orders\", version: \"1.0.0\" }"),
    Link("vendor/orders/inner", "../../secret"),
    Link("vendor/orders/schema.haus", "inner/pins.schema.haus"),
    File("secret/pins.schema.haus", "API_TOKEN=do-not-print"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path", hides: ["API_TOKEN", "do-not-print"] },
},
Case {
  name: "schema-links-to-sibling-with-same-prefix",
  about: "schema.haus is a link to a sibling directory with the same prefix; rejected already because it is a link (F6). Prefixes: see app-imports-next-to-a-package",
  files: [
    File("app/app.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { order: Order }"),
    File("vendor/orders/package.haus", "{ name: \"@acme/orders\", version: \"1.0.0\" }"),
    Link("vendor/orders/schema.haus", "../orders-internal/schema.haus"),
    File("vendor/orders-internal/schema.haus", "type Order = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path" },
},
Case {
  name: "app-directory-links-into-a-package",
  about: "app/lib is a link to a package directory: the target's real path is in a package, given or not",
  files: [
    File("app/app.schema.haus", "import ./lib/extra (Item)\ntype Root = { item: Item }"),
    Link("app/lib", "../vendor/orders"),
    Package("vendor/orders", "@acme/orders", "1.0.0", "type Order = { id: Int }"),
    File("vendor/orders/extra.schema.haus", "type Item = { sku: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit {},
  expect: Err { code: "package-path" },
},
Case {
  name: "app-imports-next-to-a-package",
  about: "vendor/common-extra is next to the package vendor/common, not inside it: paths are compared by segments, not as string prefixes",
  files: [
    File("app/app.schema.haus", "import ../vendor/common-extra/x (X)\ntype Root = { x: X }"),
    Package("vendor/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    File("vendor/common-extra/x.schema.haus", "type X = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit {},
  expect: Ok { packages: [] },
},
Case {
  name: "app-file-links-to-a-package-schema",
  about: "order.schema.haus is a link to a package's schema.haus: its real path is in a package directory, which is checked before the file name (spec §13.3, Imports)",
  files: [
    File("app/app.schema.haus", "import ./order (Order)\ntype Root = { order: Order }"),
    Link("app/order.schema.haus", "../vendor/orders/schema.haus"),
    Package("vendor/orders", "@acme/orders", "1.0.0", "type Order = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit {},
  expect: Err { code: "package-path" },
},
// ── A: finding packages (existing rules) ──────────────────────────────────────
Case {
  name: "npm-nearest-is-not-a-schema-package",
  about: "the nearest node_modules/@acme/common has no package.haus: the lookup stops there and never falls through to a directory further up",
  files: [
    Npm("ws", { name: "ws" }),
    Npm("ws/web", { dependencies: ["@acme/common"] }),
    File("ws/web/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Npm("ws/web/node_modules/@acme/common", { name: "@acme/common", version: "3.0.0" }),
    Package("ws/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("ws/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "ws/web/app.schema.haus",
  mode: Npm,
  expect: Err { code: "import-not-found" },
},
Case {
  name: "folder-subdirectory-is-a-link",
  about: "a package directory may be a link, in a folder of packages too",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Link("schemas/common", "../store/common-1.0.0"),
    Package("store/common-1.0.0", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { folders: ["schemas"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "folder-is-not-searched-deeper",
  about: "only direct subdirectories of a folder are packages",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("schemas/acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { folders: ["schemas"] },
  expect: Err { code: "import-not-found" },
},
Case {
  name: "explicit-identical-twice",
  about: "two given directories with the same files are one package",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("a/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Package("b/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["a/common", "b/common"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "import-without-major",
  files: [
    File("app/app.schema.haus", "import @acme/common (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/common", "2.3.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Ok { packages: ["@acme/common@2.3.0"] },
},
Case {
  name: "major-zero-with-prerelease-and-build",
  files: [
    File("app/app.schema.haus", "import @acme/common@0 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/common", "0.3.0-rc.1+build.7", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Ok { packages: ["@acme/common@0.3.0-rc.1+build.7"] },
},
// ── A: manifests (existing rules; regex and parser differences) ───────────────
Case {
  name: "manifest-two-records",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
