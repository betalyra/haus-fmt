    File("app/f250.schema.haus", "type T250 = Int"),
    File("app/f251.schema.haus", "type T251 = Int"),
    File("app/f252.schema.haus", "type T252 = Int"),
    File("app/f253.schema.haus", "type T253 = Int"),
    File("app/f254.schema.haus", "type T254 = Int"),
    File("app/f255.schema.haus", "type T255 = Int"),
    File("app/f256.schema.haus", "type T256 = Int"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "too-many-files" },
},

// ── folders, and the package.json beside an explicit package (§13.3) ───────

Case {
  name: "version-differs-in-folder",
  should: True,
  about: "Z7: a folder's subdirectory whose package.json version differs from its manifest is skipped like a broken one, and named when the import isn't found",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("schemas/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("schemas/common", { name: "@acme/common", version: "1.1.0" }),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["schemas"] },
  expect: Err { code: "import-not-found", mentions: ["schemas/common"] },
},
Case {
  name: "version-differs-in-folder-not-imported",
  about: "Z7: a skipped subdirectory fails only the imports that could have meant it",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("schemas/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Package("schemas/money", "@acme/money", "1.0.0", "type Money = { amount: Decimal }"),
    Npm("schemas/money", { name: "@acme/money", version: "1.1.0" }),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["schemas"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "explicit-package-json-link-ignored",
  about: "Z7: outside npm mode, a package.json beside an explicit package that can't be read (here a symbolic link) is ignored, not an error",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    File("vendor/elsewhere.json", "{ \"name\": \"@acme/common\", \"version\": \"1.1.0\" }"),
    Link("vendor/common/package.json", "../elsewhere.json"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "explicit-package-json-not-json-ignored",
  about: "Z7: outside npm mode, a package.json beside an explicit package that isn't JSON is ignored",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    File("vendor/common/package.json", "{ version: 1.1.0 }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "folder-package-json-link-ignored",
  about: "Z7: the same for a package found in a folder: a package.json that is a link is ignored, and the package is used",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("schemas/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    File("elsewhere.json", "{ \"name\": \"@acme/common\", \"version\": \"1.1.0\" }"),
    Link("schemas/common/package.json", "../../elsewhere.json"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["schemas"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
Case {
  name: "folder-given-with-dot-slash",
  about: "Z10: a skipped subdirectory is named by the last name of the folder's real path, however the folder was given (here ./schemas/)",
  files: [
    File("app/app.schema.haus", "import @acme/broken@1 (X)\ntype Root = { x: X }"),
    File("schemas/broken/package.haus", "{ name: \"@Acme/Broken\" "),
    File("schemas/broken/schema.haus", "type X = { id: Int }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["./schemas/"] },
  expect: Err { code: "import-not-found", mentions: ["schemas/broken"], hides: ["./schemas/broken", "schemas//broken"] },
},
Case {
  name: "folder-given-by-link",
  about: "Z10: a folder given by a symbolic link is named by its real path's last name",
  files: [
    File("app/app.schema.haus", "import @acme/broken@1 (X)\ntype Root = { x: X }"),
    File("schemas/broken/package.haus", "{ name: \"@Acme/Broken\" "),
    File("schemas/broken/schema.haus", "type X = { id: Int }"),
    Link("pkgs", "schemas"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { folders: ["pkgs"] },
  expect: Err { code: "import-not-found", mentions: ["schemas/broken"], hides: ["pkgs/broken"] },
},

// ── security round 2026-11-22 (plans/security-review-imports.md, section 4) ──

// ── paths: `..` only at the start (spec §13.3 "Resolution", grammar `path`) ──
Case {
  name: "relative-dotdot-after-link",
  about: "P1: ./link/../x would name a different file depending on how .. resolves through the link; .. after a name is not a path, and the syntax is checked before anything is looked at (the link isn't reached)",
  files: [
    File("app/a.schema.haus", "import ./link/../x (X)\ntype Root = { x: X }"),
    File("app/x.schema.haus", "type X = { fromApp: Int }"),
    File("other/x.schema.haus", "type Y = { fromOther: Int }"),
    File("other/sub/keep.schema.haus", "type K = Int"),
    Link("app/link", "../other/sub"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "schema-syntax" },
},
Case {
  name: "relative-import-trailing-slash",
  about: "P2: ./x/ names no file: not x.schema.haus, not the hidden x/.schema.haus",
  files: [
    File("app/a.schema.haus", "import ./x/ (X)\ntype Root = { x: X }"),
    File("app/x.schema.haus", "type X = { a: Int }"),
    File("app/x/.schema.haus", "type X = { hidden: Int }"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "schema-syntax" },
},
Case {
  name: "relative-import-dot-only",
  about: "P3: ./ alone is no path: neither .schema.haus nor ..schema.haus is read",
  files: [
    File("app/a.schema.haus", "import ./ (X)\ntype Root = { x: X }"),
    File("app/.schema.haus", "type X = Int"),
    File("app/..schema.haus", "type X = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "schema-syntax" },
},
Case {
  name: "relative-import-double-slash",
  about: "P4: .//etc/y has an empty name: not a path, and never /etc/y.schema.haus",
  files: [
    File("app/a.schema.haus", "import .//etc/y (Y)\ntype Root = { y: Y }"),
    File("app/etc/y.schema.haus", "type Y = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "schema-syntax" },
},

// ── the root (spec §13.3 "The root") ──
Case {
  name: "relative-import-above-the-root",
  about: "P5: by default the root is the entry file's directory (proj/app); ../../elsewhere goes above it and is rejected before anything is looked at",
  files: [
    Npm("proj", { name: "proj" }),
    File("proj/app/a.schema.haus", "import ../../elsewhere/s (S)\ntype Root = { s: S }"),
    File("elsewhere/s.schema.haus", "type S = { pin: String }"),
  ],
  root: "proj/app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-outside-root", hides: ["pin"] },
},
Case {
  name: "relative-import-above-the-root-missing",
  about: "the same when nothing is there: the error doesn't depend on what is above the root",
  files: [
    File("proj/app/a.schema.haus", "import ../../elsewhere/s (S)\ntype Root = { s: S }"),
  ],
  root: "proj/app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-outside-root" },
},
Case {
  name: "relative-import-up-within-the-root",
  about: "../ that stays inside the root is fine: app/sub/b imports ../c, both in the root app",
  files: [
    File("app/a.schema.haus", "import ./sub/b (B)\ntype Root = { b: B }"),
    File("app/sub/b.schema.haus", "import ../c (C)\ntype B = { c: C }"),
    File("app/c.schema.haus", "type C = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Ok { packages: [] },
},
Case {
  name: "root-option-widens",
  about: "the build's root option (rootDir) names a directory that contains the entry file: ../shared is inside it",
  rootDir: "proj",
  files: [
    File("proj/app/a.schema.haus", "import ../shared/s (S)\ntype Root = { s: S }"),
    File("proj/shared/s.schema.haus", "type S = { id: Int }"),
  ],
  root: "proj/app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Ok { packages: [] },
},
Case {
  name: "root-option-not-above-the-entry",
  about: "a root option that doesn't contain the entry file is rejected",
  rootDir: "lib",
  files: [
    File("app/a.schema.haus", "type Root = Int"),
    File("lib/x.schema.haus", "type X = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-outside-root" },
},
Case {
  name: "relative-import-links-out-of-the-root",
  about: "./lib/x is inside the root as written, and app/lib is a link outside it: a relative import follows no link, so nothing outside is looked at, and the message doesn't say where the link points",
  files: [
    File("app/a.schema.haus", "import ./lib/x (X)\ntype Root = { x: X }"),
    Link("app/lib", "../outside"),
    File("outside/x.schema.haus", "type X = { secret: String }"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found", mentions: ["link"], hides: ["secret"] },
},
Case {
  name: "relative-import-link-inside-the-root",
  about: "a link is not followed even when its target stays inside the root: app/lib is a link to app/shared",
  files: [
    File("app/a.schema.haus", "import ./lib/x (X)\ntype Root = { x: X }"),
    Link("app/lib", "shared"),
    File("app/shared/x.schema.haus", "type X = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found", mentions: ["link"] },
},
Case {
  name: "relative-import-link-in-the-middle",
  about: "a link to a directory in the middle of the path, inside the root: app/sub/lib is a link to app/shared; the message says it is a link, not where it points",
  files: [
    File("app/a.schema.haus", "import ./sub/lib/x (X)\ntype Root = { x: X }"),
    Link("app/sub/lib", "../shared"),
    File("app/shared/x.schema.haus", "type X = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found", mentions: ["link"], hides: ["shared"] },
},
Case {
  name: "relative-import-last-name-is-a-link",
  about: "the file name is a link to a schema file next to it, inside the root: not followed, and the message doesn't say where it points",
  files: [
    File("app/a.schema.haus", "import ./x (X)\ntype Root = { x: X }"),
    Link("app/x.schema.haus", "v2.schema.haus"),
    File("app/v2.schema.haus", "type X = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found", mentions: ["link"], hides: ["v2"] },
},
Case {
  name: "entry-file-reached-through-a-link",
  about: "the entry file may be reached through a link: it is resolved to its real path once, at the start, and its relative imports go from there",
  files: [
    Link("current", "proj/app"),
    File("proj/app/a.schema.haus", "import ./b (B)\ntype Root = { b: B }"),
    File("proj/app/b.schema.haus", "type B = Int"),
  ],
  root: "current/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Ok { packages: [] },
},
Case {
  name: "root-option-reached-through-a-link",
  about: "the root option may be reached through a link: it is resolved to its real path once, at the start (here the entry file's grandparent)",
  rootDir: "workspace",
  files: [
    Link("workspace", "proj"),
    File("proj/app/a.schema.haus", "import ../shared/s (S)\ntype Root = { s: S }"),
    File("proj/shared/s.schema.haus", "type S = { id: Int }"),
  ],
  root: "proj/app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Ok { packages: [] },
},
Case {
  name: "root-is-a-package-schema",
  about: "P10: a package's schema.haus loaded as the entry file is still a package's: it imports no files",
  files: [
    Package("vendor/orders", "@acme/orders", "1.0.0", "import ./extra (Item)\ntype Order = { items: Array Item }"),
    File("vendor/orders/extra.schema.haus", "type Item = { sku: String }"),
  ],
  root: "vendor/orders/schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "package-path" },
},

// ── files read: regular files only (spec §13.3 "Files read") ──
Case {
  name: "relative-import-is-a-directory",
  about: "P11: a directory named x.schema.haus is not a regular file",
  files: [
    File("app/a.schema.haus", "import ./x (X)\ntype Root = { x: X }"),
    File("app/x.schema.haus/inner.txt", "a directory named x.schema.haus"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},
Case {
  name: "relative-import-is-a-fifo",
  about: "P12: a FIFO named x.schema.haus is not a regular file: not read, and the open doesn't block (runners use a timeout)",
  os: "unix",
  files: [
    File("app/a.schema.haus", "import ./x (X)\ntype Root = { x: X }"),
    Fifo("app/x.schema.haus"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},
Case {
  name: "package-schema-is-a-fifo",
  about: "a package's schema.haus that is a FIFO is not opened (it would block)",
  os: "unix",
  files: [
    File("app/a.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { o: Order }"),
    File("vendor/orders/package.haus", "{ name: \"@acme/orders\", version: \"1.0.0\" }"),
    Fifo("vendor/orders/schema.haus"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "package-path" },
},
Case {
  name: "project-package-json-links-to-a-fifo",
  about: "P13: a project's package.json that is a link (here to a FIFO) is not opened: it declares nothing",
  os: "unix",
  files: [
    Fifo("fifo"),
    Link("app/package.json", "../fifo"),
    File("app/a.schema.haus", "import @acme/common@1 (Address)\ntype Root = { a: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "project-package-json-is-a-link",
  about: "a project's package.json that is a link to a valid one is not followed: it declares nothing",
  files: [
    File("shared/package.json", "{ \"name\": \"app\", \"dependencies\": { \"@acme/common\": \"*\" } }"),
    Link("app/package.json", "../shared/package.json"),
    File("app/a.schema.haus", "import @acme/common@1 (Address)\ntype Root = { a: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "project-package-json-links-out-name-not-shown",
  about: "P18: a package.json that links to another file gives the schema's files nothing from it (npm only: outside npm a project's package.json is never read)",
  files: [
    Link("app/package.json", "../secret/creds.json"),
    File("secret/creds.json", "{ \"name\": \"do-not-print\" }"),
    File("app/a.schema.haus", "import ./b (Missing)\ntype Root = { b: Int }"),
    File("app/b.schema.haus", "type B = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "unknown-import", hides: ["do-not-print"] },
},
Case {
  name: "relative-import-too-large",
  about: "P14: a schema file of 1 MiB and one byte is not read",
  files: [
    File("app/a.schema.haus", "import ./big (X)\ntype Root = { x: X }"),
    Large("app/big.schema.haus", 1048577),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "file-too-large" },
},

// ── spelling (spec §13.3 "Spelling") ──
Case {
  name: "package-haus-wrong-case-is-not-a-manifest",
  about: "P7: Package.haus is not package.haus: app/lib is not a package directory, on every file system",
  files: [
    File("app/a.schema.haus", "import ./lib/x (X)\ntype Root = { x: X }"),
    File("app/lib/Package.haus", "{ name: \"@acme/lib\", version: \"1.0.0\" }"),
    File("app/lib/x.schema.haus", "type X = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Ok { packages: [] },
},
Case {
  name: "explicit-package-schema-wrong-case",
  about: "P8: Schema.haus is not schema.haus",
  files: [
    File("app/a.schema.haus", "import @acme/orders@1 (Order)\ntype Root = { o: Order }"),
    File("vendor/orders/package.haus", "{ name: \"@acme/orders\", version: \"1.0.0\" }"),
    File("vendor/orders/Schema.haus", "type Order = { id: Int }"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/orders"] },
  expect: Err { code: "import-not-found" },
},
Case {
  name: "relative-import-unlistable-directory",
  about: "P15: a directory that can't be listed (mode 311: the owner may enter it, not list it) can't show how a name is spelled: not found (Unix; skipped when running as root)",
  os: "unix",
  unmodelled: "the reference's file tree has no permissions",
  files: [
    File("app/a.schema.haus", "import ./sub/x (X)\ntype Root = { x: X }"),
    File("app/sub/x.schema.haus", "type X = Int"),
    Mode("app/sub", "311"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},
Case {
  name: "relative-import-package-check-unlistable",
  about: "the walk lists app/sub, but app, between the target and the root, can't be listed (mode 311): whether it is a package's directory can't be checked, so the import fails, never passes as not in a package (Unix; skipped when running as root)",
  rootDir: ".",
  os: "unix",
  unmodelled: "the reference's file tree has no permissions",
  files: [
    File("app/sub/a.schema.haus", "import ./x (X)\ntype Root = { x: X }"),
    File("app/sub/x.schema.haus", "type X = Int"),
    Mode("app", "311"),
  ],
  root: "app/sub/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},
Case {
  name: "relative-import-device-names",
  about: "P16: con, nul, aux and com1 are no schema files: not found, and nothing is opened (Windows devices)",
  files: [
    File("app/a.schema.haus", "import ./con (A)\nimport ./nul (B)\nimport ./aux (C)\nimport ./com1 (D)\ntype Root = { a: A }"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},
Case {
  name: "relative-import-trailing-dot-directory",
  about: "P17: ./sub./x: Windows would strip the dot and open sub/x.schema.haus; the directory lists sub, not sub.",
  files: [
    File("app/a.schema.haus", "import ./sub./x (X)\ntype Root = { x: X }"),
    File("app/sub/x.schema.haus", "type X = Int"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-not-found" },
},

// ── npm: a candidate that is there stops the search (spec §13.3 npm) ──
Case {
  name: "npm-nearest-is-a-dangling-link",
  about: "P6: the nearest node_modules/@acme/common is a dangling link: it is there (lstat), so the search stops and never reaches the package planted further up",
  files: [
    Npm("outer/proj/app", { dependencies: ["@acme/common"] }),
    File("outer/proj/app/a.schema.haus", "import @acme/common@1 (Address)\ntype Root = { a: Address }"),
    Link("outer/proj/app/node_modules/@acme/common", "../../../nowhere"),
    Package("outer/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { planted: Int }"),
  ],
  root: "outer/proj/app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "import-not-found" },
},
Case {
  name: "npm-nearest-is-a-link-cycle",
  about: "the nearest node_modules/@acme/common is a cycle of links (ELOOP): the search stops",
  files: [
    Npm("outer/app", { dependencies: ["@acme/common"] }),
    File("outer/app/a.schema.haus", "import @acme/common@1 (Address)\ntype Root = { a: Address }"),
    Link("outer/app/node_modules/@acme/common", "common"),
    Package("outer/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { planted: Int }"),
  ],
  root: "outer/app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "import-not-found" },
},
Case {
  name: "npm-scope-directory-unreadable",
  about: "node_modules/@acme can't be entered (EACCES): whether @acme/common is there can't be told, so the search stops (Unix; skipped when running as root)",
  os: "unix",
  unmodelled: "the reference's file tree has no permissions",
  files: [
    Npm("outer/app", { dependencies: ["@acme/common"] }),
    File("outer/app/a.schema.haus", "import @acme/common@1 (Address)\ntype Root = { a: Address }"),
    Package("outer/app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Mode("outer/app/node_modules/@acme", "000"),
    Package("outer/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { planted: Int }"),
  ],
  root: "outer/app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "import-not-found" },
},
Case {
  name: "npm-directory-wrong-case",
  about: "P9: node_modules/@Acme/Common is not node_modules/@acme/common, on every file system",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/a.schema.haus", "import @acme/common@1 (Address)\ntype Root = { a: Address }"),
    Package("app/node_modules/@Acme/Common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm,
  expect: Err { code: "import-not-found" },
},
Case {
  name: "npm-explicit-package-json-link-ignored",
  about: "with npm, a package.json beside a package given by its directory is read leniently too: a link is ignored, and the package is used",
  files: [
    Npm("app", { name: "app" }),
    File("app/a.schema.haus", "import @acme/common@1 (Address)\ntype Root = { a: Address }"),
    Package("vendor/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    File("elsewhere.json", "{ \"name\": \"@acme/common\", \"version\": \"1.1.0\" }"),
    Link("vendor/common/package.json", "../../elsewhere.json"),
  ],
  root: "app/a.schema.haus",
  ecosystem: "npm",
  mode: Npm { packages: ["vendor/common"] },
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
