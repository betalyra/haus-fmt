    Package("vendor/l08b", "@acme/l08b", "1.0.0", "import @acme/l09a@1 (T09a)\nimport @acme/l09b@1 (T09b)\ntype T08b = { a: Maybe T09a, b: Maybe T09b }"),
    Package("vendor/l09a", "@acme/l09a", "1.0.0", "import @acme/l10a@1 (T10a)\nimport @acme/l10b@1 (T10b)\ntype T09a = { a: Maybe T10a, b: Maybe T10b }"),
