Case {
  name: "major-compared-as-text",
  about: "18446744073709551616 (2^64) is a valid major that no package has, not 0 or a rejected number",
  files: [
    File("app/app.schema.haus", "import @acme/common@18446744073709551616 (Address)\ntype Root = { home: Address }"),
    Package("vendor/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "import-version" },
},

Case {
  name: "no-reexport",
  about: "b imports Address from c; a file can't re-export what it imports, so app can't import it from b",
  files: [
    File("app/app.schema.haus", "import ./b (Address)\ntype Root = { home: Address }"),
    File("app/b.schema.haus", "import ./c (Address)\ntype Home = { at: Address }"),
    File("app/c.schema.haus", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "unknown-import" },
},

Case {
  name: "error-in-imported-file",
  about: "an error inside an imported file is reported at the import, with its place in that file",
  files: [
    File("app/app.schema.haus", "import ./b (Address)\ntype Root = { home: Address }"),
    File("app/b.schema.haus", "type Address = { city: String }\ntype Address = { street: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "duplicate-type" },
},

Case {
  name: "relative-import-cycle",
  about: "a imports b, b imports a",
  files: [
    File("app/app.schema.haus", "import ./a (A)\ntype Root = { a: A }"),
    File("app/a.schema.haus", "import ./b (B)\ntype A = { b: B }"),
    File("app/b.schema.haus", "import ./a (A)\ntype B = { a?: A }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit {},
  expect: Err { code: "import-cycle" },
},

Case {
  name: "manifest-name-escaped",
  about: "a name with an escape character and 60 letters: errors quote it escaped and at most 40 characters long",
  files: [
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    File("vendor/common/package.haus", "{ name: \"@acme/\\u{1B}[31maaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", version: \"1.0.0\" }"),
    File("vendor/common/schema.haus", "type Address = { city: String }"),
  ],
  root: "app/app.schema.haus",
  ecosystem: "core",
  mode: Explicit { packages: ["vendor/common"] },
  expect: Err { code: "package-manifest", hides: ["\u{1B}", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"] },
},

