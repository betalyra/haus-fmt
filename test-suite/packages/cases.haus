// ── A: package checks (existing rules) ────────────────────────────────────────
Case {
  name: "dependencies-not-an-object",
  about: "a list or a string is not a declaration, whatever `in` or `contains` says about it",
  files: [
    File("app/package.json", "{ \"name\": \"shop\", \"dependencies\": [\"@acme/common\"], \"devDependencies\": \"@acme/common\" }"),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "undeclared-package" },
},
Case {
  name: "version-differs-by-build-metadata",
  should: True,
  about: "versions are compared as text",
  files: [
    Npm("app", { dependencies: ["@acme/common"] }),
    File("app/app.schema.haus", "import @acme/common@1 (Address)\ntype Root = { home: Address }"),
    Package("app/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("app/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0+build.5" }),
  ],
  root: "app/app.schema.haus",
  mode: Npm,
  expect: Err { code: "package-version" },
},
Case {
  name: "file-in-a-package-directory-uses-dev-dependencies",
  about: "a test schema inside a package's directory is not the package's schema.haus: devDependencies count for it",
  files: [
    Npm("schemas/orders", { name: "@acme/orders", version: "1.0.0", devDependencies: ["@acme/common"] }),
    Package("schemas/orders", "@acme/orders", "1.0.0", "type Order = { id: Int }"),
    File("schemas/orders/test/fixture.schema.haus", "import @acme/common@1 (Address)\ntype Root = { to: Address }"),
    Package("schemas/orders/node_modules/@acme/common", "@acme/common", "1.0.0", "type Address = { city: String }"),
    Npm("schemas/orders/node_modules/@acme/common", { name: "@acme/common", version: "1.0.0" }),
  ],
  root: "schemas/orders/test/fixture.schema.haus",
  mode: Npm,
  expect: Ok { packages: ["@acme/common@1.0.0"] },
},
// ── A: bounded work ───────────────────────────────────────────────────────────
Case {
  name: "diamond-lattice",
  about: "24 layers of two packages, each importing both of the next layer: 48 files, 2^24 paths. Each file is loaded once; a loader that follows every path does not finish",
  files: [
    File("app/app.schema.haus", "import @acme/l00a@1 (T00a)\nimport @acme/l00b@1 (T00b)\ntype Root = { a: T00a, b: T00b }"),
    Package("vendor/l00a", "@acme/l00a", "1.0.0", "import @acme/l01a@1 (T01a)\nimport @acme/l01b@1 (T01b)\ntype T00a = { a: Maybe T01a, b: Maybe T01b }"),
    Package("vendor/l00b", "@acme/l00b", "1.0.0", "import @acme/l01a@1 (T01a)\nimport @acme/l01b@1 (T01b)\ntype T00b = { a: Maybe T01a, b: Maybe T01b }"),
    Package("vendor/l01a", "@acme/l01a", "1.0.0", "import @acme/l02a@1 (T02a)\nimport @acme/l02b@1 (T02b)\ntype T01a = { a: Maybe T02a, b: Maybe T02b }"),
    Package("vendor/l01b", "@acme/l01b", "1.0.0", "import @acme/l02a@1 (T02a)\nimport @acme/l02b@1 (T02b)\ntype T01b = { a: Maybe T02a, b: Maybe T02b }"),
    Package("vendor/l02a", "@acme/l02a", "1.0.0", "import @acme/l03a@1 (T03a)\nimport @acme/l03b@1 (T03b)\ntype T02a = { a: Maybe T03a, b: Maybe T03b }"),
    Package("vendor/l02b", "@acme/l02b", "1.0.0", "import @acme/l03a@1 (T03a)\nimport @acme/l03b@1 (T03b)\ntype T02b = { a: Maybe T03a, b: Maybe T03b }"),
    Package("vendor/l03a", "@acme/l03a", "1.0.0", "import @acme/l04a@1 (T04a)\nimport @acme/l04b@1 (T04b)\ntype T03a = { a: Maybe T04a, b: Maybe T04b }"),
    Package("vendor/l03b", "@acme/l03b", "1.0.0", "import @acme/l04a@1 (T04a)\nimport @acme/l04b@1 (T04b)\ntype T03b = { a: Maybe T04a, b: Maybe T04b }"),
    Package("vendor/l04a", "@acme/l04a", "1.0.0", "import @acme/l05a@1 (T05a)\nimport @acme/l05b@1 (T05b)\ntype T04a = { a: Maybe T05a, b: Maybe T05b }"),
    Package("vendor/l04b", "@acme/l04b", "1.0.0", "import @acme/l05a@1 (T05a)\nimport @acme/l05b@1 (T05b)\ntype T04b = { a: Maybe T05a, b: Maybe T05b }"),
    Package("vendor/l05a", "@acme/l05a", "1.0.0", "import @acme/l06a@1 (T06a)\nimport @acme/l06b@1 (T06b)\ntype T05a = { a: Maybe T06a, b: Maybe T06b }"),
    Package("vendor/l05b", "@acme/l05b", "1.0.0", "import @acme/l06a@1 (T06a)\nimport @acme/l06b@1 (T06b)\ntype T05b = { a: Maybe T06a, b: Maybe T06b }"),
    Package("vendor/l06a", "@acme/l06a", "1.0.0", "import @acme/l07a@1 (T07a)\nimport @acme/l07b@1 (T07b)\ntype T06a = { a: Maybe T07a, b: Maybe T07b }"),
    Package("vendor/l06b", "@acme/l06b", "1.0.0", "import @acme/l07a@1 (T07a)\nimport @acme/l07b@1 (T07b)\ntype T06b = { a: Maybe T07a, b: Maybe T07b }"),
    Package("vendor/l07a", "@acme/l07a", "1.0.0", "import @acme/l08a@1 (T08a)\nimport @acme/l08b@1 (T08b)\ntype T07a = { a: Maybe T08a, b: Maybe T08b }"),
    Package("vendor/l07b", "@acme/l07b", "1.0.0", "import @acme/l08a@1 (T08a)\nimport @acme/l08b@1 (T08b)\ntype T07b = { a: Maybe T08a, b: Maybe T08b }"),
    Package("vendor/l08a", "@acme/l08a", "1.0.0", "import @acme/l09a@1 (T09a)\nimport @acme/l09b@1 (T09b)\ntype T08a = { a: Maybe T09a, b: Maybe T09b }"),
