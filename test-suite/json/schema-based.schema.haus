// Schema-based JSON (spec §16.3).
import std/time (Date, Instant)

type S = String
type B = Bytes
type Flag = Bool
type Small = Int32
type Byte = UInt8
type Big = Int
type I64 = Int64
type F64 = Float64
type F32 = Float32
type Dec = Decimal
type Day = Date
type At = Instant
type Raw = Any
type Key = Secret String
type Ints = Array Int32
type Counts = Map Int32
type Opt = Maybe Int32
type Nested = Maybe (Maybe Int32)
type OptBig = Maybe Int
type Outcome = Result String Int32
type Level = closed < Debug | Info >
type Shape = < Circle { r: Float64 } | Point Float64 Float64 | Wrap Int32 | Empty >
type User = { id: Int32, name: String, nick?: String, note?: Maybe String }
type Strict = closed { id: Int32 }
type Bits = closed < False | True >
type Loop = Maybe Loop
type BoxRec = { w: Int32 }
type Boxed = < Box BoxRec >
type BoxAlias = BoxRec
type ParenBox = < Box ({ w: Int32 }) >
type AliasBox = < Box BoxAlias >
type Page a = { items: Array a }
type Found = < Found (Page Int32) >
type GenBox a = < Box a >
type GenRec = GenBox BoxRec
type StrictBox = < Box Strict >
type SecretRec = Secret BoxRec
type SecretBox = < Box SecretRec >
type InlineSecretBox = < Box (Secret { w: Int32 }) >
type Holder v = { item: v }
type Inner a = Holder (< X a >)
type InnerRec = Inner BoxRec
type MyMaybe a = closed < None | Some a >
type Mine = MyMaybe Int32
type OptLoop = Maybe Loop
// a variant written in place inside the prelude Maybe is not itself the prelude Maybe: its None is a tag, not null
type InPlace = Maybe (closed < None | Some Int32 >)
type U64 = UInt64
// a document for the places of errors (spec §16.3 "Places")
type Doc = { shape?: Shape, maybe?: Nested, users?: Array User, strict?: Strict, counts?: Counts, raw?: Raw, key?: Key, boxed?: GenRec, level?: Level, bits?: Bits }
