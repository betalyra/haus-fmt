// JSON import (spec §16.1), without a schema: reading `json` gives `output`.
// Nothing in the data is special: `_tag` and the envelope are record keys.
Read { json: "{\"a\": 1, \"b\": [true, false, null], \"c\": \"x\"}", output: { a: 1, b: [True, False, None], c: "x" } },
Read { json: "1E+05", output: 1e5 },
Read { json: "-0", output: -0 },
Read { json: "19.90", output: 19.90 },
Read { json: "\"\\ud83d\\ude00\"", output: "\u{1F600}" },
Err { json: "{\"a\": 1, \"a\": 2}", code: "duplicate-key" },
Err { json: "\"\\ud83d\"", code: "unpaired-surrogate" },
// A \u after a high surrogate needs its four hex digits like any other.
Err { json: "\"\\ud83d\\u\"", code: "invalid-unicode-escape" },
Err { json: "[1,]", code: "json-syntax" },
Err { json: "NaN", code: "json-syntax" },
Read { json: "\u{FEFF}[1]", output: [1] },
Read { json: "{\"_tag\": \"Circle\", \"r\": 1}", output: { _tag: "Circle", r: 1 } },
Read { json: "{\"_haus\": 1, \"_value\": {\"_num\": \"1\"}}", output: { _haus: 1, _value: { _num: "1" } } },
Read { json: "\"a\u{7F}\u{85}\u{202E}b\"", output: "a\u{7F}\u{85}\u{202E}b" },

// ── the number limits apply to JSON number tokens as written (§16) ──
Err { json: "1e-7000", code: "exponent-too-large" },
Err { json: "[1, -2E+6145]", code: "exponent-too-large" },
Read { json: "1e-6144", output: 1e-6144 },

// ── readers accept raw U+2028 and U+2029 in strings (§16) ──
Read { json: "\"a\u{2028}b\u{2029}c\"", output: "a\u{2028}b\u{2029}c" },

// ── the import's JSON nesting is limited to the depth limit d (§16): 257 arrays ──
Err { json: "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]", code: "nesting-too-deep" },
