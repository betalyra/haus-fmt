		}
		"Read" => read_as(ty, json, value(fields, "output")?)
		_ => {
			code = text(fields, "code")?
			match JsonValue.parse(json) {
				Ok(j) => match read(ty, j) {
					Ok(v) => Err("read as ${Encode.canonical(v)}")
