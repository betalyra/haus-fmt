		}
		_ => rejected(JsonValue.from_haus_json(json), text(fields, "code")?)
	}
}

import_case : Str, U64 -> Try({}, Str)
import_case = |cases, i| {
	(tag, fields) = case(cases, i)?
	json = text(fields, "json")?
	match (tag, JsonValue.import_json(json)) {
		("Read", Ok(v)) => {
