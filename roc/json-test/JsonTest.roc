	"OptLoop" => written(SchemaBased.decode_opt_loop(v), SchemaBased.to_json_opt_loop)
	_ => Err("no type ${ty}")
}

## Read `j` with the type `ty` of schema-based.schema.haus, and encode the result.
read : Str, JsonValue -> Try(Value, Decode.Error)
read = |ty, j| match ty {
