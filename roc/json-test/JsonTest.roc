	"B" => SchemaBased.from_json_b(j).map_ok(SchemaBased.encode_b)
	"Flag" => SchemaBased.from_json_flag(j).map_ok(SchemaBased.encode_flag)
	"Small" => SchemaBased.from_json_small(j).map_ok(SchemaBased.encode_small)
