## Error codes (spec §17). Every error this binding reports has a `code`: a
## short name for the mistake, such as `payload-newline` or `missing-field`,
## the same in every binding. Messages (`reason`) are for people and may
## change; codes are for programs and are stable. The catalogue,
## spec/errors.haus, lists each with what it means and the usual fix.
##
## A parse error (`Value.ParseError`), a decode error (`Decode.Error`) and an
## encode error (`Encode.Error`) carry the code as a `Str`; this module has a
## constant for each (`ErrorCode.missing_comma`), the fix (`hint`), the
## documentation (`docs`), and the JSON form of an error (`json`).
##
##     match Value.parse_all("[1 2]") {
##         Err(e) => "${e.reason} (${e.code}): ${ErrorCode.hint(e.code)}"
##         # "expected ',' or ']', found '2' (missing-comma): Add a comma between the two values."
##         Ok(_) => "parsed"
##     }
ErrorCode := [].{
	# ── generated by roc/scripts/gen_error_codes.py from spec/errors.haus: don't edit ──

	## `invalid-utf8` (syntax): The input is not valid UTF-8 (§4): a byte sequence that encodes no character, an overlong form or a surrogate.
	invalid_utf8 : Str
	invalid_utf8 = "invalid-utf8"

	## `version-directive` (syntax): The file starts with a `#haus` version directive (§10): it was written for a later, incompatible version of haus.
	version_directive : Str
	version_directive = "version-directive"

	## `expected-value` (syntax): A value is missing: after a key's colon, between commas, or at the start of a file, something else comes where a value must be.
	expected_value : Str
	expected_value = "expected-value"

	## `missing-comma` (syntax): Two values, fields or top-level values follow each other without a comma between them.
	missing_comma : Str
	missing_comma = "missing-comma"

	## `payload-newline` (syntax): A tag is followed by `(` or `{` on a later line, or after a comment. A payload must start on the tag's line (§5), so the two are read as separate values, and a comma is missing between them.
	payload_newline : Str
	payload_newline = "payload-newline"

	## `unexpected-closer` (syntax): A closing bracket that doesn't match the open one, or that has no open one.
	unexpected_closer : Str
	unexpected_closer = "unexpected-closer"

	## `unclosed-bracket` (syntax): A `{`, `[` or `(` is never closed: the input ends first.
	unclosed_bracket : Str
	unclosed_bracket = "unclosed-bracket"

	## `null-literal` (syntax): `null` is not a value: haus has no null (§1).
	null_literal : Str
	null_literal = "null-literal"

	## `boolean-literal` (syntax): `true` and `false` are not values: booleans are the tags `True` and `False` (§1).
	boolean_literal : Str
	boolean_literal = "boolean-literal"

	## `bare-identifier` (syntax): A lowercase word where a value should be. Lowercase identifiers are only record keys.
	bare_identifier : Str
	bare_identifier = "bare-identifier"

	## `expected-key` (syntax): Something that can't be a record key where a key should be, such as a number or a comma.
	expected_key : Str
	expected_key = "expected-key"

	## `uppercase-key` (syntax): A record key starts with a capital letter. Bare keys start with a lowercase letter or `_`; capitalized words are tags.
	uppercase_key : Str
	uppercase_key = "uppercase-key"

	## `block-string-key` (syntax): A block string (`"""`) is used as a record key.
	block_string_key : Str
	block_string_key = "block-string-key"

	## `missing-colon` (syntax): A record key is not followed by `:`.
	missing_colon : Str
	missing_colon = "missing-colon"

	## `duplicate-key` (syntax): A record has the same key twice, after escapes are read (`a` and `"a"` are the same key). Also a JSON object with the same member name twice (§16).
	duplicate_key : Str
	duplicate_key = "duplicate-key"

	## `empty-payload` (syntax): A tag with empty parentheses, `Tag()`. A tag without arguments is written without them.
	empty_payload : Str
	empty_payload = "empty-payload"

	## `invalid-number` (syntax): A number literal that doesn't follow the grammar (§3): a leading zero, a `+`, a `.` without digits on both sides, a misplaced `_`, an uppercase `0X`, digits followed by letters. Also a string that should hold a number literal and doesn't (a `Decimal` in schema-based JSON, §16.3).
	invalid_number : Str
	invalid_number = "invalid-number"

	## `unterminated-string` (syntax): A string has no closing `"` (in haus or JSON).
	unterminated_string : Str
	unterminated_string = "unterminated-string"

	## `string-line-break` (syntax): A raw line break inside a `"…"` string.
	string_line_break : Str
	string_line_break = "string-line-break"

	## `control-character` (syntax): A raw control character (C0, DEL, C1) in a string, block string or comment, where it could change what a terminal shows. A raw tab is allowed in block strings and comments, not in `"…"` strings. Also a raw control character in a JSON string: C0 in any JSON, DEL and C1 in self-describing JSON (§16).
	control_character : Str
	control_character = "control-character"

	## `bidi-control` (syntax): A raw bidirectional control character (U+202A–U+202E, U+2066–U+2069) in a string or comment, or in a self-describing JSON string (§16), where it could reorder how the text is displayed ("Trojan Source", §9).
	bidi_control : Str
	bidi_control = "bidi-control"

	## `invalid-escape` (syntax): A backslash followed by a character that doesn't start an escape. haus has `\"`, `\\`, `\n`, `\r`, `\t` and `\u{…}`; JSON has its own set.
	invalid_escape : Str
	invalid_escape = "invalid-escape"

	## `invalid-unicode-escape` (syntax): A `\u` escape that isn't `\u{` 1 to 6 hex digits `}`, or names no Unicode scalar value (a surrogate, or above 10FFFF). In JSON: `\u` not followed by four hex digits.
	invalid_unicode_escape : Str
	invalid_unicode_escape = "invalid-unicode-escape"

	## `block-string-opening` (syntax): Text after the opening `"""` of a block string. The content starts on the next line.
	block_string_opening : Str
	block_string_opening = "block-string-opening"

	## `block-string-closing` (syntax): The closing `"""` of a block string has text before it on its line.
	block_string_closing : Str
	block_string_closing = "block-string-closing"

	## `block-string-indent` (syntax): A line of a block string is indented less than the closing `"""`, whose indentation every line must start with.
	block_string_indent : Str
	block_string_indent = "block-string-indent"

	## `unterminated-block-string` (syntax): A block string has no closing `"""`.
	unterminated_block_string : Str
	unterminated_block_string = "unterminated-block-string"

	## `unterminated-bytes` (syntax): A byte string `x"…` has no closing `"`.
	unterminated_bytes : Str
	unterminated_bytes = "unterminated-bytes"

	## `bytes-not-hex` (syntax): A byte string holds something other than hex digits, spaces and tabs, such as a letter after `f`, an escape or a line break.
	bytes_not_hex : Str
	bytes_not_hex = "bytes-not-hex"

	## `bytes-odd-digits` (syntax): A byte in a byte string has only one hex digit: an odd number of digits, or a space inside a byte.
	bytes_odd_digits : Str
	bytes_odd_digits = "bytes-odd-digits"

	## `lone-carriage-return` (syntax): A carriage return (CR) not followed by a line feed. Line breaks are LF or CRLF.
	lone_carriage_return : Str
	lone_carriage_return = "lone-carriage-return"

	## `unterminated-comment` (syntax): A `/*` comment is never closed. Block comments nest, so each `/*` needs its own `*/`.
	unterminated_comment : Str
	unterminated_comment = "unterminated-comment"

	## `stray-slash` (syntax): A `/` that doesn't start a comment. Comments are `//` and `/* */`; haus has no operators.
	stray_slash : Str
	stray_slash = "stray-slash"

	## `nesting-too-deep` (limits): Records, arrays and payloads are nested deeper than the depth limit (default 256). In JSON, deeper than its JSON limit (§16).
	nesting_too_deep : Str
	nesting_too_deep = "nesting-too-deep"

	## `number-too-long` (limits): A number literal has more characters than the limit (default 1000), or a hex literal more hex digits than the number limit allows (default 829), so that every integer fits the limit in decimal (§7).
	number_too_long : Str
	number_too_long = "number-too-long"

	## `exponent-too-large` (limits): A number's exponent is larger than the limit (default 6144), in either direction.
	exponent_too_large : Str
	exponent_too_large = "exponent-too-large"

	## `string-too-long` (limits): A string or byte string has more characters than the limit (default 16 Mi).
	string_too_long : Str
	string_too_long = "string-too-long"

	## `key-too-long` (limits): A record key has more characters than the string limit (default 16 Mi).
	key_too_long : Str
	key_too_long = "key-too-long"

	## `tag-too-long` (limits): A tag has more characters than the string limit (default 16 Mi).
	tag_too_long : Str
	tag_too_long = "tag-too-long"

	## `value-too-long` (limits): One top-level value of a stream (or one line of JSON Lines) has more characters than the limit (default 64 Mi).
	value_too_long : Str
	value_too_long = "value-too-long"

	## `unsupported-depth` (limits): The configured depth limit is above the deepest nesting the binding supports, or isn't a whole number (§7). Raised when the limits are set, not by any input.
	unsupported_depth : Str
	unsupported_depth = "unsupported-depth"

	## `not-one-value` (streams): One value was expected (a single document, a type that isn't a `Stream`), and the input holds none or several.
	not_one_value : Str
	not_one_value = "not-one-value"

	## `stream-truncated` (streams): In strict mode, a stream ended without a comma (or, in JSON Lines, a line feed) after its last value, so the last value may be cut off (§6).
	stream_truncated : Str
	stream_truncated = "stream-truncated"

	## `schema-syntax` (schema-files): A schema file doesn't follow the grammar: an unexpected token, a character that has no place there. Mistakes in the comments, whitespace and strings a schema file shares with data files (§14) have the codes they have there: `unterminated-string`, `unterminated-comment`, `lone-carriage-return`, `control-character`, `bidi-control`, `invalid-utf8`, `invalid-escape`.
	schema_syntax : Str
	schema_syntax = "schema-syntax"

	## `unknown-type` (schema-files): A type name that is neither defined in the file, imported, nor a prelude type. A type a standard module or official extension has needs its import.
	unknown_type : Str
	unknown_type = "unknown-type"

	## `wrong-arity` (schema-files): A type is used with the wrong number of arguments: `Array` without its element type, `Int` with one, a generic type of your own with too few or too many.
	wrong_arity : Str
	wrong_arity = "wrong-arity"

	## `duplicate-type` (schema-files): Two definitions of the same type name, or a definition with the name of an imported type.
	duplicate_type : Str
	duplicate_type = "duplicate-type"

	## `redefine-prelude` (schema-files): A definition with the name of a prelude type (`Int`, `Any`, `Secret`, `Maybe`, …), which schemas can't redefine.
	redefine_prelude : Str
	redefine_prelude = "redefine-prelude"

	## `unknown-parameter` (schema-files): A lowercase name in a type that is not a parameter of the definition.
	unknown_parameter : Str
	unknown_parameter = "unknown-parameter"

	## `invalid-parameter` (schema-files): A type parameter starting with `_`, or the same parameter twice in one definition.
	invalid_parameter : Str
	invalid_parameter = "invalid-parameter"

	## `underscore-type` (schema-files): `_` used as a type. Types are open by default, so there is no wildcard.
	underscore_type : Str
	underscore_type = "underscore-type"

	## `duplicate-field` (schema-files): A record type lists the same field twice, also one copied in by a spread.
	duplicate_field : Str
	duplicate_field = "duplicate-field"

	## `duplicate-tag` (schema-files): A variant type lists the same tag twice, also one copied in by a spread.
	duplicate_tag : Str
	duplicate_tag = "duplicate-tag"

	## `closed-empty-variant` (schema-files): `closed < >`: a closed variant without tags accepts nothing.
	closed_empty_variant : Str
	closed_empty_variant = "closed-empty-variant"

	## `invalid-spread` (schema-files): A spread of something that can't be spread: not a named type, a type with parameters, a `Stream`, or a record spread into a variant (or a variant into a record).
	invalid_spread : Str
	invalid_spread = "invalid-spread"

	## `spread-cycle` (schema-files): A type spreads itself, directly or through other types.
	spread_cycle : Str
	spread_cycle = "spread-cycle"

	## `row-parameter` (schema-files): A spread of a parameter, `...r`. Row parameters are not part of the language.
	row_parameter : Str
	row_parameter = "row-parameter"

	## `misplaced-stream` (schema-files): `Stream` used anywhere but as the whole type of a definition, or a reference to such a definition. A stream is a whole file.
	misplaced_stream : Str
	misplaced_stream = "misplaced-stream"

	## `unguarded-recursion` (schema-files): A type refers to itself without a record field, array element or variant payload in between (§9.9), so decoding it would consume no input. `Secret` and names don't count as a step.
	unguarded_recursion : Str
	unguarded_recursion = "unguarded-recursion"

	## `growing-recursion` (schema-files): Generic types whose instances could grow without bound: a type parameter passes, wrapped in a bigger type, along a cycle of references back to itself (`type T a = < X (T (Pair a a)) >`, §9.10).
	growing_recursion : Str
	growing_recursion = "growing-recursion"

	## `type-too-deep` (schema-files): Type expressions are nested deeper than the schema parser's limit.
	type_too_deep : Str
	type_too_deep = "type-too-deep"

	## `attribute-arguments` (schema-files): An attribute this version defines, given arguments it doesn't take: `@deprecated` takes nothing or one string. Also empty parentheses after an attribute.
	attribute_arguments : Str
	attribute_arguments = "attribute-arguments"

	## `attribute-twice` (schema-files): The same attribute twice on one type, field or tag.
	attribute_twice : Str
	attribute_twice = "attribute-twice"

	## `attribute-space` (schema-files): A space between an attribute's name and its `(`.
	attribute_space : Str
	attribute_space = "attribute-space"

	## `attribute-on-spread` (schema-files): An attribute on a spread. The fields and tags a spread copies keep their own attributes.
	attribute_on_spread : Str
	attribute_on_spread = "attribute-on-spread"

	## `unknown-module` (imports): An import of a module that doesn't exist: an unknown standard module, a former standard module, or a name that is neither `std/…`, a package `@org/name` nor a file `./name`.
	unknown_module : Str
	unknown_module = "unknown-module"

	## `unknown-import` (imports): An import names a type the module doesn't have, or no type at all.
	unknown_import : Str
	unknown_import = "unknown-import"

	## `duplicate-import` (imports): The same type name is imported twice.
	duplicate_import : Str
	duplicate_import = "duplicate-import"

	## `import-unavailable` (imports): The schema imports a package or file, and the tool reading it has no way to find one (no module resolver): only standard modules can be imported there.
	import_unavailable : Str
	import_unavailable = "import-unavailable"

	## `import-not-found` (imports): An imported package or file can't be found: it is not installed, the path is wrong, or the package found names another package in its manifest.
	import_not_found : Str
	import_not_found = "import-not-found"

	## `import-version` (imports): An import asks for a major version (`@org/name@2`) and another one is installed, or names something other than a major version: `@1.1`, `@1.1.0`, `@01`, `@x`.
	import_version : Str
	import_version = "import-version"

	## `import-cycle` (imports): Schema files import each other in a cycle.
	import_cycle : Str
	import_cycle = "import-cycle"

	## `duplicate-package` (imports): One schema reaches two different packages with the same name: two versions of one package (also two major versions), two copies of one version whose files differ, or two packages that call themselves the same. Byte-identical copies are one package.
	duplicate_package : Str
	duplicate_package = "duplicate-package"

	## `undeclared-package` (imports): A file imports a package that its package or project doesn't declare as a dependency (with npm: in the package's own `package.json`, or the nearest one above an application file), or a file with no `package.json` above it imports a package that wasn't given explicitly. A package found only because the package manager placed it nearby, such as a hoisted dependency of a dependency, could be replaced by another one placed there. Checked before the package is looked for.
	undeclared_package : Str
	undeclared_package = "undeclared-package"

	## `package-manifest` (imports): A package's `package.haus` is not a valid manifest: not one record, a `name` that isn't a lowercase `@org/name` (or has the part `node_modules`), a `version` that isn't a semantic version, or more than 64 KiB.
	package_manifest : Str
	package_manifest = "package-manifest"

	## `package-version` (imports): A package's `package.haus` has another version than the package manager gives the package (the `version` of its `package.json`, its Cargo version). A check implementations SHOULD make (§13.3).
	package_version : Str
	package_version = "package-version"

	## `package-path` (imports): A schema package refers to a file it may not: its `schema.haus` imports a file (`import ./x`) instead of a package; its `package.haus`, `schema.haus` or `package.json` is a symbolic link or not a regular file; or a file outside any package imports a file in a package's directory (`import ./node_modules/x/y`). The file is not read.
	package_path : Str
	package_path = "package-path"

	## `package-name` (imports): A package manager's name for a schema package differs from its manifest's: the `name` of its `package.json` isn't the `name` of its `package.haus`. On npm, imports find a package by that name, so it must be the manifest's (§13.3). Reported by package checks such as `haus package check`.
	package_name : Str
	package_name = "package-name"

	## `package-crate` (imports): A schema package's crate can't be named by the code generated for crates that use its types: its `links` is missing or isn't its library's name (`[lib] name`), or a crate depends on a schema package's crate under another name (`package = …`). Generated code names a schema package's crate by its `links`, which is its library's name. Reported by package checks such as `haus package check`.
	package_crate : Str
	package_crate = "package-crate"

	## `package-install-script` (imports): A schema package runs code when it is installed: an npm `preinstall`, `install` or `postinstall` script, or a `binding.gyp`, for which npm runs node-gyp. A schema package is data and MUST NOT need code to install (§13.3).
	package_install_script : Str
	package_install_script = "package-install-script"

	## `package-files` (imports): A package manager's configuration doesn't ship a file of the schema package: `package.haus`, `schema.haus`, or a profile's vectors or rule. Read from the configuration (`files` of `package.json`, `include` of `Cargo.toml`, a wheel's build configuration), without packing anything.
	package_files : Str
	package_files = "package-files"

	## `profile-vectors` (imports): A profile of a schema package is malformed (§13.3): it has no rule (`profiles/<name>.md`) next to its vectors; a vector isn't `Accept { type, value, output?, note? }` or `Reject { type, value, note? }` with string fields and no others (only an `Accept` has an `output`); its `type` isn't a type of the package without parameters; its `value` or `output` isn't one haus value; or an accepted value or its output isn't valid for its type, which a codec running after the schema can't accept. Also a profile name that isn't lowercase, and a vectors file with no vectors.
	profile_vectors : Str
	profile_vectors = "profile-vectors"

	## `package-wrapper` (imports): A package manager's file of a schema package can't be read as one: a `package.json` that isn't a JSON object or has no `name`, a `Cargo.toml` or `pyproject.toml` that isn't valid TOML, a `Cargo.toml` without `[package]`. Reported by package checks such as `haus package check`.
	package_wrapper : Str
	package_wrapper = "package-wrapper"

	## `codec-unreachable` (imports): A codec's type occurs where this binding can't apply the codec, such as the payload of a record case whose fields sit beside its tag in the host value. Decoding there with the default host type would silently differ from the other bindings (§13.4).
	codec_unreachable : Str
	codec_unreachable = "codec-unreachable"

	## `file-too-large` (imports): A schema file or a package's `package.json` is larger than the tool allows (1 MiB by default). It is not read.
	file_too_large : Str
	file_too_large = "file-too-large"

	## `too-many-files` (imports): A schema imports more schema files, directly or not, than the tool allows (256 by default, the root included), or a folder of packages has more entries than allowed (4096).
	too_many_files : Str
	too_many_files = "too-many-files"

	## `type-mismatch` (decoding): A value of another kind than the type accepts: a string for an `Int`, an array for a record, a tag that isn't `True` or `False` for a `Bool`. Decoders never convert between kinds (§15).
	type_mismatch : Str
	type_mismatch = "type-mismatch"

	## `not-an-integer` (decoding): A number with a fraction or an exponent where an integer type is expected. `1.0` and `1e3` are not whole numbers by spelling (§15).
	not_an_integer : Str
	not_an_integer = "not-an-integer"

	## `out-of-range` (decoding): A number outside the type's range: an `Int8` above 127, a negative `UInt32`, a float too large for `Float32`. Never wrapped or clamped.
	out_of_range : Str
	out_of_range = "out-of-range"

	## `missing-field` (decoding): A record lacks a field the type requires. Only fields with `?` may be missing; `None` is not missing.
	missing_field : Str
	missing_field = "missing-field"

	## `unknown-field` (decoding): A field a closed record doesn't list. Open records ignore such fields (see `unlisted-field`).
	unknown_field : Str
	unknown_field = "unknown-field"

	## `unknown-tag` (decoding): A tag a closed variant doesn't list. Open variants read it as an unknown value (see `unlisted-tag`).
	unknown_tag : Str
	unknown_tag = "unknown-tag"

	## `wrong-payload` (decoding): A listed tag with another payload than its case says: arguments for a tag without payload, the wrong number of arguments, a positional payload where a record is expected, such as `Circle(1.5)` for the case `Circle { r: Float64 }` (§15).
	wrong_payload : Str
	wrong_payload = "wrong-payload"

	## `invalid-time` (decoding): A std/time value whose text the std/time profile rejects: a day that doesn't exist, a missing offset, a lowercase `t` (spec/std/time.md).
	invalid_time : Str
	invalid_time = "invalid-time"

	## `invalid-secret` (decoding): A value of a `Secret` type that its type doesn't accept, when decoding, or that can't be written, when encoding. The error names the place and the type only, never the value or why it failed (§15).
	invalid_secret : Str
	invalid_secret = "invalid-secret"

	## `cannot-encode` (decoding): Encoding: a value of the program's language that the type can't write, such as a JavaScript number for an `Int` that expects a bigint, or a string that is no valid `Date`.
	cannot_encode : Str
	cannot_encode = "cannot-encode"

	## `cyclic-value` (decoding): Encoding: a value contains itself, so it has no finite text.
	cyclic_value : Str
	cyclic_value = "cyclic-value"

	## `step-budget` (decoding): Decoding or encoding took more steps than the input justifies, a sign of a schema doing unbounded work. Bindings MUST bound the work of one decode (§9.8).
	step_budget : Str
	step_budget = "step-budget"

	## `too-many-nodes` (decoding): A value built in code (not parsed) has more nodes than the call allows, or shares nodes so much that it would expand beyond the limits.
	too_many_nodes : Str
	too_many_nodes = "too-many-nodes"

	## `json-syntax` (json): Text that isn't JSON (RFC 8259): a missing comma or colon, an unquoted name, a trailing comma, a comment, text after the value. Also an empty line in JSON Lines, or a byte order mark at the start of a line after the first.
	json_syntax : Str
	json_syntax = "json-syntax"

	## `unpaired-surrogate` (json): A JSON string with half of a UTF-16 surrogate pair, raw or as `\uD800`. I-JSON forbids them, and they are no Unicode characters (§16).
	unpaired_surrogate : Str
	unpaired_surrogate = "unpaired-surrogate"

	## `haus-json-form` (json): JSON that isn't self-describing JSON (§16.2): a text without the envelope `{"_haus": 1, "_value": …}`, an envelope with other members, a bare number, `true`, `null`, an object with other members, a `_rec` that isn't an object, an `_args` that isn't a non-empty array.
	haus_json_form : Str
	haus_json_form = "haus-json-form"

	## `haus-json-version` (json): A self-describing JSON envelope whose `_haus` isn't 1, the only version of the form (§16.2): it was written for a later version of haus, or isn't haus.
	haus_json_version : Str
	haus_json_version = "haus-json-version"

	## `haus-json-number` (json): A self-describing `_num` that isn't a normalized number literal (§2): `"1E5"`, `"01"`, `"0xff"`, or not a string.
	haus_json_number : Str
	haus_json_number = "haus-json-number"

	## `haus-json-bytes` (json): A self-describing `_bytes` that isn't two lowercase hex digits per byte.
	haus_json_bytes : Str
	haus_json_bytes = "haus-json-bytes"

	## `invalid-tag` (json): A tag name that isn't `[A-Z][A-Za-z0-9_]*`, or a `"_tag"` that isn't a string: in a `_tag` of either JSON form, in the string of a closed variant whose tags have no payload in schema-based JSON (`"debug"`, §16.3), or in a value built in code.
	invalid_tag : Str
	invalid_tag = "invalid-tag"

	## `invalid-base64` (json): Schema-based JSON `Bytes` that aren't canonical base64 with padding (RFC 4648 §4): whitespace, the URL alphabet, missing padding, non-zero pad bits.
	invalid_base64 : Str
	invalid_base64 = "invalid-base64"

	## `missing-member` (json): Schema-based JSON: an object lacks a member its form needs, such as `"_tag"` for a variant or `"value"` for a tag with one argument.
	missing_member : Str
	missing_member = "missing-member"

	## `unexpected-member` (json): Schema-based JSON: an object has a member its form doesn't have, such as `"value"` next to a tag without payload (§16.3).
	unexpected_member : Str
	unexpected_member = "unexpected-member"

	## `no-json-form` (json): A value or type that has no JSON form: a string with an unpaired surrogate, a record payload with a field named `_tag` or `_args` in schema-based JSON (§16.3), a type with no schema-based form.
	no_json_form : Str
	no_json_form = "no-json-form"

	## `unknown-attribute` (hints): A warning: an attribute this version of haus doesn't define. It is accepted and has no meaning (§14).
	unknown_attribute : Str
	unknown_attribute = "unknown-attribute"

	## `deprecated` (hints): A hint: the schema or the data uses a type, field or tag marked `@deprecated` (§14).
	deprecated : Str
	deprecated = "deprecated"

	## `unlisted-field` (hints): A hint: a field an open record doesn't list. A reader ignores it, but it may be a typo.
	unlisted_field : Str
	unlisted_field = "unlisted-field"

	## `unlisted-tag` (hints): A hint: a tag an open variant doesn't list. A reader keeps it as an unknown value, but it may be a typo.
	unlisted_tag : Str
	unlisted_tag = "unlisted-tag"

	## Every code, in the catalogue's order.
	all : List(Str)
	all = ["invalid-utf8", "version-directive", "expected-value", "missing-comma", "payload-newline", "unexpected-closer", "unclosed-bracket", "null-literal", "boolean-literal", "bare-identifier", "expected-key", "uppercase-key", "block-string-key", "missing-colon", "duplicate-key", "empty-payload", "invalid-number", "unterminated-string", "string-line-break", "control-character", "bidi-control", "invalid-escape", "invalid-unicode-escape", "block-string-opening", "block-string-closing", "block-string-indent", "unterminated-block-string", "unterminated-bytes", "bytes-not-hex", "bytes-odd-digits", "lone-carriage-return", "unterminated-comment", "stray-slash", "nesting-too-deep", "number-too-long", "exponent-too-large", "string-too-long", "key-too-long", "tag-too-long", "value-too-long", "unsupported-depth", "not-one-value", "stream-truncated", "schema-syntax", "unknown-type", "wrong-arity", "duplicate-type", "redefine-prelude", "unknown-parameter", "invalid-parameter", "underscore-type", "duplicate-field", "duplicate-tag", "closed-empty-variant", "invalid-spread", "spread-cycle", "row-parameter", "misplaced-stream", "unguarded-recursion", "growing-recursion", "type-too-deep", "attribute-arguments", "attribute-twice", "attribute-space", "attribute-on-spread", "unknown-module", "unknown-import", "duplicate-import", "import-unavailable", "import-not-found", "import-version", "import-cycle", "duplicate-package", "undeclared-package", "package-manifest", "package-version", "package-path", "package-name", "package-crate", "package-install-script", "package-files", "profile-vectors", "package-wrapper", "codec-unreachable", "file-too-large", "too-many-files", "type-mismatch", "not-an-integer", "out-of-range", "missing-field", "unknown-field", "unknown-tag", "wrong-payload", "invalid-time", "invalid-secret", "cannot-encode", "cyclic-value", "step-budget", "too-many-nodes", "json-syntax", "unpaired-surrogate", "haus-json-form", "haus-json-version", "haus-json-number", "haus-json-bytes", "invalid-tag", "invalid-base64", "missing-member", "unexpected-member", "no-json-form", "unknown-attribute", "deprecated", "unlisted-field", "unlisted-tag"]

	## The catalogue's fix for a code, which errors report as their hint:
	## `ErrorCode.hint("missing-comma")` is "Add a comma between the two values.".
	## Empty for a text that isn't a code.
	hint : Str -> Str
	hint = |code| match code {
		"invalid-utf8" => "Save the file as UTF-8."
		"version-directive" => "Read the file with a version of haus that supports it."
		"expected-value" => "Write a value here, or remove the extra comma or bracket."
		"missing-comma" => "Add a comma between the two values."
		"payload-newline" => "Put the payload on the tag's line, or add a comma if they are two values."
		"unexpected-closer" => "Close each bracket with its own kind (`{` `}`, `[` `]`, `(` `)`) and remove extra closing brackets."
		"unclosed-bracket" => "Add the closing bracket."
		"null-literal" => "Write `None` (with a `Maybe` type), or leave the field out."
		"boolean-literal" => "Write `True` or `False`."
		"bare-identifier" => "Quote it as a string, or start it with a capital letter to make it a tag."
		"expected-key" => "Write a key: a lowercase identifier or a string."
		"uppercase-key" => "Quote the key, or start it with a lowercase letter."
		"block-string-key" => "Write the key as a basic string, `\"…\"`."
		"missing-colon" => "Add `:` between the key and its value."
		"duplicate-key" => "Remove or rename one of the two."
		"empty-payload" => "Remove the empty parentheses after the tag."
		"invalid-number" => "Write a decimal number (optional `-`, fraction and exponent) or a hex or binary integer, with `_` only between digits."
		"unterminated-string" => "Add the closing quote. A quote inside the string is written `\\\"`."
		"string-line-break" => "Write the line break as `\\n`, or use a `\"\"\"` block string."
		"control-character" => "Write the character as an escape, `\\u{…}`."
		"bidi-control" => "Write it as an escape (`\\u{…}`) inside a string, or remove it."
		"invalid-escape" => "Use one of the escapes of §4, or write `\\\\` for a backslash."
		"invalid-unicode-escape" => "Write the escape with braces, `\\u{…}`, for a character from U+0000 to U+10FFFF other than a surrogate."
		"block-string-opening" => "Start the content on the line after `\"\"\"`."
		"block-string-closing" => "Put the closing `\"\"\"` on its own line; its indentation is removed from every line."
		"block-string-indent" => "Indent every line at least as far as the closing `\"\"\"`."
		"unterminated-block-string" => "Add the closing `\"\"\"` on its own line."
		"unterminated-bytes" => "Add the closing quote."
		"bytes-not-hex" => "Write two hex digits per byte, on one line."
		"bytes-odd-digits" => "Write each byte as two hex digits."
		"lone-carriage-return" => "Save the file with LF or CRLF line endings."
		"unterminated-comment" => "Add `*/`, one for each `/*`."
		"stray-slash" => "Write `//` or `/*` for a comment, or remove the `/`."
		"nesting-too-deep" => "Flatten the data, or raise the depth limit if you trust the input."
		"number-too-long" => "Write a shorter number (a `String` or `Bytes` for very long data), or raise the number length limit."
		"exponent-too-large" => "Write a number with a smaller exponent, or raise the exponent limit."
		"string-too-long" => "Split the string, or raise the string length limit."
		"key-too-long" => "Use a shorter key, or raise the string length limit."
		"tag-too-long" => "Use a shorter tag, or raise the string length limit."
		"value-too-long" => "Send smaller values, or raise the value length limit."
		"unsupported-depth" => "Configure a depth limit within the binding's documented maximum."
		"not-one-value" => "Give exactly one value, or read the input as a stream."
		"stream-truncated" => "End every value with a comma, or check that the stream wasn't cut off."
		"schema-syntax" => "Write it as the grammar says (grammar.ebnf); the message names what was expected."
		"unknown-type" => "Define the type, fix its spelling, or import it from the module that defines it."
		"wrong-arity" => "Give the type exactly as many arguments as it has parameters."
		"duplicate-type" => "Rename one of them."
		"redefine-prelude" => "Give your type another name."
		"unknown-parameter" => "Declare the parameter after the type's name, or use a type name."
		"invalid-parameter" => "Give each parameter its own lowercase name."
		"underscore-type" => "Write `< >` for a variant with any tags, `Any` for any value, or use a type parameter."
		"duplicate-field" => "Remove or rename one of them."
		"duplicate-tag" => "Remove or rename one of them."
		"closed-empty-variant" => "List its tags, or write `< >` for a variant with any tags."
		"invalid-spread" => "Spread a named variant into a variant, or a named record into a record, without parameters."
		"spread-cycle" => "Break the cycle: let one of the types list its tags or fields itself."
		"row-parameter" => "Spread a named type instead, or nest the open part as a field with a type parameter."
		"misplaced-stream" => "Use `Array` inside types, and `Stream` only as the whole of a definition."
		"unguarded-recursion" => "Put the recursion inside a record field, array element or variant payload."
		"growing-recursion" => "Refer to the type inside itself with exactly its own parameters."
		"type-too-deep" => "Name the inner types with definitions of their own."
		"attribute-arguments" => "Give the attribute only the arguments it takes: `@deprecated` takes none, or one string."
		"attribute-twice" => "Keep one of them."
		"attribute-space" => "Write the parenthesis right after the attribute's name, without a space."
		"attribute-on-spread" => "Put the attribute on the fields or tags in the spread type."
		"unknown-module" => "Fix the module's name; a former standard module is now a package, which the message names."
		"unknown-import" => "Import a type the module defines; the message lists them."
		"duplicate-import" => "Import each name once."
		"import-unavailable" => "Read the schema with a resolver that loads imports (from files or packages), or inline the types."
		"import-not-found" => "Install the package, or fix the path."
		"import-version" => "Install the major version the schema asks for, or update the import. An import names only the major version (`@1`); the minimum minor goes in your package manager's dependency range."
		"import-cycle" => "Move the shared types to a file both import."
		"duplicate-package" => "Install one copy of the package: align the version ranges and deduplicate (`npm dedupe`). On npm, declare schema packages a package imports as `peerDependencies`."
		"undeclared-package" => "Add the package to the dependencies of the importing package or project (on npm, `peerDependencies` for a package). Outside an npm project, such as in a Cargo or Python project, give the package explicitly (`--package`, `--packages`, the editor's `haus.packages`, Python's `packages=`)."
		"package-manifest" => "Write `{ name: \"@org/name\", version: \"1.2.0\" }`, in lowercase, with a full version."
		"package-version" => "Release both with the same version: change them together."
		"package-path" => "A package is its `package.haus` and one `schema.haus`, and imports other packages by name (`import @org/name`); import a package by name from your own files too."
		"package-name" => "Publish the package under its manifest's name: make the `name` of `package.json` the same."
		"package-crate" => "Set `links` to the library's name in `[package]`, and depend on schema package crates under their own names."
		"package-install-script" => "Remove the script: a schema package is its manifest, its schema and its profiles, and needs nothing run."
		"package-files" => "List `package.haus`, `schema.haus` and `profiles` in what the package manager ships."
		"profile-vectors" => "Write the rule in `profiles/<name>.md`, and each vector as `Accept { type: \"T\", value: \"…\" }` or `Reject { type: \"T\", value: \"…\" }`, with values valid for `T`."
		"package-wrapper" => "Fix the file so that its package manager can read it."
		"codec-unreachable" => "Give the codec's type a place of its own (a field), or decode the outer type yourself; the message names where the type occurs."
		"file-too-large" => "Split the schema into several files, or raise the limit if you trust the file."
		"too-many-files" => "Import fewer files."
		"type-mismatch" => "Write a value of the expected type; the message says which."
		"not-an-integer" => "Write the integer without a fraction or exponent."
		"out-of-range" => "Write a value within the range, or use a larger type (`Int`, `Float64`, `Decimal`)."
		"missing-field" => "Add the field, or mark it optional in the schema with `?` after its name."
		"unknown-field" => "Remove the field, fix its spelling, or add it to the schema."
		"unknown-tag" => "Use one of the variant's tags, fix the spelling, or add the tag to the schema."
		"wrong-payload" => "Write the payload the schema gives the tag: none, one record, or its positional arguments; the message says which."
		"invalid-time" => "Write the date or time as the std/time profile says (spec/std/time.md); the message names the type."
		"invalid-secret" => "Write a value of the secret's type; the value isn't shown, so check it where it comes from."
		"cannot-encode" => "Pass a value of the host type the binding documents for the type."
		"cyclic-value" => "Break the cycle before encoding."
		"step-budget" => "Simplify the schema, or raise the step limit if the work is expected."
		"too-many-nodes" => "Build a smaller value, or raise the limit."
		"json-syntax" => "Write valid JSON; the message says what was expected."
		"unpaired-surrogate" => "Write both halves of the surrogate pair, or the character itself."
		"haus-json-form" => "Write the envelope with one of the forms of §16.2 in `_value`: a string, an array, or an object with `_num`, `_bytes`, `_rec`, or `_tag` (and `_args`). For ordinary JSON, read it with a schema or import it instead."
		"haus-json-version" => "Read it with a newer version of haus, or write `\"_haus\": 1`."
		"haus-json-number" => "Write the number's normalized literal (§2) as a string."
		"haus-json-bytes" => "Write the bytes as lowercase hex, two digits per byte."
		"invalid-tag" => "Start the tag with a capital letter and use only letters, digits and `_`."
		"invalid-base64" => "Write standard base64, with padding."
		"missing-member" => "Add the member the message names."
		"unexpected-member" => "Remove the member."
		"no-json-form" => "Rename the field, or use self-describing JSON."
		"unknown-attribute" => "Check the spelling; attributes of a later version are fine."
		"deprecated" => "Use what the deprecation note says instead."
		"unlisted-field" => "Fix the spelling, add the field to the schema, or leave it if it is meant for newer readers."
		"unlisted-tag" => "Fix the spelling, add the tag to the schema, or leave it if it is meant for newer readers."
		_ => ""
	}

	## The catalogue's category of a code: `syntax`, `limits`, `streams`,
	## `schema-files`, `imports`, `decoding`, `json` or `hints`. Empty for a
	## text that isn't a code.
	category : Str -> Str
	category = |code| match code {
		"invalid-utf8" => "syntax"
		"version-directive" => "syntax"
		"expected-value" => "syntax"
		"missing-comma" => "syntax"
		"payload-newline" => "syntax"
		"unexpected-closer" => "syntax"
		"unclosed-bracket" => "syntax"
		"null-literal" => "syntax"
		"boolean-literal" => "syntax"
		"bare-identifier" => "syntax"
		"expected-key" => "syntax"
		"uppercase-key" => "syntax"
		"block-string-key" => "syntax"
		"missing-colon" => "syntax"
		"duplicate-key" => "syntax"
		"empty-payload" => "syntax"
		"invalid-number" => "syntax"
		"unterminated-string" => "syntax"
		"string-line-break" => "syntax"
		"control-character" => "syntax"
		"bidi-control" => "syntax"
		"invalid-escape" => "syntax"
		"invalid-unicode-escape" => "syntax"
		"block-string-opening" => "syntax"
		"block-string-closing" => "syntax"
		"block-string-indent" => "syntax"
		"unterminated-block-string" => "syntax"
		"unterminated-bytes" => "syntax"
		"bytes-not-hex" => "syntax"
		"bytes-odd-digits" => "syntax"
		"lone-carriage-return" => "syntax"
		"unterminated-comment" => "syntax"
		"stray-slash" => "syntax"
		"nesting-too-deep" => "limits"
		"number-too-long" => "limits"
		"exponent-too-large" => "limits"
		"string-too-long" => "limits"
		"key-too-long" => "limits"
		"tag-too-long" => "limits"
		"value-too-long" => "limits"
		"unsupported-depth" => "limits"
		"not-one-value" => "streams"
		"stream-truncated" => "streams"
		"schema-syntax" => "schema-files"
		"unknown-type" => "schema-files"
		"wrong-arity" => "schema-files"
		"duplicate-type" => "schema-files"
		"redefine-prelude" => "schema-files"
		"unknown-parameter" => "schema-files"
		"invalid-parameter" => "schema-files"
		"underscore-type" => "schema-files"
		"duplicate-field" => "schema-files"
		"duplicate-tag" => "schema-files"
		"closed-empty-variant" => "schema-files"
		"invalid-spread" => "schema-files"
		"spread-cycle" => "schema-files"
		"row-parameter" => "schema-files"
		"misplaced-stream" => "schema-files"
		"unguarded-recursion" => "schema-files"
		"growing-recursion" => "schema-files"
		"type-too-deep" => "schema-files"
		"attribute-arguments" => "schema-files"
		"attribute-twice" => "schema-files"
		"attribute-space" => "schema-files"
		"attribute-on-spread" => "schema-files"
		"unknown-module" => "imports"
		"unknown-import" => "imports"
		"duplicate-import" => "imports"
		"import-unavailable" => "imports"
		"import-not-found" => "imports"
		"import-version" => "imports"
		"import-cycle" => "imports"
		"duplicate-package" => "imports"
		"undeclared-package" => "imports"
		"package-manifest" => "imports"
		"package-version" => "imports"
		"package-path" => "imports"
		"package-name" => "imports"
		"package-crate" => "imports"
		"package-install-script" => "imports"
		"package-files" => "imports"
		"profile-vectors" => "imports"
		"package-wrapper" => "imports"
		"codec-unreachable" => "imports"
		"file-too-large" => "imports"
		"too-many-files" => "imports"
		"type-mismatch" => "decoding"
		"not-an-integer" => "decoding"
		"out-of-range" => "decoding"
