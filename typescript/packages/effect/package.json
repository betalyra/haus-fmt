{
  "name": "@haus-fmt/effect",
  "version": "0.1.0",
  "description": "Decode haus data with Effect schemas",
  "keywords": [
    "haus",
    "data-format",
    "effect",
    "schema",
    "parser"
  ],
  "license": "MIT",
  "homepage": "https://haus-fmt.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betalyra/haus-fmt.git",
    "directory": "typescript/packages/effect"
  },
  "bugs": "https://github.com/betalyra/haus-fmt/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "effect-tsgo tsc@7.0.2 -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@haus-fmt/haus": "workspace:^"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@effect/vitest": "4.0.6",
    "@types/node": "24.10.1",
    "effect": "4.0.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
