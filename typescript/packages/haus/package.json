{
  "name": "@haus-fmt/haus",
  "version": "0.1.0",
  "description": "The haus data format: parser, writer, values, schemas with packages, rules and codecs, Standard Schema support; no dependencies",
  "keywords": [
    "haus",
    "data-format",
    "parser",
    "serialization",
    "schema",
    "standard-schema"
  ],
  "license": "MIT",
  "homepage": "https://haus-fmt.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betalyra/haus-fmt.git",
    "directory": "typescript/packages/haus"
  },
  "bugs": "https://github.com/betalyra/haus-fmt/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/haus.d.ts",
      "default": "./dist/haus.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./uuid": {
      "types": "./dist/uuid.d.ts",
      "default": "./dist/uuid.js"
    },
    "./internal": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.6",
    "@types/node": "24.10.1",
    "effect": "4.0.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
