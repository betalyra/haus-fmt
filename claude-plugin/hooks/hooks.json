{
  "description": "Check .haus and .schema.haus files with `haus check` after every edit, and hand errors back to Claude.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/check-on-edit.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
