// The error codes of haus (spec §17), in haus. This file is the single source:
// spec/errors.md, docs/errors.md, the TypeScript table
// (typescript/packages/haus/src/error-codes.ts) and the JVM enum
// (jvm/haus/src/main/java/org/hausfmt/ErrorCode.java) are generated from it with
//
//   node spec/scripts/errors.ts          (--check: fail if they are out of date)
//
// Each entry: `code`, its `category`, what it `means`, where it is reported
// `at` (spec §8: the place is part of the specification; for schema files and
// imports it is informative for now, and marked so in the outputs), an `example` that
// has the error, and the `fix`, which is also the hint bindings report with it.
// Examples are checked by the TypeScript tests: `Data` must fail to parse,
// `Schema` must be rejected (or warned about), `Decode` must fail to decode
// with the type Root, `SchemaJson` and `HausJson` must fail to read, and `Check`
// must be reported by a checker, each with this code. `Text` is shown only.
//
// Codes are stable: once released, a code is never renamed, removed or
// reused for another mistake. New codes may be added.

// ── Syntax (§1–§5, grammar.ebnf) ───────────────────────────────────────────

Code {
  code: "invalid-utf8",
  category: Syntax,
  means: "The input is not valid UTF-8 (§4): a byte sequence that encodes no character, an overlong form or a surrogate. Also an unpaired surrogate in a string of the language (UTF-16) given to a parser instead of bytes.",
  at: "Informative (§8): an implementation SHOULD give the first byte of the maximal ill-formed subsequence (Unicode §3.9), and MAY give no place. Text is checked before it is parsed (§4), a stream's chunk by chunk as it arrives; a `Stream` checked item by item, in the item it is in (§14). An unpaired surrogate in a string of the language: at it, one column.",
  example: Text("the bytes 22 FF 22: a quote, a byte that never starts a character, a quote"),
  fix: "Save the file as UTF-8.",
},
Code {
  code: "version-directive",
  category: Syntax,
  means: "The file starts with a `#haus` version directive (§10): it was written for a later, incompatible version of haus.",
  at: "The `#` (line 1, column 2 after a byte order mark).",
  example: Data("#haus 2\n{ a: 1 }"),
  fix: "Read the file with a version of haus that supports it.",
},
Code {
  code: "expected-value",
  category: Syntax,
  means: "A value is missing: after a key's colon, between commas, or at the start of a file, something else comes where a value must be, also a closing bracket (`[}`, `]`, `1,]`). After a key's colon the end of the input is this error too; anywhere else inside a bracket it is `unclosed-bracket`.",
  at: "What stands where the value should be: the token, or the end of the input.",
  example: Data("{ a: }"),
  fix: "Write a value here, or remove the extra comma or bracket.",
},
Code {
  code: "missing-comma",
  category: Syntax,
  means: "Two values, fields or top-level values follow each other without a comma between them.",
  at: "The token found where the comma should be.",
  example: Data("[1 2]"),
  fix: "Add a comma between the two values.",
},
Code {
  code: "payload-newline",
  category: Syntax,
  means: "A tag is followed by `(` or `{` on a later line, or after a comment. A payload must start on the tag's line (§5), so the two are read as separate values, and a comma is missing between them.",
  at: "The payload's `(` or `{`.",
  example: Data("""
    Heartbeat
    { at: 1 }
    """),
  fix: "Put the payload on the tag's line, or add a comma if they are two values.",
},
Code {
  code: "unexpected-closer",
  category: Syntax,
  means: "A closing bracket after a value that doesn't match the open one (`[1}`), or that has no open one (`{ a: 1 }}`). Where a value or key is expected, a closing bracket is `expected-value` or `expected-key`.",
  at: "The closing bracket.",
  example: Data("[1}"),
  fix: "Close each bracket with its own kind (`{` `}`, `[` `]`, `(` `)`) and remove extra closing brackets.",
},
Code {
  code: "unclosed-bracket",
  category: Syntax,
  means: "A `{`, `[` or `(` is never closed: the input ends first (`[1,`, `Some(`), except right after a key's colon, where it is `expected-value`.",
  at: "The opening bracket.",
  example: Data("[1, 2"),
  fix: "Add the closing bracket.",
},
Code {
  code: "null-literal",
  category: Syntax,
  means: "`null` is not a value: haus has no null (§1).",
  at: "The word.",
  example: Data("{ x: null }"),
  fix: "Write `None` (with a `Maybe` type), or leave the field out.",
},
Code {
  code: "boolean-literal",
  category: Syntax,
  means: "`true` and `false` are not values: booleans are the tags `True` and `False` (§1).",
  at: "The word.",
  example: Data("{ ok: true }"),
  fix: "Write `True` or `False`.",
},
Code {
  code: "bare-identifier",
  category: Syntax,
  means: "A lowercase word where a value should be. Lowercase identifiers are only record keys.",
  at: "The word.",
  example: Data("[foo]"),
  fix: "Quote it as a string, or start it with a capital letter to make it a tag.",
},
Code {
  code: "expected-key",
  category: Syntax,
  means: "Something that can't be a record key where a key should be, such as a number or a comma. The end of the input where a key should be (`{`, `{ a: 1,`) is `unclosed-bracket`.",
  at: "What stands where the key should be: the token.",
  example: Data("{ 1: 1 }"),
  fix: "Write a key: a lowercase identifier or a string.",
},
Code {
  code: "uppercase-key",
  category: Syntax,
  means: "A record key starts with a capital letter. Bare keys start with a lowercase letter or `_`; capitalized words are tags.",
  at: "The key.",
  example: Data("{ Name: 1 }"),
  fix: "Quote the key, or start it with a lowercase letter.",
},
Code {
  code: "block-string-key",
  category: Syntax,
  means: "A block string (`\"\"\"`) is used as a record key.",
  at: "The opening `\"\"\"`.",
  example: Data("""
    { ""\"
      k
      ""\": 1 }
    """),
  fix: "Write the key as a basic string, `\"…\"`.",
},
Code {
  code: "missing-colon",
  category: Syntax,
  means: "A record key is not followed by `:`.",
  at: "The token found where the colon should be, or the end of the input.",
  example: Data("{ a 1 }"),
  fix: "Add `:` between the key and its value.",
},
Code {
  code: "duplicate-key",
  category: Syntax,
  means: "A record has the same key twice, after escapes are read (`a` and `\"a\"` are the same key). Also a JSON object with the same member name twice (§16), and a record built in code with a key twice, rejected when it is built or, at the latest, when it is written, canonicalised or hashed (§11).",
  at: "The second key, as soon as it is read, before its colon and value: an error in the value is never reached. In JSON, the second name, the same way (§16). Built in code: informative (§11).",
  example: Data("{ a: 1, a: 2 }"),
  fix: "Remove or rename one of the two.",
},
Code {
  code: "empty-payload",
  category: Syntax,
  means: "A tag with empty parentheses, `Tag()`. A tag without arguments is written without them.",
  at: "The `(`.",
  example: Data("Some()"),
  fix: "Remove the empty parentheses after the tag.",
},
Code {
  code: "invalid-number",
  category: Syntax,
  means: "A number literal that doesn't follow the grammar (§3): a leading zero, a `+`, a `.` without digits on both sides, a misplaced `_`, an uppercase `0X`, digits followed by letters. Also a string that should hold a number literal and doesn't (a `Decimal` in schema-based JSON, §16.3), and a number built in code whose text isn't a literal (`01`, `NaN`), rejected when it is built or, at the latest, when it is written, canonicalised or hashed (§11).",
  at: "The literal's first character, a sign or a leading `.` included. Built in code: informative (§11).",
  example: Data("007"),
  fix: "Write a decimal number (optional `-`, fraction and exponent) or a hex or binary integer, with `_` only between digits.",
},
Code {
  code: "unterminated-string",
  category: Syntax,
  means: "A string has no closing `\"` (in haus or JSON).",
  at: "The opening quote.",
  example: Data("\"abc"),
  fix: "Add the closing quote. A quote inside the string is written `\\\"`.",
},
Code {
  code: "string-line-break",
  category: Syntax,
  means: "A raw line break inside a `\"…\"` string.",
  at: "The line break.",
  example: Data("""
    "a
    b"
    """),
  fix: "Write the line break as `\\n`, or use a `\"\"\"` block string.",
},
Code {
  code: "control-character",
  category: Syntax,
  means: "A raw control character (C0, DEL, C1) in a string, block string or comment, where it could change what a terminal shows. A raw tab is allowed in block strings and comments, not in `\"…\"` strings. Also a raw control character in a JSON string: C0 in any JSON, DEL and C1 in self-describing JSON (§16).",
  at: "The character.",
  example: Text("\"a⟨U+0007⟩b\": a string with a raw BEL character"),
  fix: "Write the character as an escape, `\\u{…}`.",
},
Code {
  code: "bidi-control",
  category: Syntax,
  means: "A raw bidirectional control character (U+202A–U+202E, U+2066–U+2069) in a string or comment, or in a self-describing JSON string (§16), where it could reorder how the text is displayed (\"Trojan Source\", §9).",
  at: "The character.",
  example: Text("// access⟨U+202E⟩ denied: a comment with a raw right-to-left override"),
  fix: "Write it as an escape (`\\u{…}`) inside a string, or remove it.",
},
Code {
  code: "invalid-escape",
  category: Syntax,
  means: "A backslash followed by a character that doesn't start an escape, or by the end of the input. haus has `\\\"`, `\\\\`, `\\n`, `\\r`, `\\t` and `\\u{…}`; JSON has its own set.",
  at: "The backslash.",
  example: Data("\"\\x41\""),
  fix: "Use one of the escapes of §4, or write `\\\\` for a backslash.",
},
Code {
  code: "invalid-unicode-escape",
  category: Syntax,
  means: "A `\\u` escape that isn't `\\u{` 1 to 6 hex digits `}`, or names no Unicode scalar value (a surrogate, or above 10FFFF). In JSON: `\\u` not followed by four hex digits.",
  at: "The backslash.",
  example: Data("\"\\u0041\""),
  fix: "Write the escape with braces, `\\u{…}`, for a character from U+0000 to U+10FFFF other than a surrogate.",
},
Code {
  code: "block-string-opening",
  category: Syntax,
  means: "Text after the opening `\"\"\"` of a block string, or the end of the input right after it. The content starts on the next line.",
  at: "The first character after the opening `\"\"\"` and its spaces and tabs, or the end of the input.",
  example: Data("""
    ""\"text
    ""\"
    """),
  fix: "Start the content on the line after `\"\"\"`.",
},
Code {
  code: "block-string-closing",
  category: Syntax,
  means: "The closing `\"\"\"` of a block string has text before it on its line.",
  at: "The first quote of the closing `\"\"\"`. Found before any error in the lines (§4).",
  example: Data("""
    ""\"
      text""\"
    """),
  fix: "Put the closing `\"\"\"` on its own line; its indentation is removed from every line.",
},
Code {
  code: "block-string-indent",
  category: Syntax,
  means: "A line of a block string is indented less than the closing `\"\"\"`, whose indentation every line must start with.",
  at: "Column 1 of the line. Checked before the line's characters (§4).",
  example: Data("""
    ""\"
      a
     b
      ""\"
    """),
  fix: "Indent every line at least as far as the closing `\"\"\"`.",
},
Code {
  code: "unterminated-block-string",
  category: Syntax,
  means: "A block string has no closing `\"\"\"`.",
  at: "The opening `\"\"\"`. Found before any error in the lines (§4).",
  example: Data("""
    ""\"
      abc
    """),
  fix: "Add the closing `\"\"\"` on its own line.",
},
Code {
  code: "unterminated-bytes",
  category: Syntax,
  means: "A byte string `x\"…` has no closing `\"`, also when the input ends after a lone hex digit (`x\"a`).",
  at: "The `x` of `x\"`.",
  example: Data("x\"00"),
  fix: "Add the closing quote.",
},
Code {
  code: "bytes-not-hex",
  category: Syntax,
  means: "A byte string holds something other than hex digits, spaces and tabs, such as a letter after `f`, an escape or a line break, where a byte starts. After a byte's first digit, anything but a second one is `bytes-odd-digits`.",
  at: "The character.",
  example: Data("x\"zz\""),
  fix: "Write two hex digits per byte, on one line.",
},
Code {
  code: "bytes-odd-digits",
  category: Syntax,
  means: "A byte in a byte string has only one hex digit: an odd number of digits, or anything but a second hex digit after the first (a space, a letter after `f`, a line break: `x\"az\"`). The end of the input after it is `unterminated-bytes`.",
  at: "The lone hex digit.",
  example: Data("x\"abc\""),
  fix: "Write each byte as two hex digits.",
},
Code {
  code: "lone-carriage-return",
  category: Syntax,
  means: "A carriage return (CR) not followed by a line feed. Line breaks are LF or CRLF.",
  at: "The carriage return.",
  example: Text("1,⟨CR⟩2: a carriage return on its own"),
  fix: "Save the file with LF or CRLF line endings.",
},
Code {
  code: "unterminated-comment",
  category: Syntax,
  means: "A `/*` comment is never closed. Block comments nest, so each `/*` needs its own `*/`. A comment is read left to right: a control or bidi character or a lone carriage return in an unclosed comment is reported first, at its place (§4).",
  at: "The outermost `/*`.",
  example: Data("/* never closed"),
  fix: "Add `*/`, one for each `/*`.",
},
Code {
  code: "stray-slash",
  category: Syntax,
  means: "A `/` that doesn't start a comment. Comments are `//` and `/* */`; haus has no operators.",
  at: "The `/`.",
  example: Data("{ a: 1 / 2 }"),
  fix: "Write `//` or `/*` for a comment, or remove the `/`.",
},

// ── Limits (§7) ─────────────────────────────────────────────────────────────

Code {
  code: "nesting-too-deep",
  category: Limits,
  means: "Records, arrays and payloads are nested deeper than the depth limit (default 256). In JSON, deeper than its JSON limit (§16).",
  at: "The opening bracket of the first level too deep: the `(` of `Tag(`, the `{` of `Tag {`. Building a value in code: the constructor of the container too deep, informative (§11). Encoding with a schema: the place of the value (§15).",
  example: Text("[[[[ … ]]]]: 257 levels"),
  fix: "Flatten the data, or raise the depth limit if you trust the input.",
},
Code {
  code: "number-too-long",
  category: Limits,
  means: "A number literal has more characters than the limit (default 1000), or a hex literal more hex digits than the number limit allows (default 829), so that every integer fits the limit in decimal (§7). A number built in code is measured on its normalized literal when it is built (§11); one over both the number and the exponent limit may fail with either code.",
  at: "The literal's first character. In JSON, the number token's first character, or the string's place for a string read as a number (§16). Building a value in code: the constructor, informative (§11).",
  example: Text("a number with 1001 digits"),
  fix: "Write a shorter number (a `String` or `Bytes` for very long data), or raise the number length limit.",
},
Code {
  code: "exponent-too-large",
  category: Limits,
  means: "A number's exponent is larger than the limit (default 6144), in either direction. A number built in code is measured on its normalized literal when it is built (§11), as for `number-too-long`.",
  at: "The literal's first character. In JSON, and building a value in code, as `number-too-long`.",
  example: Data("1e6145"),
  fix: "Write a number with a smaller exponent, or raise the exponent limit.",
},
Code {
  code: "string-too-long",
  category: Limits,
  means: "A string or byte string has more characters than the limit (default 16 Mi).",
  at: "The opening quote; for a byte string, its `x` (§8). Building a value in code: the constructor, informative (§11).",
  example: Text("a string of 16,777,217 characters"),
  fix: "Split the string, or raise the string length limit.",
},
Code {
  code: "key-too-long",
  category: Limits,
  means: "A record key has more characters than the string limit (default 16 Mi).",
  at: "The key's first character. Building a value in code: the constructor, informative (§11).",
  example: Text("a bare key of 16,777,217 characters"),
  fix: "Use a shorter key, or raise the string length limit.",
},
Code {
  code: "tag-too-long",
  category: Limits,
  means: "A tag has more characters than the string limit (default 16 Mi).",
  at: "The tag's first character. Building a value in code: the constructor, informative (§11).",
  example: Text("a tag of 16,777,217 characters"),
  fix: "Use a shorter tag, or raise the string length limit.",
},
Code {
  code: "value-too-long",
  category: Limits,
  means: "One top-level value of a haus stream has more characters than the limit (default 64 Mi). A line of JSON Lines has no such limit (§16).",
  at: "The start of the value's text: the character after the previous top-level comma, whatever it is (`1,⏎ 1234567`: line 1, column 3, the line break), or the start of the stream, after a byte order mark (column 2).",
  example: Text("a stream whose second value is 64 Mi characters long"),
  fix: "Send smaller values, or raise the value length limit.",
},
Code {
  code: "unsupported-depth",
  category: Limits,
  means: "The configured depth limit is above the deepest nesting the binding supports, or isn't a whole number (§7). Raised when the limits are set, not by any input.",
  at: "No place: an error of the API that sets the limits.",
  example: Text("maxDepth: 100000"),
  fix: "Configure a depth limit within the binding's documented maximum.",
},

// ── Streams (§6) ────────────────────────────────────────────────────────────

Code {
  code: "not-one-value",
  category: Streams,
  means: "One value was expected (a single document, a type that isn't a `Stream`), and the input holds none or several.",
  at: "The end of the input; `$` when decoding with a type.",
  example: Text("parse(\"1, 2\"): two values where one is expected"),
  fix: "Give exactly one value, or read the input as a stream.",
},
Code {
  code: "stream-truncated",
  category: Streams,
  means: "In strict mode, a stream ended without a comma (or, in JSON Lines, a line feed) after its last value, so the last value may be cut off (§6).",
  at: "The end of the stream.",
  example: Text("1, 2, 3 (strict mode: the last value has no comma)"),
  fix: "End every value with a comma, or check that the stream wasn't cut off.",
},

// ── Schema files (§14) ──────────────────────────────────────────────────────

Code {
  code: "schema-syntax",
  category: SchemaFiles,
  means: "A schema file doesn't follow the grammar: an unexpected token, a character that has no place there. Mistakes in the comments, whitespace and strings a schema file shares with data files (§14) have the codes they have there: `unterminated-string`, `unterminated-comment`, `lone-carriage-return`, `control-character`, `bidi-control`, `invalid-utf8`, `invalid-escape`.",
  at: "The token found, or the end of the file.",
  example: Schema("type A = { x Int }"),
  fix: "Write it as the grammar says (grammar.ebnf); the message names what was expected.",
},
Code {
  code: "unknown-type",
  category: SchemaFiles,
  means: "A type name that is neither defined in the file, imported, nor a prelude type. A type a standard module or official extension has needs its import.",
  at: "The type's name where it is used.",
  example: Schema("type A = { at: Date }"),
  fix: "Define the type, fix its spelling, or import it from the module that defines it.",
},
Code {
  code: "wrong-arity",
  category: SchemaFiles,
  means: "A type is used with the wrong number of arguments: `Array` without its element type, `Int` with one, a generic type of your own with too few or too many.",
  at: "The type's name where it is used.",
  example: Schema("type A = { key: Secret }"),
  fix: "Give the type exactly as many arguments as it has parameters.",
},
Code {
  code: "duplicate-type",
  category: SchemaFiles,
  means: "Two definitions of the same type name, or a definition with the name of an imported type.",
  at: "The second definition, at its `type`.",
  example: Schema("""
    type A = Int
    type A = String
    """),
  fix: "Rename one of them.",
},
Code {
  code: "redefine-prelude",
  category: SchemaFiles,
  means: "A definition with the name of a prelude type (`Int`, `Any`, `Secret`, `Maybe`, …), which schemas can't redefine.",
  at: "The definition, at its `type`.",
  example: Schema("type Any = String"),
  fix: "Give your type another name.",
},
Code {
  code: "unknown-parameter",
  category: SchemaFiles,
  means: "A lowercase name in a type that is not a parameter of the definition.",
  at: "The name where it is used.",
  example: Schema("type Box = { item: a }"),
  fix: "Declare the parameter after the type's name, or use a type name.",
},
Code {
  code: "invalid-parameter",
  category: SchemaFiles,
  means: "A type parameter starting with `_`, or the same parameter twice in one definition.",
  at: "The parameter: the second one, for a parameter given twice.",
  example: Schema("type Pair _ = { a: Int }"),
  fix: "Give each parameter its own lowercase name.",
},
Code {
  code: "underscore-type",
  category: SchemaFiles,
  means: "`_` used as a type. Types are open by default, so there is no wildcard.",
  at: "The `_`.",
  example: Schema("type A = { x: _ }"),
  fix: "Write `< >` for a variant with any tags, `Any` for any value, or use a type parameter.",
},
Code {
  code: "duplicate-field",
  category: SchemaFiles,
  means: "A record type lists the same field twice, also one copied in by a spread.",
  at: "The second field's key.",
  example: Schema("type A = { x: Int, x: String }"),
  fix: "Remove or rename one of them.",
},
Code {
  code: "duplicate-tag",
  category: SchemaFiles,
  means: "A variant type lists the same tag twice, also one copied in by a spread.",
  at: "The second tag.",
  example: Schema("type A = < B | B >"),
  fix: "Remove or rename one of them.",
},
Code {
  code: "closed-empty-variant",
  category: SchemaFiles,
  means: "`closed < >`: a closed variant without tags accepts nothing. Checked as written: `closed < ...E >` is accepted even when `E` has no tags.",
  at: "The `<`.",
  example: Schema("type A = closed < >"),
  fix: "List its tags, or write `< >` for a variant with any tags.",
},
Code {
  code: "invalid-spread",
  category: SchemaFiles,
  means: "A spread of something that can't be spread: not a named type, a type with parameters, a `Stream`, a type of the prelude (`...Bool`), or a record spread into a variant (or a variant into a record). An alias or a generic instance is spread as what it stands for.",
  at: "The name after `...`.",
  example: Schema("""
    type R = { x: Int }
    type V = < ...R >
    """),
  fix: "Spread a named variant into a variant, or a named record into a record, without parameters.",
},
Code {
  code: "spread-cycle",
  category: SchemaFiles,
  means: "A type spreads itself, directly or through other types.",
  at: "A definition in the cycle, at its `type`.",
  example: Schema("""
    type A = < ...B >
    type B = < ...A >
    """),
  fix: "Break the cycle: let one of the types list its tags or fields itself.",
},
Code {
  code: "row-parameter",
  category: SchemaFiles,
  means: "A spread of a parameter, `...r`. Row parameters are not part of the language.",
  at: "The name after `...`.",
  example: Schema("type A r = { ...r, x: Int }"),
  fix: "Spread a named type instead, or nest the open part as a field with a type parameter.",
},
Code {
  code: "misplaced-stream",
  category: SchemaFiles,
  means: "`Stream` used anywhere but as the whole type of a definition, or a reference to such a definition. A stream is a whole file.",
  at: "The name `Stream`, or the reference to the stream's definition.",
  example: Schema("type A = { events: Stream Int }"),
  fix: "Use `Array` inside types, and `Stream` only as the whole of a definition.",
},
Code {
  code: "unguarded-recursion",
  category: SchemaFiles,
  means: "A type refers to itself without a record field, array element or variant payload in between (§9.9), so decoding it would consume no input. `Secret` and names don't count as a step.",
  at: "A definition in the cycle, at its `type`.",
  example: Schema("""
    type A = B
    type B = A
    """),
  fix: "Put the recursion inside a record field, array element or variant payload.",
},
Code {
  code: "growing-recursion",
  category: SchemaFiles,
  means: "Generic types whose instances could grow without bound: a type parameter passes, wrapped in a bigger type, along a cycle of references back to itself (`type T a = < X (T (Pair a a)) >`, §9.10).",
  at: "The reference on the cycle that passes the parameter in a bigger type.",
  example: Schema("type Nest a = < Leaf a | Deeper (Nest (Array a)) >"),
  fix: "Refer to the type inside itself with exactly its own parameters.",
},
Code {
  code: "type-too-deep",
  category: SchemaFiles,
  means: "Type expressions are nested deeper than the schema parser's limit.",
  at: "The bracket that opens the first level too deep.",
  example: Text("Array (Array (Array … )) nested 300 levels"),
  fix: "Name the inner types with definitions of their own.",
},
Code {
  code: "attribute-arguments",
  category: SchemaFiles,
  means: "An attribute this version defines, given arguments it doesn't take: `@deprecated` takes nothing or one string. Also empty parentheses after an attribute.",
  at: "The attribute's `@`.",
  example: Schema("@deprecated(1)\ntype A = Int"),
  fix: "Give the attribute only the arguments it takes: `@deprecated` takes none, or one string.",
},
Code {
  code: "attribute-twice",
  category: SchemaFiles,
  means: "The same attribute twice on one type, field or tag, for an attribute this version defines. One it doesn't define may appear twice, with a warning each (`unknown-attribute`).",
  at: "The second attribute's `@`.",
  example: Schema("@deprecated @deprecated\ntype A = Int"),
  fix: "Keep one of them.",
},
Code {
  code: "attribute-space",
  category: SchemaFiles,
  means: "A space between an attribute's name and its `(`.",
  at: "The space after the attribute's name.",
  example: Schema("type A = { @deprecated (\"x\") x: Int }"),
  fix: "Write the parenthesis right after the attribute's name, without a space.",
},
Code {
  code: "attribute-on-spread",
  category: SchemaFiles,
  means: "An attribute on a spread. The fields and tags a spread copies keep their own attributes.",
  at: "The attribute's `@`.",
  example: Schema("""
    type B = { x: Int }
    type A = { @deprecated ...B }
    """),
  fix: "Put the attribute on the fields or tags in the spread type.",
},

// ── Imports (§13.3) ─────────────────────────────────────────────────────────

Code {
  code: "unknown-module",
  category: Imports,
  means: "An import of a module that doesn't exist: an unknown standard module, a former standard module, a package name that breaks npm's rules (`@Haus/money`), or a module that starts with `.` but not with `./` or `../` (`.../a`, `..`, `.x`). Any other word where a module belongs (`foo/bar`, `Lib/a-b`), and `.` alone, is `schema-syntax` (grammar.ebnf).",
  at: "The import, at its `import`.",
  example: Schema("import std/money (Money)\ntype A = Money"),
  fix: "Fix the module's name; a former standard module is now a package, which the message names.",
},
Code {
  code: "unknown-import",
  category: Imports,
  means: "An import names a type the module doesn't have, or no type at all.",
  at: "The type's name in the import.",
  example: Schema("import std/time (Data)\ntype A = Int"),
  fix: "Import a type the module defines; the message lists them.",
},
Code {
  code: "duplicate-import",
  category: Imports,
  means: "The same type name is imported twice.",
  at: "The second name in the imports.",
  example: Schema("import std/time (Date, Date)\ntype A = Date"),
  fix: "Import each name once.",
},
Code {
  code: "import-unavailable",
  category: Imports,
  means: "The schema imports a package or file, and the tool reading it has no way to find one (no module resolver): only standard modules can be imported there.",
  at: "The import, at its `import`.",
  example: Schema("import ./common (Address)\ntype A = Address"),
  fix: "Read the schema with a resolver that loads imports (from files or packages), or inline the types.",
},
Code {
  code: "import-not-found",
  category: Imports,
  means: "An imported package or file can't be found: no package of that name was given to the build, the path is wrong, the file is not a regular file (a directory, a FIFO, a device) or is spelled otherwise than its directory lists it, a directory on its way can't be listed, a name on a relative import's path is a symbolic link (which a relative import never follows), whether the file is in a package's directory can't be checked (a directory between it and the build's root can't be listed), or the package given names another package in its manifest (§13.3).",
  at: "The import, at its `import`.",
  example: Text("import @acme/geo (LatLng), with no package @acme/geo given to the build"),
  fix: "Give the package to the build (packages.md), or fix the path.",
},
Code {
  code: "import-outside-root",
  category: Imports,
  means: "A relative import reaches a file outside the build's root directory (§13.3): by default the directory of the schema file the build starts from, or the directory given as the build's `root` option. Its `..` names go above the root: it is rejected before anything is looked at (a relative import follows no symbolic link, so it can't leave the root otherwise). Also a `root` option that doesn't contain the schema file the build starts from.",
  at: "The import, at its `import`. A `root` option that doesn't contain the entry file: no place.",
  example: Text("app/a.schema.haus has import ../../shared/money (Money), and the build starts from app/a.schema.haus"),
  fix: "Give the build a `root` option that contains both files (such as the repository's schema directory), or move the shared file inside the root; publish types used across projects as a schema package.",
},
Code {
  code: "import-version",
  category: Imports,
  means: "An import asks for a major version (`@org/name@2`) and the package given to the build has another one, or names something other than a major version: `@1.1`, `@1.1.0`, `@01`, `@x`, `@1~x`, `@1@2` (a package module is one token up to a blank or `(`, grammar.ebnf).",
  at: "The import, at its `import`.",
  example: Schema("import @haus-fmt/money@1.1 (Money)\ntype A = Money"),
  fix: "Give the build the major version the schema asks for, or update the import. An import names only the major version (`@1`); the minimum minor goes in your package manager's dependency range.",
},
Code {
  code: "import-cycle",
  category: Imports,
  means: "Schema files import each other in a cycle.",
  at: "The import that closes the cycle, at its `import`.",
  example: Text("a.schema.haus imports ./b, and b.schema.haus imports ./a"),
  fix: "Move the shared types to a file both import.",
},
Code {
  code: "duplicate-package",
  category: Imports,
  means: "One schema reaches two different packages with the same name: two versions of one package (also two major versions), two copies of one version whose files differ, or two packages that call themselves the same. Byte-identical copies are one package. Also a copy of an official package (`@haus-fmt/…`) given to a compile, as a value, by its directory or in a folder, that isn't byte for byte the one built into the binding, whether a schema imports it or not: an official package can't be replaced (packages.md §3).",
  at: "The import that reaches the second package, at its `import`. A copy of an official package: no place; the message names where it was given.",
  example: Text("@acme/ids 1.4.0 given as the bundle of @acme/orders and 1.2.0 in the folder of packages schemas/"),
  fix: "Give one copy of the package: align the versions of the libraries that carry it. Don't give copies of the official packages: they are built in. On npm, a library declares the libraries of the schema packages its schema imports as `peerDependencies`.",
},
Code {
  code: "undeclared-package",
  category: Imports,
  means: "No longer reported. A build is never searched for packages: every package a schema imports is one given to the build (packages.md), so no import can reach a package its project didn't declare, and an import of a package that wasn't given is `import-not-found`. The code is kept, unused, until the catalogue's 1.0, so that it isn't reused for another mistake.",
  at: "Never reported.",
  example: Text("(none: no input has this error)"),
  fix: "Give the package to the build.",
},
Code {
  code: "package-manifest",
  category: Imports,
  means: "A package's `package.haus` is not a valid manifest: not one record, a `name` that isn't a lowercase `@org/name` (or has the part `node_modules`), a `version` that isn't a semantic version, or more than 64 KiB. Also a `rules` field that breaks its rules (packages.md §4), checked on each package a schema reaches: not a record of strings, a type the package's `schema.haus` doesn't define without parameters (or defines as a `Stream`), a rule name that isn't `[a-z][a-z0-9-]*`, or, for a package read from files, a rule without its regular file `rules/<name>.md`.",
  at: "The import that reaches the package; the message names the manifest. A package given by its directory, and a `rules` field: no place.",
  example: Text("a package.haus with { name: \"@Acme/Orders\", version: \"1\" }"),
  fix: "Write `{ name: \"@org/name\", version: \"1.2.0\" }`, in lowercase, with a full version. Give a rule only to a type the schema defines without parameters, as `rules: { \"Code\": \"iso\" }`, with its prose in `rules/iso.md`.",
},
Code {
  code: "missing-codec",
  category: Imports,
  means: "The schema reaches a type that its package gives a rule (its manifest's `rules`, packages.md §4, §6), and the program has no implementation of that rule: neither built in (the official packages' rules), nor carried by the package's bundle, nor supplied by the program. Compiling fails, unless the program takes the package shape-only (packages.md §7). Only types the schema's definitions reach count, directly or through other types; a rule on a type nothing decodes is not required. Tools that check data without a program (`haus check`, editors) report it instead as a hint, once per import of such a package.",
  at: "Nowhere: it is about the program's rules, reported once per type id. From a tool: the import of the package, as a hint.",
  example: Text("a schema that imports @acme/ids, whose manifest has rules: { \"Id\": \"ulid\" }, compiled from a directory with no implementation of ulid: `@acme/ids@1#Id has the rule ulid, and this program has no implementation of it`"),
  fix: "Use the library that publishes the package (its bundle carries the rule), supply the rule (`Package.withRule`), or take the package shape-only (`Package.shapeOnly`) if your program checks its values itself.",
},
Code {
  code: "package-version",
  category: Imports,
  means: "A package's `package.haus` has another version than the package manager gives the package (the `version` of its `package.json`, its Cargo version). A check implementations SHOULD make (packages.md §4), also for a package given explicitly by its directory that has a `package.json` next to its manifest. A subdirectory of a folder of packages with such a version is skipped instead, like one with a broken manifest, and named when an import isn't found; a `package.json` beside a package given by its directory that can't be read is ignored, by every implementation.",
  at: "The import that reaches the package; the message names both versions.",
  example: Text("package.haus says 1.2.0, the package.json next to it 1.3.0"),
  fix: "Release both with the same version: change them together.",
},
Code {
  code: "package-path",
  category: Imports,
  means: "A schema package refers to a file it may not: its `schema.haus` imports a file (`import ./x`) instead of a package; its `package.haus` or `schema.haus` is a symbolic link or not a regular file; or a file outside any package imports a file in a package's directory (`import ./node_modules/x/y`). The file is not read.",
  at: "The import that reaches the file; the message names the file.",
  example: Text("a package whose schema.haus has import ../../.env (T)"),
  fix: "A package is its `package.haus` and one `schema.haus`, and imports other packages by name (`import @org/name`); import a package by name from your own files too.",
},
Code {
  code: "package-name",
  category: Imports,
  means: "A package manager's name for a schema package differs from its manifest's: the `name` of the `package.json` it is published with isn't the `name` of its `package.haus`. Imports name a package by its manifest's name, so a package published under another name would be given to builds under a name its imports don't use (§13.3). Reported by package checks such as `haus package check`.",
  at: "No place in text: the message names the package and its files.",
  example: Text("package.haus names @acme/orders, the package.json next to it @acme/order"),
  fix: "Publish the package under its manifest's name: make the `name` of `package.json` the same.",
},
Code {
  code: "package-crate",
  category: Imports,
  means: "A schema package's crate can't be named by the code generated for crates that use its types: its `links` is missing or isn't its library's name (`[lib] name`), or a crate depends on a schema package's crate under another name (`package = …`). Generated code names a schema package's crate by its `links`, which is its library's name. Reported by package checks such as `haus package check`.",
  at: "No place in text: the message names the crate.",
  example: Text("a Cargo.toml with links = \"money\" and [lib] name = \"haus_money\""),
  fix: "Set `links` to the library's name in `[package]`, and depend on schema package crates under their own names.",
},
Code {
  code: "package-install-script",
  category: Imports,
  means: "A schema package runs code when it is installed: an npm `preinstall`, `install` or `postinstall` script, or a `binding.gyp`, for which npm runs node-gyp. A schema package is data and MUST NOT need code to install (§13.3).",
  at: "No place in text: the message names the package and the script.",
  example: Text("a package.json with \"scripts\": { \"postinstall\": \"node setup.js\" }"),
  fix: "Remove the script: a schema package is its manifest, its schema and its rules, and needs nothing run.",
},
Code {
  code: "package-files",
  category: Imports,
  means: "A package manager's configuration doesn't ship a file of the schema package: `package.haus`, `schema.haus`, or a rule's prose or vectors. Read from the configuration (`files` of `package.json`, `include` of `Cargo.toml`, a wheel's build configuration), without packing anything.",
  at: "No place in text: the message names the package and the file.",
  example: Text("a package.json with \"files\": [\"schema.haus\"], without package.haus"),
  fix: "List `package.haus`, `schema.haus` and `rules` in what the package manager ships.",
},
Code {
  code: "profile-vectors",
  category: Imports,
  means: "A rule's test vectors of a schema package are malformed (packages.md §6): the rule has no prose (`rules/<name>.md`) next to its vectors; a vector isn't `Accept { type, value, output?, note? }` or `Reject { type, value, note? }` with string fields and no others (only an `Accept` has an `output`); its `type` isn't a type of the package without parameters; its `value` or `output` isn't one haus value; or an accepted value or its output isn't valid for its type, which a rule checked after the schema can't accept. Also a rule name that isn't `[a-z][a-z0-9-]*`, and a vectors file with no vectors.",
  at: "The vector's place in its file, or the rule when its prose is missing.",
  example: Text("Reject { type: \"Money\", value: \"Money(1, US)\", output: \"Money(1, US)\" }"),
  fix: "Write the rule in `rules/<name>.md`, and each vector as `Accept { type: \"T\", value: \"…\" }` or `Reject { type: \"T\", value: \"…\" }`, with values valid for `T`.",
},
Code {
  code: "package-wrapper",
  category: Imports,
  means: "A package manager's file of a schema package can't be read as one: a `package.json` that isn't a JSON object or has no `name`, a `Cargo.toml` or `pyproject.toml` that isn't valid TOML, a `Cargo.toml` without `[package]`. Reported by package checks such as `haus package check`.",
  at: "No place in text: the message names the file.",
  example: Text("a Cargo.toml with [package without its closing bracket"),
  fix: "Fix the file so that its package manager can read it.",
},
Code {
  code: "codec-unreachable",
  category: Imports,
  means: "A codec's type occurs where this binding can't apply the codec, such as the payload of a record case whose fields sit beside its tag in the host value. Decoding there with the default host type would silently differ from the other bindings (§13.4).",
  at: "The place of the codec's type in the schema, or in the value (§15).",
  example: Text("a codec for app#Rec, the payload of the record case Box (TypeScript Effect)"),
  fix: "Give the codec's type a place of its own (a field), or decode the outer type yourself; the message names where the type occurs.",
},
Code {
  code: "file-too-large",
  category: Imports,
  means: "A schema file is larger than the tool allows (1 MiB by default). It is not read.",
  at: "The import that reaches the file.",
  example: Text("an imported common.schema.haus of 3 MiB"),
  fix: "Split the schema into several files, or raise the limit if you trust the file.",
},
Code {
  code: "too-many-files",
  category: Imports,
  means: "A schema imports more schema files, directly or not, than the tool allows (256 by default, the root included), or a folder of packages has more entries than allowed (4096).",
  at: "The import that reaches one file too many, or the folder.",
  example: Text("a schema whose imports reach 300 files"),
  fix: "Import fewer files.",
},

// ── Decoding and encoding with a schema (§15) ───────────────────────────────

Code {
  code: "type-mismatch",
  category: Decoding,
  means: "A value of another kind than the type accepts: a string for an `Int`, an array for a record, a tag that isn't `True` or `False` for a `Bool`. Decoders never convert between kinds (§15).",
  at: "The value (§15): `$.items[2]`. For a std/time type, any value that isn't its tag around one string, at the value (`Date(1)` at `$`).",
  example: Decode { schema: "type Root = { qty: Int }", data: "{ qty: \"2\" }" },
  fix: "Write a value of the expected type; the message says which.",
},
Code {
  code: "not-an-integer",
  category: Decoding,
  means: "A number with a fraction or an exponent where an integer type is expected. `1.0` and `1e3` are not whole numbers by spelling (§15).",
  at: "The number.",
  example: Decode { schema: "type Root = { qty: Int }", data: "{ qty: 1.0 }" },
  fix: "Write the integer without a fraction or exponent.",
},
Code {
  code: "out-of-range",
  category: Decoding,
  means: "A number outside the type's range: an `Int8` above 127, a negative `UInt32`, a float too large for `Float32`. Never wrapped or clamped.",
  at: "The number.",
  example: Decode { schema: "type Root = { age: UInt8 }", data: "{ age: 300 }" },
  fix: "Write a value within the range, or use a larger type (`Int`, `Float64`, `Decimal`).",
},
Code {
  code: "missing-field",
  category: Decoding,
  means: "A record lacks a field the type requires. Only fields with `?` may be missing; `None` is not missing.",
  at: "The record, not the field.",
  example: Decode { schema: "type Root = { id: Int, name: String }", data: "{ id: 1 }" },
  fix: "Add the field, or mark it optional in the schema with `?` after its name.",
},
Code {
  code: "unknown-field",
  category: Decoding,
  means: "A field a closed record doesn't list. Open records ignore such fields (see `unlisted-field`).",
  at: "The field: `$.extra`.",
  example: Decode { schema: "type Root = closed { id: Int }", data: "{ id: 1, extra: 2 }" },
  fix: "Remove the field, fix its spelling, or add it to the schema.",
},
Code {
  code: "unknown-tag",
  category: Decoding,
  means: "A tag a closed variant doesn't list. Open variants read it as an unknown value (see `unlisted-tag`).",
  at: "The variant.",
  example: Decode { schema: "type Root = closed < Red | Green >", data: "Blue" },
  fix: "Use one of the variant's tags, fix the spelling, or add the tag to the schema.",
},
Code {
  code: "wrong-payload",
  category: Decoding,
  means: "A listed tag with another payload than its case says: arguments for a tag without payload, the wrong number of arguments, a positional payload where a record is expected, such as `Circle(1.5)` for the case `Circle { r: Float64 }` (§15).",
  at: "The variant.",
  example: Decode { schema: "type Root = closed < None | Some Int >", data: "Some(1, 2)" },
  fix: "Write the payload the schema gives the tag: none, one record, or its positional arguments; the message says which.",
},
Code {
  code: "invalid-time",
  category: Decoding,
  means: "A std/time value whose text the std/time rule rejects: a day that doesn't exist, a missing offset, a lowercase `t` (spec/std/time.md).",
  at: "The string: `$[0]` for `Date(\"2026-02-30\")`.",
  example: Decode { schema: "import std/time (Date)\ntype Root = { on: Date }", data: "{ on: Date(\"2026-02-30\") }" },
  fix: "Write the date or time as the std/time rule says (spec/std/time.md); the message names the type.",
},
Code {
  code: "invalid-secret",
  category: Decoding,
  means: "A value of a `Secret` type that its type doesn't accept, when decoding, or that can't be written, when encoding. The error names the place and the type only, never the value or why it failed (§15).",
  at: "The secret itself, never a place inside it.",
  example: Decode { schema: "type Root = { key: Secret String }", data: "{ key: 42 }" },
  fix: "Write a value of the secret's type; the value isn't shown, so check it where it comes from.",
},
Code {
  code: "codec-rejected",
  category: Decoding,
  means: "A value its type's schema accepts and a codec or a package's rule rejects (§13.4, packages.md §6), such as an amount whose currency the rule `iso` of `@haus-fmt/money` doesn't accept. At the place of the codec's or the rule's type.",
  at: "The place of the codec's or the rule's type: of the innermost that rejects (§13.4). Inside a `Secret` the error is `invalid-secret`, at the secret.",
  example: Text("Money(1, US) decoded with @haus-fmt/money's rule iso: US is no ISO 4217 currency"),
  fix: "Write a value the codec accepts; the package's rule (rules/<name>.md) or the codec's documentation says which.",
},
Code {
  code: "cannot-encode",
  category: Decoding,
  means: "Encoding: a value of the program's language that the type can't write, such as a JavaScript number for an `Int` that expects a bigint, or a string that is no valid `Date`, or a host value a codec rejects (§13.4). A decoded `Secret`, which an encoder writes only when told to reveal secrets (`revealSecrets`, §15, \"Encoding a secret\"). Building a value in code (§11): a string or key with an unpaired surrogate, which has no UTF-8 form, or, in a binding whose strings are bytes, one that isn't valid UTF-8; or something that is no haus value (an object of another type where a value or a number is expected). Rejected when the value is built.",
  at: "The place of the value in the type being encoded; for a codec's rejection, the place of the codec's type; for a secret, the secret, never a place inside it. Building a value in code: the constructor, informative (§11).",
  example: Text("encode(Config, config) with a `Secret String` field `key` and no revealSecrets: at $.key"),
  fix: "Pass a value of the host type the binding documents for the type. For a secret, encode with `revealSecrets` if the program means to write it.",
},
Code {
  code: "cyclic-value",
  category: Decoding,
  means: "Encoding: a value contains itself, so it has no finite text.",
  at: "The place of the value that contains itself, or `$`.",
  example: Text("const a = { children: [] }; a.children.push(a); encode(Tree, a)"),
  fix: "Break the cycle before encoding.",
},
Code {
  code: "value-changed",
  category: Decoding,
  means: "A value was changed after it was built, or made without the binding's constructors (a cast), in a language that can't keep code from changing it (§11, \"Values don't change\"): a writer, the canonical form, the hash, equality or order found a container that contains itself, or whose size differs from the one recorded when it was built (§7). A value used as it was built never has this error.",
  at: "`$`: the value given to the writer, the canonical form or the hash; `$[i]` for the i-th value of a stream written, or of `hashAll`, also when there is one value (`$[0]`). From `equals` or `compare`: `$`, and the message says which operand.",
  example: Text("const v = Value.array([]); v.items.push(v); stringify(v)"),
  fix: "Don't change a value after it is built: build a new one from its parts.",
},
Code {
  code: "step-budget",
  category: Decoding,
  means: "Decoding or encoding took more steps than the input justifies, a sign of a schema doing unbounded work. Bindings MUST bound the work of one decode (§9.8).",
  at: "`$`: the whole decode or encode.",
  example: Text("a hand-written schema that decodes each value many times"),
  fix: "Simplify the schema, or raise the step limit if the work is expected.",
},
Code {
  code: "too-many-nodes",
  category: Decoding,
  means: "A value built in code (not parsed) has a size over the node limit (default 64 Mi, §7): its parts share each other so much that it would expand beyond the limit when written out. Raised when the value is built: by the constructor of the container that goes over the limit (§11), or by an encoder with a schema given objects of the program that share parts (§15). Never by parsing, decoding, the writers, the canonical form, the hash, equality or order.",
  at: "Building a value in code: the constructor, informative (§11). Encoding with a schema: `$`, the value given; `$[i]` for the i-th item of a stream encoded (§15).",
  example: Text("x0 = []; x(n+1) = [xn, xn]: x26 has size 2^27 − 1, the first over the default limit"),
  fix: "Build a value whose parts share each other less, or raise the limit where the binding lets you.",
},

// ── JSON (§16) ──────────────────────────────────────────────────────────────

Code {
  code: "json-syntax",
  category: Json,
  means: "Text that isn't JSON (RFC 8259): a missing comma or colon, an unquoted name, a trailing comma, a comment, text after the value. Also an empty line in JSON Lines, or a byte order mark at the start of a line after the first. A string that isn't closed, and a bad escape, have the codes of haus text: `unterminated-string`, `invalid-escape`, `invalid-unicode-escape`.",
  at: "`$`, with the line and column of the token found or of the end of the text. In JSON Lines, the line: `$[3]`.",
  example: HausJson("{\"_haus\": 1,}"),
  fix: "Write valid JSON; the message says what was expected.",
},
Code {
  code: "unpaired-surrogate",
  category: Json,
  means: "A JSON string with half of a UTF-16 surrogate pair, raw or as `\\uD800`. I-JSON forbids them, and they are no Unicode characters (§16).",
  at: "`$`, with the line and column of the escape's backslash, or of the raw character.",
  example: HausJson("{\"_haus\": 1, \"_value\": \"\\uD800\"}"),
  fix: "Write both halves of the surrogate pair, or the character itself.",
},
Code {
  code: "haus-json-form",
  category: Json,
  means: "JSON that isn't self-describing JSON (§16.2): a text without the envelope `{\"_haus\": 1, \"_value\": …}`, an envelope with other members, a bare number, `true`, `null`, an object with other members, a `_rec` that isn't an object, an `_args` that isn't a non-empty array.",
  at: "The object that isn't a form (§16.3, \"Places\"): `$` for a text without the envelope.",
  example: HausJson("{\"_haus\": 1, \"_value\": 1}"),
  fix: "Write the envelope with one of the forms of §16.2 in `_value`: a string, an array, or an object with `_num`, `_bytes`, `_rec`, or `_tag` (and `_args`). For ordinary JSON, read it with a schema or import it instead.",
},
Code {
  code: "haus-json-version",
  category: Json,
  means: "A self-describing JSON envelope whose `_haus` isn't 1, the only version of the form (§16.2): it was written for a later version of haus, or isn't haus.",
  at: "The member: `$._haus`.",
  example: HausJson("{\"_haus\": 2, \"_value\": \"a\"}"),
  fix: "Read it with a newer version of haus, or write `\"_haus\": 1`.",
},
Code {
  code: "haus-json-number",
  category: Json,
  means: "A self-describing `_num` that isn't a normalized number literal (§2): `\"1E5\"`, `\"01\"`, `\"0xff\"`, or not a string.",
  at: "The member: `$._value._num`.",
  example: HausJson("{\"_haus\": 1, \"_value\": {\"_num\": \"1E5\"}}"),
  fix: "Write the number's normalized literal (§2) as a string.",
},
Code {
  code: "haus-json-bytes",
  category: Json,
  means: "A self-describing `_bytes` that isn't two lowercase hex digits per byte.",
  at: "The member: `$._value._bytes`.",
  example: HausJson("{\"_haus\": 1, \"_value\": {\"_bytes\": \"FF\"}}"),
  fix: "Write the bytes as lowercase hex, two digits per byte.",
},
Code {
  code: "invalid-tag",
  category: Json,
  means: "A tag name that isn't `[A-Z][A-Za-z0-9_]*`, or a `\"_tag\"` that isn't a string: in a `_tag` of either JSON form, in the string of a closed variant whose tags have no payload in schema-based JSON (`\"debug\"`, §16.3), or in a value built in code (rejected when it is built or, at the latest, when it is written, canonicalised or hashed, §11). The tag rule is checked first: a tag with an unpaired surrogate, or one that isn't UTF-8 in a binding whose strings are bytes, is this error, not `cannot-encode`.",
  at: "The object that holds the `\"_tag\"`, or the string of a closed enum (§16.3, \"Places\"). Built in code: informative (§11).",
  example: HausJson("{\"_haus\": 1, \"_value\": {\"_tag\": \"lower\"}}"),
  fix: "Start the tag with a capital letter and use only letters, digits and `_`.",
},
Code {
  code: "invalid-base64",
  category: Json,
  means: "Schema-based JSON `Bytes` that aren't canonical base64 with padding (RFC 4648 §4): whitespace, the URL alphabet, missing padding, non-zero pad bits.",
  at: "The string.",
  example: SchemaJson { schema: "type Root = Bytes", json: "\"CzQ\"" },
  fix: "Write standard base64, with padding.",
},
Code {
  code: "missing-member",
  category: Json,
  means: "Schema-based JSON: an object lacks a member its form needs, such as `\"_tag\"` for a variant or `\"value\"` for a tag with one argument.",
  at: "The object.",
  example: SchemaJson { schema: "type Root = < Ok Int | Err String >", json: "{\"_tag\": \"Ok\"}" },
  fix: "Add the member the message names.",
},
Code {
  code: "unexpected-member",
  category: Json,
  means: "Schema-based JSON: an object has a member its form doesn't have, such as `\"value\"` next to a tag without payload (§16.3).",
  at: "The member: `$.x`.",
  example: SchemaJson { schema: "type Root = < Ok Int | Empty >", json: "{\"_tag\": \"Empty\", \"value\": 1}" },
  fix: "Remove the member.",
},
Code {
  code: "no-json-form",
  category: Json,
  means: "A value or type that has no JSON form: a string with an unpaired surrogate, a record payload with a field named `_tag` or `_args` in schema-based JSON (§16.3), a type with no schema-based form.",
  at: "The value's place when writing or reading; in a schema file, a warning at the case's tag (§14).",
  example: Text("toJson of Odd { _tag: 1 }, for the case `Odd { _tag: Int32 }`"),
  fix: "Rename the field, or use self-describing JSON.",
},

// ── Hints and warnings: reported without failing ────────────────────────────

Code {
  code: "unknown-attribute",
  category: Hints,
  means: "A warning: an attribute this version of haus doesn't define. It is accepted and has no meaning (§14).",
  at: "The attribute's `@`.",
  example: Schema("@since(\"1.2\")\ntype A = Int"),
  fix: "Check the spelling; attributes of a later version are fine.",
},
Code {
  code: "deprecated",
  category: Hints,
  means: "A hint: the schema or the data uses a type, field or tag marked `@deprecated` (§14).",
  at: "In a schema, the type's name where it is used (after `...` for a spread); in data, the field's value or the tagged value: `$.lines[0].count`.",
  example: Check { schema: "type Root = { @deprecated(\"use email\") mail?: String, email?: String }", data: "{ mail: \"a@b.c\" }" },
  fix: "Use what the deprecation note says instead.",
},
Code {
  code: "unlisted-field",
  category: Hints,
  means: "A hint: a field an open record doesn't list. A reader ignores it, but it may be a typo.",
  at: "The field: `$.nmae`. Never inside a `Secret` (§14).",
  example: Check { schema: "type Root = { name: String }", data: "{ name: \"a\", nmae: \"b\" }" },
  fix: "Fix the spelling, add the field to the schema, or leave it if it is meant for newer readers.",
},
Code {
  code: "unlisted-tag",
  category: Hints,
  means: "A hint: a tag an open variant doesn't list. A reader keeps it as an unknown value, but it may be a typo.",
  at: "The variant. Never inside a `Secret` (§14).",
  example: Check { schema: "type Root = < Red | Green >", data: "Gren" },
  fix: "Fix the spelling, add the tag to the schema, or leave it if it is meant for newer readers.",
},
Code {
  code: "unused-codec",
  category: Hints,
  means: "A warning: a codec is set for an id that no type has (packages.md §7): not a type of the prelude or a standard module, nor of the schema's files and the packages they import. It never runs, so the values it was meant to check pass unchecked. Decoding is unchanged. A codec for the id of a type that can't have one (a generic type, `prelude#Maybe`, a `Stream` definition) is not this warning: the binding rejects it as a mistake of its configuration, with no code, as two codecs for one id (packages.md §7).",
  at: "Nowhere: it is about the codecs the application set, reported once per id, where the binding learns which codecs are set or on request, through a function of the binding's.",
  example: Text("a codec set for `@haus-fmt/money@2#Money`, with a schema that imports `@haus-fmt/money@1`"),
  fix: "Fix the codec's id: the package's name and major version, and the type's name, as the schema imports them.",
},
