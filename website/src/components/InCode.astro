---
import SectionHeading from "./SectionHeading.astro";
import Code from "./Code.astro";
import CodeTabs from "./CodeTabs";
import Wash from "./Wash.astro";
import {
  codeC,
  codeGo,
  codeJava,
  codeKotlin,
  codePython,
  codeRoc,
  codeRust,
  codeSwift,
  codeTs,
  codeTsPlain,
  codeZig,
  schemaHaus,
  threadHaus,
} from "@/content/samples";
import { links } from "@/lib/links";
import type { Tab } from "./CodeTabs";
import type { Pigment } from "@/lib/pigments";

const fileTabs: Tab[] = [
  { value: "data", label: "Data", caption: "A comment thread, where each reply is a comment too." },
  { value: "schema", label: "Schema", caption: "Its schema. Comment refers to itself, so threads can nest." },
];

/** The link after a tab's caption: that language's guide. */
const guide = (label: string, page: string) => ({ label: `${label} guide`, href: `${links.languages}/${page}` });

const languageTabs: Tab[] = [
  { value: "ts", icon: "typescript", label: "TypeScript", caption: "haus schemas are Standard Schemas, so Zod, Valibot and ArkType work too.", more: guide("TypeScript", "typescript"), install: { kind: "shell", text: "npm install @haus-fmt/haus" } },
  { value: "effect", icon: "effect", label: "Effect", caption: "Int becomes bigint, Instant stays its exact text. DateTime is an opt-in.", more: guide("Effect", "effect"), install: { kind: "shell", text: "npm install @haus-fmt/effect effect" } },
  { value: "rust", icon: "rust", label: "Rust", caption: "haus-fmt-build generates the types at compile time.", more: guide("Rust", "rust"), install: { kind: "shell", text: "cargo add haus-fmt && cargo add --build haus-fmt-build" } },
  { value: "python", icon: "python", label: "Python", caption: "Values you can match on. With a schema file, haus.schema decodes into dicts and tagged values.", more: guide("Python", "python"), install: { kind: "shell", text: "pip install haus-fmt" } },
  { value: "go", icon: "go", label: "Go", caption: "Package schema loads the schema and checks values with it at run time.", more: guide("Go", "go"), install: { kind: "shell", text: "go get github.com/betalyra/haus-fmt/go" } },
  { value: "swift", icon: "swift", label: "Swift", caption: "Decode straight into your Codable structs.", more: guide("Swift", "swift"), install: { kind: "file", text: ".package(url: \"https://github.com/betalyra/haus-fmt\", from: \"0.1.0\")" } },
  { value: "java", icon: "java", label: "Java", caption: "Decode into records and sealed interfaces; java.time is an opt-in.", more: guide("Java", "jvm"), install: { kind: "file", text: "implementation(\"org.haus-fmt:haus:0.1.0\")" } },
  { value: "kotlin", icon: "kotlin", label: "Kotlin", caption: "Decode into data classes, with the same library as Java.", more: guide("Kotlin", "jvm"), install: { kind: "file", text: "implementation(\"org.haus-fmt:haus-kotlin:0.1.0\")" } },
  { value: "roc", icon: "roc", label: "Roc", caption: "haus-gen generates the types and their decoders from the schema.", more: guide("Roc", "roc"), install: { kind: "note", text: "The package is in roc/package in the repository, for the Roc nightly." } },
  { value: "zig", icon: "zig", label: "Zig", caption: "A Decoded keeps every value exactly; codecs give you Zig types.", more: guide("Zig", "zig"), install: { kind: "shell", text: "zig fetch --save=haus https://github.com/betalyra/haus-fmt/releases/download/zig-v0.1.0/haus-zig-0.1.0.tar.gz" } },
  { value: "c", icon: "c", label: "C", caption: "libhaus and haus.h, built from the Zig library, for C and anything that calls C.", more: guide("C", "zig#from-c"), install: { kind: "note", text: "To download: libhaus, static or shared, for macOS, Linux and Windows, on the Zig release." } },
];

const notes: { term: string; rest: string; color: Pigment }[] = [
  { term: "Typed data.", rest: "Import a data file like a module, already typed by its schema.", color: "ultramarine" },
  { term: "Clear errors.", rest: "When data doesn't match, the error tells you where.", color: "rose" },
  { term: "Your own types.", rest: "Codecs map schema types onto yours, for example a Date onto your date library.", color: "gold" },
];
---

<section id="languages" class="relative mx-auto w-full max-w-6xl scroll-mt-8 px-6 py-20 lg:py-32" aria-labelledby="in-your-code">
  <div class="max-w-[42rem]">
    <SectionHeading id="in-your-code">At home in your code.</SectionHeading>
    <p class="mt-5 text-[1.12rem] text-ink-2">
      Any haus file parses on its own, just like JSON. When you want types, put a
      <code class="inline-code">.schema.haus</code> file next to your data: your build reads it and gives you
      <strong>real types</strong>.
    </p>
  </div>

  <div class="relative isolate mt-14 grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-12 lg:gap-8">
    <Wash
      seed={61}
      class="-top-2 -left-14 -z-10 hidden h-[calc(100%+6rem)] w-[calc(100%+7rem)] lg:block"
      strokes={[
        { x: 0.06, y: 0.4, rx: 0.08, ry: 0.17, color: "violet", strength: 0.85 },
        { x: 0.09, y: 0.27, rx: 0.07, ry: 0.08, color: "ultramarine", strength: 0.7 },
        { x: 0.965, y: 0.58, rx: 0.05, ry: 0.13, color: "rose", strength: 0.85 },
        { x: 0.955, y: 0.72, rx: 0.04, ry: 0.06, color: "gold", strength: 0.9 },
      ]}
    />
    <div class="relative min-w-0 lg:col-span-5">
      <CodeTabs client:idle tabs={fileTabs}>
        <Fragment slot="data"><Code code={threadHaus} lang="haus" label="thread.haus" size="sm" schema={{ text: schemaHaus }} /></Fragment>
        <Fragment slot="schema"><Code code={schemaHaus} lang="haus" label="thread.schema.haus" size="sm" fixed /></Fragment>
      </CodeTabs>
    </div>
    <div class="relative min-w-0 lg:col-span-7">
      <CodeTabs client:idle tabs={languageTabs}>
        <Fragment slot="ts"><Code code={codeTsPlain} lang="ts" label="main.ts" size="sm" fixed /></Fragment>
        <Fragment slot="effect"><Code code={codeTs} lang="ts" label="main.ts" size="sm" fixed /></Fragment>
        <Fragment slot="rust"><Code code={codeRust} lang="rust" label="main.rs" size="sm" fixed /></Fragment>
        <Fragment slot="python"><Code code={codePython} lang="python" label="main.py" size="sm" fixed /></Fragment>
        <Fragment slot="go"><Code code={codeGo} lang="go" label="main.go" size="sm" fixed /></Fragment>
        <Fragment slot="swift"><Code code={codeSwift} lang="swift" label="main.swift" size="sm" fixed /></Fragment>
        <Fragment slot="java"><Code code={codeJava} lang="java" label="Main.java" size="sm" fixed /></Fragment>
        <Fragment slot="kotlin"><Code code={codeKotlin} lang="kotlin" label="Main.kt" size="sm" fixed /></Fragment>
        <Fragment slot="roc"><Code code={codeRoc} lang="python" label="main.roc" size="sm" fixed /></Fragment>
        <Fragment slot="zig"><Code code={codeZig} lang="zig" label="main.zig" size="sm" fixed /></Fragment>
        <Fragment slot="c"><Code code={codeC} lang="c" label="main.c" size="sm" fixed /></Fragment>
      </CodeTabs>
      <p class="mt-5 text-[0.92rem]">
        <a href={links.languages} class="prose-link text-ink">All languages, side by side</a>
      </p>
    </div>
  </div>

  <ul class="mt-16 grid grid-cols-1 gap-x-10 gap-y-6 md:grid-cols-3">
    {notes.map((n, i) => (
      <li class="relative isolate pl-11">
        <Wash seed={70 + i} color={n.color} strength={1.4} class="top-[-0.2rem] left-[-0.4rem] -z-10 h-9 w-9" delay={i * 140} />
        <span class="font-medium text-ink">{n.term}</span> <span class="text-ink-2">{n.rest}</span>
      </li>
    ))}
  </ul>
</section>
