---
/**
 * The languages haus has a library for, each a card that links to its docs
 * page: the mark, the name, what you get, and how you install it. Cards are
 * white paper like the code cards; the wash only frames the grid.
 */
import { PiArrowRightLight, PiBirdLight } from "react-icons/pi";
import { SiEffect, SiGo, SiOpenjdk, SiPython, SiRust, SiSwift, SiTypescript, SiZig } from "react-icons/si";
import Wash from "./Wash.astro";
import { links } from "@/lib/links";

const languages = [
  { name: "TypeScript", icon: SiTypescript, page: "typescript", gives: "Plain values, or typed by a schema. Standard Schema too.", install: "npm install @haus-fmt/haus" },
  { name: "Effect", icon: SiEffect, page: "effect", gives: "Effect schemas, Effects and Streams.", install: "npm install @haus-fmt/effect" },
  { name: "Rust", icon: SiRust, page: "rust", gives: "Structs and enums, generated in build.rs.", install: "cargo add haus-fmt" },
  { name: "Python", icon: SiPython, page: "python", gives: "Values to match on; dicts and tagged values from a schema.", install: "pip install haus-fmt" },
  { name: "Go", icon: SiGo, page: "go", gives: "Schemas at run time, codecs onto your own types.", install: "go get github.com/betalyra/haus-fmt/go" },
  { name: "Swift", icon: SiSwift, page: "swift", gives: "Your Codable structs and enums.", install: "SwiftPM: github.com/betalyra/haus-fmt" },
  { name: "Java and Kotlin", icon: SiOpenjdk, page: "jvm", gives: "Records, sealed interfaces and data classes.", install: "./gradlew build, in jvm/" },
  { name: "Roc", icon: PiBirdLight, page: "roc", gives: "Tag unions and records generated by haus-gen.", install: "haus: \"roc/package/main.roc\"" },
  { name: "Zig and C", icon: SiZig, page: "zig", gives: "A Decoded tree in Zig; libhaus and haus.h for C.", install: "zig fetch --save=haus …" },
];
---

<div class="relative isolate mt-20">
  <p class="max-w-[40rem] text-[1.05rem] text-ink-2">
    Every library passes the same conformance suite. Each page shows what you install, what your code looks like, and what you
    get back. <a href={links.languages} class="prose-link">Compare them</a>.
  </p>

  <div class="relative mt-8">
    <Wash
      seed={83}
      class="-top-6 -left-14 -z-10 hidden h-[calc(100%+3rem)] w-[calc(100%+7rem)] lg:block"
      strokes={[
        { x: 0.04, y: 0.7, rx: 0.06, ry: 0.16, color: "sap", strength: 0.85 },
        { x: 0.06, y: 0.84, rx: 0.05, ry: 0.07, color: "cerulean", strength: 0.75 },
        { x: 0.965, y: 0.22, rx: 0.045, ry: 0.13, color: "gold", strength: 0.85 },
        { x: 0.955, y: 0.1, rx: 0.035, ry: 0.06, color: "sienna", strength: 0.8 },
      ]}
    />
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        languages.map((l) => {
          const Icon = l.icon;
          return (
            <li class="min-w-0">
              <a
                href={`${links.languages}/${l.page}`}
                class="group flex h-full flex-col rounded-[14px] border border-line bg-paper px-5 pt-4 pb-4 transition-colors duration-200 hover:border-ink-3"
              >
                <span class="flex items-center gap-2.5">
                  <Icon size={20} aria-hidden="true" className="shrink-0 text-ink" />
                  <span class="font-heading text-[1.12rem] font-semibold tracking-[-0.02em] text-ink">
                    <span class="brush-hover">{l.name}</span>
                  </span>
                  <PiArrowRightLight
                    size={16}
                    aria-hidden="true"
                    className="ml-auto text-ink-3 transition-transform duration-200 ease-out group-hover:translate-x-0.5"
                  />
                </span>
                <span class="mt-1.5 text-[0.95rem] text-ink-2">{l.gives}</span>
                <code class="mt-3 block truncate pt-0.5 font-mono text-[0.8rem] text-ink-3">{l.install}</code>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>
