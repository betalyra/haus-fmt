// Test vectors for the profile @haus-fmt/geo/wgs84, version 1. The rule is
// in wgs84.md; these are examples of it (spec §13.3).
//
// Accept: `value` (haus text for `type`) is accepted, and encoding what the
// codec decoded writes exactly the text `output`, or `value` when there is no
// `output`. Reject: `value` is valid for the schema of `type` (the shape), and
// the codec rejects it (the rule).

// ── LatLng ──
Accept { type: "LatLng", value: "LatLng(38.7223, -9.1393)" },
Accept { type: "LatLng", value: "LatLng(90, 180)" },
Accept { type: "LatLng", value: "LatLng(-90, -180)" },
Accept { type: "LatLng", value: "LatLng(-0, 0)", note: "negative zero is kept" },
Accept { type: "LatLng", value: "LatLng(90.00000000000000001, 0)", output: "LatLng(90, 0)", note: "checked on the decoded float" },
Reject { type: "LatLng", value: "LatLng(91, 0)", note: "latitude out of range" },
Reject { type: "LatLng", value: "LatLng(-90.0000001, 0)", note: "latitude out of range" },
Reject { type: "LatLng", value: "LatLng(0, 180.5)", note: "longitude out of range" },
Reject { type: "LatLng", value: "LatLng(NaN, 0)" },
Reject { type: "LatLng", value: "LatLng(0, NaN)" },
Reject { type: "LatLng", value: "LatLng(Infinity, 0)" },
Reject { type: "LatLng", value: "LatLng(0, NegInfinity)" },

// ── BBox ──
Accept { type: "BBox", value: "BBox(LatLng(38.69, -9.23), LatLng(38.80, -9.09))", output: "BBox(LatLng(38.69, -9.23), LatLng(38.8, -9.09))", note: "a Float64 is written in its one spelling" },
Accept { type: "BBox", value: "BBox(LatLng(0, 170), LatLng(10, -170))", note: "crosses the antimeridian" },
Accept { type: "BBox", value: "BBox(LatLng(5, 5), LatLng(5, 5))", note: "a single point" },
Reject { type: "BBox", value: "BBox(LatLng(10, 0), LatLng(0, 1))", note: "south of the south-west corner is north of the north-east one" },
Reject { type: "BBox", value: "BBox(LatLng(0, 0), LatLng(91, 1))", note: "a corner out of range" },
