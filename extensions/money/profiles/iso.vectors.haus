// Test vectors for the profile @haus-fmt/money/iso, version 1. The rule is
// in iso.md; these are examples of it (spec §13.3).
//
// Accept: `value` (haus text for `type`) is accepted, and encoding what the
// codec decoded writes exactly the text `output`, or `value` when there is no
// `output`, in the compact layout (spec §11). Reject: `value` is valid for the
// schema of `type` (the shape), and the codec rejects it (the rule).
//
// `looser: ["T", …]` on a Reject: run it again with, for each type `T` named,
// a codec of the application's that accepts every value of `T`'s schema
// (looser than the profile). The codec for `type` still rejects `value`: a
// profile's rule is checked on the values the schema decoded, never on what an
// inner codec made of them (spec §13.4).

Accept { type: "Money", value: "Money(19.99, EUR)" },
Accept { type: "Money", value: "Money(19.90, USD)", note: "the scale is kept: encodes back to 19.90" },
Accept { type: "Money", value: "Money(0.00005, BTC)", note: "the shape of a code, not membership in ISO 4217" },
Accept { type: "Money", value: "Money(-3, JPY)" },
Reject { type: "Money", value: "Money(19.99, Eur)", note: "not all capitals" },
Reject { type: "Money", value: "Money(19.99, EURO)", note: "four letters" },
Reject { type: "Money", value: "Money(19.99, E1R)", note: "a digit" },
Accept { type: "Currency", value: "CHF" },
Reject { type: "Currency", value: "CHF(1)", note: "a payload" },
Reject { type: "Money", value: "Money(1, US)", note: "two letters" },
Reject { type: "Money", value: "Money(19.90, Bitcoin)", looser: ["Currency"], note: "a looser codec for Currency doesn't make the currency pass Money's rule" },
